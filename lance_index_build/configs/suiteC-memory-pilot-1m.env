# Plan §6 gate: 1M BIGANN prefix, K=5, before the 10M Suite C. Run with INDEX=ivf_hnsw_flat and ivf_pipnn_flat.
DATASET=bigann
DATA_DIR=${ANNS_DATA}/bigann10m
DS_PATH=${DATASETS_DIR}/bigann1m.lance
N_LIMIT=1000000
INDEX=ivf_pipnn_flat
NUM_PARTITIONS=5
MODE=complete
ASSIGN=exact
HNSW_M=16
HNSW_EFC=100
PIPNN_DEGREE=32
PIPNN_LOCAL_K=2
PIPNN_LEAF=1024
PIPNN_RESERVOIR=160
NPROBES=1,2,5
EFS=32,64,128,256
KS=10,100
QUERY_SET=tune
