# Scale target: MS MARCO v2.1 (Cohere Embed English v3), 113,520,750 x 1024, IVF_RQ
# on the reference node, scored against the published top-1000 ground truth.
# Limits: the customer table's single-node 200M row (64 cores, 6 GB memory, index
# < 120 GB, build < 2 h, top-24 < 80 ms, recall > 90%), the closest row to 113.5M.
DATASET=msmarco
DATA_DIR=${ANNS_DATA}/msmarco-v2.1
DS_PATH=${DATASETS_DIR}/msmarco-v2.1.lance
INDEX=ivf_rq
# 4-bit codes: 512 B + factors and ids per vector, ~61 GB (budget 120 GB = 1 KB/vector).
NUM_BITS=4
# ~6.9k rows per partition.
NUM_PARTITIONS=16384
# k-means sample = SAMPLE_RATE x K rows: 32 x 16384 x 4 KiB = 2.1 GB (default 256 = 17 GB).
SAMPLE_RATE=32
MODE=complete
ASSIGN=tree:4
REPEATS=1
NPROBES=8,16,32,64,128,256
KS=24
# All 1677 TREC-DL queries; the published ground truth is used (no N_LIMIT).
QUERY_SET=all
# Hardware profile enforced by scripts/run.sh.
HW_CPUS=64
HW_MEM_GB=6
# Pass/fail limits recorded in builds.jsonl (targets.*).
TARGET_BUILD_SECS=7200
TARGET_INDEX_GB=120
TARGET_MEM_GB=6
TARGET_K=24
TARGET_RECALL=0.90
TARGET_LATENCY_MS=80
TARGET_LATENCY_STAT=p99
