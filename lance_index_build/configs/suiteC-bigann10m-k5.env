# Suite C primary: BIGANN10M, K=5. Run once with INDEX=ivf_hnsw_flat and once with ivf_pipnn_flat.
# Sequential partition builds first; check peak RSS before concurrent partitions.
DATASET=bigann
DATA_DIR=${ANNS_DATA}/bigann10m
DS_PATH=${DATASETS_DIR}/bigann10m.lance
INDEX=ivf_pipnn_flat
NUM_PARTITIONS=5
MODE=complete
ASSIGN=exact
HNSW_M=16
HNSW_EFC=100
PIPNN_DEGREE=32
PIPNN_LOCAL_K=2
PIPNN_LEAF=1024
PIPNN_RESERVOIR=160
NPROBES=1,2,3,4,5
EFS=32,64,128,256,512
KS=10,100
QUERY_SET=tune
