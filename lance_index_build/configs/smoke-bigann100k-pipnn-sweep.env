# Smoke: fixed-model assignment comparison on a 100k BIGANN prefix (exact GT recomputed).
DATASET=bigann
DATA_DIR=/home/caokyhieu/anns/data/bigann10m
DS_PATH=/home/caokyhieu/anns/lance_index_build/datasets/bigann100k.lance
N_LIMIT=100000
INDEX=ivf_rq
NUM_BITS=5
NUM_PARTITIONS=1024
MODE=fixed
ASSIGN=exact,pipnn:32,pipnn:32:64:128,pipnn:64:64:128,hnsw,hnsw:12:15:32,tree:1,tree:8,tree:16
ASSIGN_SAMPLE=20000
NPROBES=16,64
KS=10,100
QUERY_SET=tune
SKIP_QUERY=1
