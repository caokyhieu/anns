# ARM kernels, legacy Lance vs new kernels, GIST1M (1M x 960 f32), IVF_RQ5 K=1000.
# Read by both levels of kernels_all.sh: the standalone stage bench (scripts/stages.sh,
# STAGE_* keys) and the end-to-end Lance build + search (scripts/run.sh).
DATASET=gist
DATA_DIR=${ANNS_DATA}
DS_PATH=${DATASETS_DIR}/gist1m.lance
INDEX=ivf_rq
NUM_BITS=5
NUM_PARTITIONS=1000
SAMPLE_RATE=256
MODE=complete
# Lance's own centroid assignment; the arms change kernels only.
ASSIGN=auto
REPEATS=3
NPROBES=1,4,16,64,256
KS=10,100
QUERY_SET=all
# Stage bench: assignment backends scored per stage (exact always runs); tree:4 shows
# the kernels under KT1 option A (k > 256 already trains hierarchically, so keeping
# the tree does not change the training work).
STAGE_ASSIGN=auto,exact,tree:4
STAGE_REPEATS=3
