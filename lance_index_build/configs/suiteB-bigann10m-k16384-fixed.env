# Suite B primary: BIGANN10M, K=16384, fixed-model centroid-assignment comparison.
DATASET=bigann
DATA_DIR=/home/caokyhieu/anns/data/bigann10m
DS_PATH=/home/caokyhieu/anns/lance_index_build/datasets/bigann10m.lance
INDEX=ivf_rq
NUM_BITS=5
NUM_PARTITIONS=16384
MODE=fixed
ASSIGN=exact,hnsw,hnsw:12:15:32,hnsw:12:15:64,tree:1,tree:4,tree:16,pipnn:15:64:256,pipnn:32:64:256,pipnn:64:64:256,pipnn:128:64:256,pipnn:32:64:1024
ASSIGN_SAMPLE=100000
REPEATS=3
NPROBES=1,4,16,64,256
KS=10,100
QUERY_SET=tune
