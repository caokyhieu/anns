# Pipeline smoke for the MS MARCO scale runs (minutes): 2M-row prefix with the same
# index recipe at small K and the same hardware profile. The published ground truth
# covers the full corpus, so exact ground truth is recomputed for this prefix.
DATASET=msmarco
DATA_DIR=${ANNS_DATA}/msmarco-v2.1
DS_PATH=${DATASETS_DIR}/msmarco-v2.1-2m.lance
N_LIMIT=2000000
INDEX=ivf_rq
NUM_BITS=4
NUM_PARTITIONS=1024
SAMPLE_RATE=32
MODE=complete
ASSIGN=tree:4
REPEATS=1
NPROBES=8,32,128
KS=24
QUERY_SET=all
GT_QUERIES=200
GT_K=100
HW_CPUS=64
HW_MEM_GB=6
