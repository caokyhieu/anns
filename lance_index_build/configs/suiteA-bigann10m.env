# Suite A: BIGANN10M IVF_RQ5, tree assignment vs current/exact. Run with NUM_PARTITIONS=4096 and 16384.
DATASET=bigann
DATA_DIR=${ANNS_DATA}/bigann10m
DS_PATH=${DATASETS_DIR}/bigann10m.lance
INDEX=ivf_rq
NUM_BITS=5
NUM_PARTITIONS=4096
MODE=complete
ASSIGN=auto,exact,tree:1,tree:4,tree:16
REPEATS=3
NPROBES=1,4,16,64,256
KS=10,100
QUERY_SET=tune
