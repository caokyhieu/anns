# ARM kernels, legacy Lance vs new kernels, BIGANN10M (10M x 128, u8 stored as f32),
# IVF_RQ5 K=4096. Same use as kernels-gist.env; NUM_PARTITIONS=16384 is the large-K case.
DATASET=bigann
DATA_DIR=${ANNS_DATA}/bigann10m
DS_PATH=${DATASETS_DIR}/bigann10m.lance
INDEX=ivf_rq
NUM_BITS=5
NUM_PARTITIONS=4096
SAMPLE_RATE=256
MODE=complete
ASSIGN=auto
REPEATS=3
NPROBES=1,4,16,64,256
KS=10,100
QUERY_SET=tune
STAGE_ASSIGN=auto,exact,tree:4
STAGE_REPEATS=3
