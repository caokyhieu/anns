# Suite A primary: GIST1M, K=16384, IVF_RQ5 tree assignment vs current/exact.
DATASET=gist
DATA_DIR=${ANNS_DATA}
DS_PATH=${DATASETS_DIR}/gist1m.lance
INDEX=ivf_rq
NUM_BITS=5
NUM_PARTITIONS=16384
# Lance caps K at rows/sample_rate (1M/256 = 3906); lower the rate so K=16384 is kept.
SAMPLE_RATE=32
MODE=complete
ASSIGN=auto,exact,tree:1,tree:2,tree:4,tree:8,tree:16
REPEATS=3
NPROBES=1,4,16,64,256,512,1024
KS=10,100
QUERY_SET=tune
