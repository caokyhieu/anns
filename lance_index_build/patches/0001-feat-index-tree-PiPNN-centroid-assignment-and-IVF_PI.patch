+struct Output {
+    builds: Mutex<File>,
+    queries: Mutex<BufWriter<File>>,
+    assignments: Mutex<File>,
+}
+
+impl Output {
+    fn new(dir: &Path) -> Self {
+        std::fs::create_dir_all(dir).unwrap();
+        let append = |name: &str| {
+            OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(dir.join(name))
+                .unwrap()
+        };
+        let queries_path = dir.join("queries.csv");
+        let new_csv = !queries_path.exists();
+        let mut queries = BufWriter::new(append("queries.csv"));
+        if new_csv {
+            writeln!(
+                queries,
+                "build_id,assign,k,nprobes,ef,query_id,split,latency_us,returned,hits"
+            )
+            .unwrap();
+        }
+        Self {
+            builds: Mutex::new(append("builds.jsonl")),
+            queries: Mutex::new(queries),
+            assignments: Mutex::new(append("assignments.jsonl")),
+        }
+    }
+    fn line(file: &Mutex<File>, value: &Value) {
+        writeln!(file.lock().unwrap(), "{value}").unwrap();
+    }
+}
