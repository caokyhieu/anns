+/// Sampled assignment quality versus exact nearest centroid, outside all build timings.
+async fn assignment_quality(
+    data: &Data,
+    centroids: &FixedSizeListArray,
+    tree: Option<Arc<lance_index::vector::assignment_tree::AssignmentTree>>,
+    specs: &[String],
+    sample: usize,
+    seed: u64,
+    out: &Output,
+) {
+    let sample = sample.min(data.base.rows);
+    let mut ids: Vec<usize> = (0..data.base.rows).collect();
+    // Deterministic partial Fisher-Yates.
+    for i in 0..sample {
+        let j = i + (splitmix(seed ^ i as u64) as usize) % (ids.len() - i);
+        ids.swap(i, j);
+    }
+    ids.truncate(sample);
+    let values: Vec<f32> = ids.iter().flat_map(|&i| data.base.row(i)).copied().collect();
+    let vectors =
+        FixedSizeListArray::try_new_from_values(Float32Array::from(values), data.base.dim as i32)
+            .unwrap();
+    let run = |assignment: CentroidAssignment| {
+        let centroids = centroids.clone();
+        let tree = tree.clone();
+        let vectors = vectors.clone();
+        tokio::task::spawn_blocking(move || {
+            let t = Instant::now();
+            let prepared =
+                PreparedAssignment::prepare(centroids, MetricType::L2, &assignment, tree)?;
+            let prepare = t.elapsed().as_secs_f64();
+            #[cfg(feature = "pipnn")]
+            let graph = prepared.pipnn_stats().map(|g| {
+                json!({"vertices": g.vertices, "mean_degree": g.mean_degree,
+                       "max_degree": g.max_degree, "reachable_fraction": g.reachable_fraction})
+            });
+            #[cfg(not(feature = "pipnn"))]
+            let graph: Option<Value> = None;
+            let t = Instant::now();
+            let (ids, dists) = prepared.assign(vectors)?;
+            Ok::<_, lance_core::Error>((prepare, t.elapsed().as_secs_f64(), ids, dists, graph))
+        })
+    };
+    let (_, exact_secs, exact_ids, exact_d, _) =
+        run(CentroidAssignment::Exact).await.unwrap().unwrap();
+    for spec in specs {
+        let (prepare, assign, got_ids, got_d, graph) = match run(parse_assignment(spec)).await.unwrap() {
+            Ok(r) => r,
+            Err(e) => {
+                Output::line(
+                    &out.assignments,
+                    &json!({"assign": spec, "status": "error", "error": e.to_string()}),
+                );
+                continue;
+            }
+        };
+        let mut id_agree = 0usize;
+        let mut dist_agree = 0usize;
+        let mut unassigned = 0usize;
+        let mut excess = Vec::with_capacity(sample);
+        let mut rel_excess = Vec::with_capacity(sample);
+        const EPS: f64 = 1e-6;
+        for i in 0..sample {
+            if got_ids.is_null(i) || exact_ids.is_null(i) {
+                unassigned += 1;
+                continue;
+            }
+            let (e, g) = (exact_d.value(i) as f64, got_d.value(i) as f64);
+            id_agree += usize::from(got_ids.value(i) == exact_ids.value(i));
+            let ex = (g - e).max(0.0);
+            dist_agree += usize::from(ex <= EPS * e.max(1.0));
+            excess.push(ex);
+            rel_excess.push(ex / e.max(EPS));
+        }
+        excess.sort_by(f64::total_cmp);
+        rel_excess.sort_by(f64::total_cmp);
+        let mean = |v: &[f64]| v.iter().sum::<f64>() / v.len().max(1) as f64;
+        let row = json!({
+            "assign": spec,
+            "status": "ok",
+            "sample": sample,
+            "num_partitions": centroids.len(),
+            "prepare_secs": prepare,
+            "assign_secs": assign,
+            "vectors_per_sec": sample as f64 / assign,
+            "exact_assign_secs": exact_secs,
+            "id_agreement": id_agree as f64 / sample as f64,
+            "distance_agreement": dist_agree as f64 / sample as f64,
+            "distance_agreement_epsilon": EPS,
+            "unassigned": unassigned,
+            "excess_mean": mean(&excess),
+            "excess_p95": percentile(&excess, 0.95),
+            "excess_p99": percentile(&excess, 0.99),
+            "rel_excess_mean": mean(&rel_excess),
+            "rel_excess_p95": percentile(&rel_excess, 0.95),
+            "rel_excess_p99": percentile(&rel_excess, 0.99),
+            "centroid_graph": graph,
+        });
+        println!(
+            "  assign-quality {spec:<18} id={:.4} dist={:.4} prep={prepare:.3}s assign={assign:.3}s (exact {exact_secs:.3}s) {}",
+            row["id_agreement"].as_f64().unwrap(),
+            row["distance_agreement"].as_f64().unwrap(),
+            row["centroid_graph"]
+        );
+        Output::line(&out.assignments, &row);
+    }
+}
+
+struct QueryPlan {
+    ids: Vec<usize>,
+    arrays: Vec<Float32Array>,
+    split: &'static str,
+}
+
+fn query_plan(data: &Data) -> QueryPlan {
+    let set = std::env::var("QUERY_SET").unwrap_or_else(|_| "tune".into());
+    let ids: Vec<usize> = (0..data.queries.rows)
+        .filter(|&q| match set.as_str() {
+            "tune" => is_tuning_query(q),
+            "final" => !is_tuning_query(q),
+            "all" => true,
+            other => panic!("unknown QUERY_SET {other}"),
+        })
+        .collect();
+    // Query buffers are prepared before any timing.
+    let arrays = ids
+        .iter()
+        .map(|&q| Float32Array::from(data.queries.row(q).to_vec()))
+        .collect();
+    QueryPlan {
+        ids,
+        arrays,
+        split: if set == "tune" {
+            "tune"
+        } else if set == "final" {
+            "final"
+        } else {
+            "all"
+        },
+    }
+}
+
+async fn run_query(
+    dataset: &Dataset,
+    q: &Float32Array,
+    k: usize,
+    nprobes: usize,
+    ef: Option<usize>,
+) -> Vec<RecordBatch> {
+    let mut scan = dataset.scan();
+    scan.project(&["id"]).unwrap();
+    scan.nearest("vector", q, k).unwrap();
+    scan.minimum_nprobes(nprobes).maximum_nprobes(nprobes);
+    if let Some(ef) = ef {
+        scan.ef(ef);
+    }
+    scan.try_into_stream().await.unwrap().try_collect().await.unwrap()
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn evaluate(
+    dataset: &Dataset,
+    data: &Data,
+    plan: &QueryPlan,
+    build_id: &str,
+    assign: &str,
+    graph: bool,
+    out: &Output,
+) -> Vec<Value> {
+    let ks: Vec<usize> = env_list("KS", "10,100");
+    let num_partitions: usize = env_or("NUM_PARTITIONS", 1000);
+    let nprobes: Vec<usize> = env_list("NPROBES", "1,4,16,64,256")
+        .into_iter()
+        .filter(|&n| n <= num_partitions)
+        .collect();
+    let efs: Vec<Option<usize>> = if graph {
+        env_list("EFS", "32,64,128,256,512").into_iter().map(Some).collect()
+    } else {
+        vec![None]
+    };
+    let warmup: usize = env_or("WARMUP", 1);
+    let mut summary = Vec::new();
+    for &k in &ks {
+        let truth_k = k.min(data.truth.k);
+        for &np in &nprobes {
+            for &ef in &efs {
+                if ef.is_some_and(|ef| ef < k) {
+                    continue;
+                }
+                for _ in 0..warmup {
+                    for q in &plan.arrays {
+                        run_query(dataset, q, k, np, ef).await;
+                    }
+                }
+                let mut latencies = Vec::with_capacity(plan.ids.len());
+                let mut hits_total = 0usize;
+                let mut rows = String::new();
+                for (q, &qid) in plan.arrays.iter().zip(&plan.ids) {
+                    let t = Instant::now();
+                    let batches = run_query(dataset, q, k, np, ef).await;
+                    let us = t.elapsed().as_secs_f64() * 1e6;
+                    // Recall bookkeeping happens after the timer stops.
+                    let returned: Vec<i32> = batches
+                        .iter()
+                        .flat_map(|b| {
+                            b.column_by_name("id")
+                                .unwrap()
+                                .as_primitive::<Int32Type>()
+                                .values()
+                                .to_vec()
+                        })
+                        .collect();
+                    let truth: HashSet<u32> = data.truth.ids
+                        [qid * data.truth.k..qid * data.truth.k + truth_k]
+                        .iter()
+                        .copied()
+                        .collect();
+                    let unique: HashSet<i32> = returned.iter().take(k).copied().collect();
+                    let hits = unique
+                        .iter()
+                        .filter(|&&id| truth.contains(&(id as u32)))
+                        .count();
+                    hits_total += hits;
+                    latencies.push(us);
+                    rows.push_str(&format!(
+                        "{build_id},{assign},{k},{np},{},{qid},{},{us:.1},{},{hits}\n",
+                        ef.map_or(String::new(), |e| e.to_string()),
+                        plan.split,
+                        returned.len()
+                    ));
+                }
+                out.queries.lock().unwrap().write_all(rows.as_bytes()).unwrap();
+                let recall = hits_total as f64 / (plan.ids.len() * truth_k) as f64;
+                let mean = latencies.iter().sum::<f64>() / latencies.len() as f64;
+                latencies.sort_by(f64::total_cmp);
+                let row = json!({
+                    "k": k, "nprobes": np, "ef": ef, "queries": plan.ids.len(),
+                    "split": plan.split, "recall": recall, "mean_us": mean,
+                    "p50_us": percentile(&latencies, 0.5),
+                    "p95_us": percentile(&latencies, 0.95),
+                    "p99_us": percentile(&latencies, 0.99),
+                    "cache": "warm",
+                });
+                println!(
+                    "    k={k:<3} nprobes={np:<4} ef={:<4} recall={recall:.4} p50={:.0}us p95={:.0}us",
+                    ef.map_or("-".into(), |e| e.to_string()),
+                    row["p50_us"].as_f64().unwrap(),
+                    row["p95_us"].as_f64().unwrap()
+                );
+                summary.push(row);
+            }
+        }
+    }
+    summary
+}
+
+#[tokio::main(flavor = "multi_thread")]
+async fn main() {
+    let kind = std::env::var("DATASET").unwrap_or_else(|_| "gist".into());
+    let dir = PathBuf::from(std::env::var("DATA_DIR").expect("DATA_DIR"));
+    let uri = std::env::var("DS_PATH").expect("DS_PATH");
+    let limit: Option<usize> = std::env::var("N_LIMIT").ok().map(|v| v.parse().unwrap());
+    let index_kind = std::env::var("INDEX").unwrap_or_else(|_| "ivf_rq".into());
+    let mode = std::env::var("MODE").unwrap_or_else(|_| "complete".into());
+    let specs: Vec<String> = env_list("ASSIGN", "auto");
+    let repeats: usize = env_or("REPEATS", 1);
+    let seed: u64 = env_or("SEED", 42);
+    let run_dir = PathBuf::from(std::env::var("RUN_DIR").unwrap_or_else(|_| {
+        format!(
+            "results/{}-{}",
+            kind,
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_secs()
+        )
+    }));
+    // Fail fast on malformed configurations before loading data.
+    specs.iter().for_each(|s| drop(parse_assignment(s)));
+    let _ = index_params(&index_kind, IvfBuildParams::default());
+    assert!(
+        matches!(mode.as_str(), "complete" | "fixed"),
+        "MODE must be complete or fixed"
+    );
+
+    let t = Instant::now();
+    let data = load_data(&kind, &dir, limit);
+    println!(
+        "loaded {kind}: {}x{} base, {} queries, truth k={} in {:.1}s",
+        data.base.rows,
+        data.base.dim,
+        data.queries.rows,
+        data.truth.k,
+        t.elapsed().as_secs_f64()
+    );
+    if !Path::new(&uri).exists() {
+        let t = Instant::now();
+        write_dataset(&data.base, &uri).await;
+        println!("ingested dataset in {:.1}s (untimed)", t.elapsed().as_secs_f64());
+    }
+    let mut dataset = Dataset::open(&uri).await.unwrap();
+    assert_eq!(
+        dataset.count_rows(None).await.unwrap(),
+        data.base.rows,
+        "DS_PATH row count does not match the configured base subset"
+    );
+
+    let out = Output::new(&run_dir);
+    std::fs::create_dir_all(run_dir.join("logs")).unwrap();
+    let manifest_path = run_dir.join("manifest.json");
+    if !manifest_path.exists() {
+        std::fs::write(
+            &manifest_path,
+            serde_json::to_string_pretty(&manifest(&data, &kind, &run_dir)).unwrap(),
+        )
+        .unwrap();
+    }
+    let plan = query_plan(&data);
+    let skip_query = std::env::var("SKIP_QUERY").is_ok();
+
+    for repeat in 0..repeats {
+        // Fixed-model layer: train once per repeat; every backend sees identical
+        // centroids and (if any tree backend is requested) the retained hierarchy.
+        let mut fixed: Option<(Arc<FixedSizeListArray>, Option<Arc<_>>, f64)> = None;
+        if mode == "fixed" {
+            let mut ivf = ivf_params();
+            ivf.seed = Some(seed.wrapping_add(repeat as u64));
+            if specs.iter().any(|s| s.starts_with("tree")) {
+                ivf.assignment = CentroidAssignment::Tree { beam: 1 };
+            }
+            let t = Instant::now();
+            let model = build_ivf_model(
+                &dataset,
+                "vector",
+                data.base.dim,
+                MetricType::L2,
+                &ivf,
+                None,
+                Arc::new(StageTimer::default()),
+            )
+            .await
+            .unwrap();
+            let train = t.elapsed().as_secs_f64();
+            println!("[repeat {repeat}] trained fixed model in {train:.2}s");
+            let centroids = Arc::new(model.centroids.clone().unwrap());
+            let sample: usize = env_or("ASSIGN_SAMPLE", 100_000);
+            if sample > 0 {
+                assignment_quality(
+                    &data,
+                    &centroids,
+                    model.assignment_tree.clone(),
+                    &specs,
+                    sample,
+                    seed ^ 0x51,
+                    &out,
+                )
+                .await;
+            }
+            fixed = Some((centroids, model.assignment_tree.clone(), train));
+        }
+
+        // Randomize configuration order per repeat (deterministically) to avoid drift bias.
+        let mut order: Vec<usize> = (0..specs.len()).collect();
+        order.sort_by_key(|&i| splitmix(seed ^ ((repeat as u64) << 32) ^ i as u64));
+        for i in order {
+            let spec = &specs[i];
+            let mut ivf = ivf_params();
+            ivf.seed = Some(seed.wrapping_add(repeat as u64));
+            ivf.assignment = parse_assignment(spec);
+            if let Some((centroids, tree, _)) = &fixed {
+                ivf.centroids = Some(centroids.clone());
+                ivf.assignment_tree = tree.clone();
+                ivf.retrain = false;
+            }
+            let params = index_params(&index_kind, ivf);
+            let build_id = format!("{index_kind}-{mode}-{spec}-r{repeat}");
+            println!("[{build_id}] building on {}x{}", data.base.rows, data.base.dim);
+            let timer = Arc::new(StageTimer::default());
+            peak_rss_reset();
+            let cpu0 = cpu_seconds();
+            let t = Instant::now();
+            let result = dataset
+                .create_index_builder(&["vector"], IndexType::Vector, &params)
+                .name(INDEX_NAME.into())
+                .replace(true)
+                .progress(timer.clone())
+                .await;
+            let wall = t.elapsed().as_secs_f64();
+            let cpu = cpu_seconds() - cpu0;
+            let rss = peak_rss_bytes();
+            let stages: serde_json::Map<String, Value> = timer
+                .done
+                .lock()
+                .unwrap()
+                .iter()
+                .map(|(s, v)| (s.clone(), json!(v)))
+                .collect();
+            let mut row = json!({
+                "build_id": build_id, "index": index_kind, "mode": mode, "assign": spec,
+                "repeat": repeat, "seed": seed.wrapping_add(repeat as u64),
+                "num_partitions": env_or("NUM_PARTITIONS", 1000usize),
+                "rows": data.base.rows, "dim": data.base.dim,
+                "build_secs": wall, "cpu_secs": cpu, "peak_rss_bytes": rss,
+                "vectors_per_sec": data.base.rows as f64 / wall,
+                "stages": stages,
+                "fixed_train_secs": fixed.as_ref().map(|f| f.2),
+            });
+            if let Err(e) = result {
+                println!("  FAILED: {e}");
+                row["status"] = json!("error");
+                row["error"] = json!(e.to_string());
+                Output::line(&out.builds, &row);
+                continue;
+            }
+            dataset = Dataset::open(&uri).await.unwrap();
+            let index = dataset
+                .load_indices_by_name(INDEX_NAME)
+                .await
+                .unwrap()
+                .into_iter()
+                .next()
+                .expect("committed index");
+            let bytes = dir_bytes(&Path::new(&uri).join("_indices").join(index.uuid.to_string()));
+            row["status"] = json!("ok");
+            row["index_bytes"] = json!(bytes);
+            // Lance may cap the requested partition count on small datasets; record
+            // the committed value and keep the full statistics alongside the run.
+            if let Ok(stats) = dataset.index_statistics(INDEX_NAME).await {
+                let parsed: Value = serde_json::from_str(&stats).unwrap_or(Value::Null);
+                row["actual_num_partitions"] = find_key(&parsed, "num_partitions");
+                let _ = std::fs::write(
+                    run_dir.join("logs").join(format!("index_stats-{build_id}.json")),
+                    stats,
+                );
+            }
+            println!(
+                "  build {wall:.2}s cpu {cpu:.1}s rss {:.2} GB index {:.1} MB",
+                rss.unwrap_or(0) as f64 / 1e9,
+                bytes as f64 / 1e6
+            );
+            if !skip_query {
+                row["search"] = Value::Array(
+                    evaluate(
+                        &dataset,
+                        &data,
+                        &plan,
+                        &build_id,
+                        spec,
+                        is_graph_index(&index_kind),
+                        &out,
+                    )
+                    .await,
+                );
+            }
+            Output::line(&out.builds, &row);
+            out.queries.lock().unwrap().flush().unwrap();
+        }
+    }
+    println!("results in {}", run_dir.display());
+}
