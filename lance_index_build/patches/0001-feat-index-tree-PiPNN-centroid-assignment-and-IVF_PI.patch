+use std::path::PathBuf;
+
+fn main() {
+    println!("cargo:rerun-if-env-changed=EIGEN_INCLUDE_DIR");
+    println!("cargo:rerun-if-env-changed=LANCE_PIPNN_NATIVE");
+    println!("cargo:rerun-if-changed=cpp");
+    let eigen = std::env::var_os("EIGEN_INCLUDE_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("/usr/include/eigen3"));
+    if !eigen.join("Eigen/Dense").is_file() {
+        panic!(
+            "PiPNN requires Eigen headers: set EIGEN_INCLUDE_DIR to a directory containing Eigen/Dense"
+        );
+    }
+    let mut build = cc::Build::new();
+    build
+        .cpp(true)
+        .std("c++17")
+        .include(eigen)
+        .define("EIGEN_DONT_PARALLELIZE", None)
+        .flag_if_supported("-ffp-contract=off")
+        .file("cpp/bridge.cpp");
+    // Portable by default. `LANCE_PIPNN_NATIVE=1` opts into host-specific code
+    // (e.g. the AVX-512 paths of the reference builder) for labelled benchmark runs
+    // only; the chosen flags are exported so results can record them.
+    let native = std::env::var_os("LANCE_PIPNN_NATIVE").is_some_and(|v| v == "1");
+    let mut flags = vec!["-std=c++17", "-ffp-contract=off", "-DEIGEN_DONT_PARALLELIZE"];
+    if native {
+        build.flag("-march=native");
+        flags.push("-march=native");
+    }
+    println!("cargo:rustc-env=LANCE_PIPNN_BUILD_FLAGS={}", flags.join(" "));
+    build.compile("lance_pipnn");
+}
