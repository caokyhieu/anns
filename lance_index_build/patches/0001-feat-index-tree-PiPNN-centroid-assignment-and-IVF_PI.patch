+/// A prepared dataset-to-centroid assigner for measurement outside a full build.
+///
+/// Preparation (tree validation, HNSW/PiPNN centroid graph construction) happens
+/// once in [`PreparedAssignment::prepare`]; [`PreparedAssignment::assign`] can then
+/// be called on many batches. Distances are squared L2 to the selected centroid.
+pub struct PreparedAssignment {
+    transformer: PartitionTransformer,
+    input_column: String,
+}
+
+impl PreparedAssignment {
+    pub fn prepare(
+        centroids: FixedSizeListArray,
+        metric_type: MetricType,
+        assignment: &builder::CentroidAssignment,
+        tree: Option<Arc<crate::vector::assignment_tree::AssignmentTree>>,
+    ) -> Result<Self> {
+        let input_column = "vector".to_owned();
+        let transformer = if matches!(assignment, builder::CentroidAssignment::Auto) {
+            PartitionTransformer::new(centroids, metric_type, &input_column)
+        } else {
+            PartitionTransformer::with_assignment(
+                centroids,
+                metric_type,
+                &input_column,
+                assignment,
+                tree,
+            )?
+        }
+        .with_distance(true);
+        Ok(Self {
+            transformer,
+            input_column,
+        })
+    }
+
+    /// PiPNN centroid-graph statistics, if this assigner uses PiPNN.
+    #[cfg(feature = "pipnn")]
+    pub fn pipnn_stats(&self) -> Option<crate::vector::pipnn::GraphStats> {
+        self.transformer.pipnn_stats()
+    }
+
+    /// Returns `(partition_ids, squared_distances)`; nulls mark unassigned rows.
+    pub fn assign(&self, vectors: FixedSizeListArray) -> Result<(UInt32Array, Float32Array)> {
+        let schema = Arc::new(arrow_schema::Schema::new(vec![arrow_schema::Field::new(
+            &self.input_column,
+            vectors.data_type().clone(),
+            true,
+        )]));
+        let batch = RecordBatch::try_new(schema, vec![Arc::new(vectors)])?;
+        let out = self.transformer.transform(&batch)?;
+        let ids = out
+            .column_by_name(PART_ID_COLUMN)
+            .ok_or_else(|| Error::index("assignment produced no partition column"))?
+            .as_primitive::<UInt32Type>()
+            .clone();
+        let distances = out
+            .column_by_name(crate::vector::CENTROID_DIST_COLUMN)
+            .ok_or_else(|| Error::index("assignment produced no distance column"))?
+            .as_primitive::<Float32Type>()
+            .clone();
+        Ok((ids, distances))
+    }
+}
+
+/// Create a current-format flat or RQ build transform with explicit centroid assignment.
+///
+/// `tree` must refer to exactly the supplied centroid generation. Auto mode
+/// preserves the existing transform selection, including its environment controls.
+pub fn new_ivf_transformer_with_assignment(
+    centroids: FixedSizeListArray,
+    metric_type: MetricType,
+    vector_column: &str,
+    quantizer: Quantizer,
+    assignment: &builder::CentroidAssignment,
+    tree: Option<Arc<crate::vector::assignment_tree::AssignmentTree>>,
+) -> Result<IvfTransformer> {
+    if matches!(assignment, builder::CentroidAssignment::Auto) {
+        return new_ivf_transformer_with_quantizer(
+            centroids,
+            metric_type,
+            vector_column,
+            quantizer,
+            None,
+        );
+    }
+    if metric_type != MetricType::L2 {
+        return Err(Error::not_supported(
+            "explicit centroid assignment currently supports L2 only",
+        ));
+    }
+    let mut transforms: Vec<Arc<dyn Transformer>> = vec![
+        Arc::new(super::transform::Flatten::new(vector_column)),
+        Arc::new(KeepFiniteVectors::new(vector_column)),
+        Arc::new(
+            PartitionTransformer::with_assignment(
+                centroids.clone(),
+                metric_type,
+                vector_column,
+                assignment,
+                tree,
+            )?
+            .with_distance(matches!(&quantizer, Quantizer::Rabit(_))),
+        ),
+    ];
+    match quantizer {
+        Quantizer::Flat(_) => transforms.push(Arc::new(FlatTransformer::new(vector_column))),
+        Quantizer::Rabit(rq) => {
+            transforms.push(Arc::new(ResidualTransform::new(
+                centroids.clone(),
+                PART_ID_COLUMN,
+                vector_column,
+            )));
+            transforms.push(Arc::new(RQTransformer::new(
+                rq,
+                metric_type,
+                centroids.clone(),
+                vector_column,
+            )?));
+        }
+        _ => {
+            return Err(Error::not_supported(
+                "explicit centroid assignment currently supports flat and RQ storage only",
+            ));
+        }
+    }
+    Ok(IvfTransformer::new(centroids, metric_type, transforms))
+}
