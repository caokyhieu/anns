+
+//! Internal C ABI. Call only through feature-checked candidates with validated
+//! buffers; the C objects use the calling thread's current SVE vector length.
+
+#[cfg(kernel_support = "sve")]
+unsafe extern "C" {
+    pub(crate) fn lance_dot_f32_sve(x: *const f32, y: *const f32, n: usize) -> f32;
+    pub(crate) fn lance_l2_f32_sve(x: *const f32, y: *const f32, n: usize) -> f32;
+    pub(crate) fn lance_dot_u8_sve(x: *const u8, y: *const u8, n: usize) -> u32;
+    pub(crate) fn lance_l2_u8_sve(x: *const u8, y: *const u8, n: usize) -> u32;
+    pub(crate) fn lance_sum_f32_rows_sve(
+        codes: *const u8,
+        tables: *const f32,
+        n: usize,
+        code_len: usize,
+        rows: *const u32,
+        count: usize,
+        out: *mut f32,
+    );
+}
+
+#[cfg(kernel_support = "sve2")]
