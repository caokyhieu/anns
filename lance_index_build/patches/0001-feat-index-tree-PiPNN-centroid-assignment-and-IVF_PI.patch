diff --git a/rust/lance-linalg/src/simd/sve.c b/rust/lance-linalg/src/simd/sve.c
new file mode 100644
index 000000000..eb3319d01
--- /dev/null
+++ b/rust/lance-linalg/src/simd/sve.c
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+#include <arm_sve.h>
+#include <stddef.h>
+#include <stdint.h>
+
+// No fixed vector length: Linux can use a different VL on each calling thread.
+// Do not compile with fast-math: PQ sums must retain their addition order.
+float lance_dot_f32_sve(const float *x, const float *y, size_t n) {
+  svfloat32_t a = svdup_f32(0), b = svdup_f32(0);
+  size_t i = 0, lanes = svcntw();
+  for (; n - i >= 2 * lanes; i += 2 * lanes) {
+    a = svmla_f32_m(svptrue_b32(), a, svld1_f32(svptrue_b32(), x + i),
+                    svld1_f32(svptrue_b32(), y + i));
+    b = svmla_f32_m(svptrue_b32(), b, svld1_f32(svptrue_b32(), x + i + lanes),
+                    svld1_f32(svptrue_b32(), y + i + lanes));
+  }
+  for (; i < n; i += lanes) {
+    svbool_t pg = svwhilelt_b32((uint64_t)i, (uint64_t)n);
+    a = svmla_f32_m(pg, a, svld1_f32(pg, x + i), svld1_f32(pg, y + i));
+  }
+  return svaddv_f32(svptrue_b32(), svadd_f32_x(svptrue_b32(), a, b));
+}
+
+float lance_l2_f32_sve(const float *x, const float *y, size_t n) {
+  svfloat32_t a = svdup_f32(0), b = svdup_f32(0);
+  size_t i = 0, lanes = svcntw();
+  for (; n - i >= 2 * lanes; i += 2 * lanes) {
+    svfloat32_t d0 = svsub_f32_x(svptrue_b32(), svld1_f32(svptrue_b32(), x + i),
+                                svld1_f32(svptrue_b32(), y + i));
+    svfloat32_t d1 = svsub_f32_x(svptrue_b32(), svld1_f32(svptrue_b32(), x + i + lanes),
+                                svld1_f32(svptrue_b32(), y + i + lanes));
+    a = svmla_f32_m(svptrue_b32(), a, d0, d0);
+    b = svmla_f32_m(svptrue_b32(), b, d1, d1);
+  }
+  for (; i < n; i += lanes) {
+    svbool_t pg = svwhilelt_b32((uint64_t)i, (uint64_t)n);
+    svfloat32_t d = svsub_f32_x(pg, svld1_f32(pg, x + i), svld1_f32(pg, y + i));
+    a = svmla_f32_m(pg, a, d, d);
+  }
+  return svaddv_f32(svptrue_b32(), svadd_f32_x(svptrue_b32(), a, b));
+}
+
+// The ABI receives validated, column-major packed codes. Each byte holds
+// low/high nibble indices into two consecutive 16-entry tables.
+void lance_sum_f32_rows_sve(const uint8_t *codes, const float *tables,
+                          size_t n, size_t code_len, const uint32_t *rows,
+                          size_t count, float *out) {
+  for (size_t i = 0; i < count; i += svcntw()) {
+    svbool_t pg = svwhilelt_b32((uint64_t)i, (uint64_t)count);
+    svuint32_t ids = svld1_u32(pg, rows + i);
+    svfloat32_t sum = svdup_f32(-0.0f);
+    for (size_t col = 0; col < code_len; ++col) {
+      svuint32_t code = svld1ub_gather_u32offset_u32(pg, codes + col * n, ids);
+      svuint32_t low = svand_n_u32_x(pg, code, 15);
+      svuint32_t high = svlsr_n_u32_x(pg, code, 4);
+      svfloat32_t l = svld1_gather_u32index_f32(pg, tables + 32 * col, low);
+      svfloat32_t h = svld1_gather_u32index_f32(pg, tables + 32 * col + 16, high);
+      // Match the reference's sum += (low + high), including signed zero.
+      sum = svadd_f32_m(pg, sum, svadd_f32_x(pg, l, h));
+    }
+    svst1_f32(pg, out + i, sum);
+  }
+}
+
+// The public u32 kernels return the low 32 bits. The existing Rust u64
+// wrappers chunk inputs to obtain an exact wide result, including overflow.
+uint32_t lance_dot_u8_sve(const uint8_t *x, const uint8_t *y, size_t n) {
+  svuint32_t sum = svdup_u32(0);
+  for (size_t i = 0; i < n; i += svcntb()) {
+    svbool_t pg = svwhilelt_b8((uint64_t)i, (uint64_t)n);
+    // Predicated loads zero inactive bytes, so the unpredicated dot is safe.
+    sum = svdot_u32(sum, svld1_u8(pg, x + i), svld1_u8(pg, y + i));
+  }
+  return svaddv_u32(svptrue_b32(), sum);
+}
+
+uint32_t lance_l2_u8_sve(const uint8_t *x, const uint8_t *y, size_t n) {
+  svuint32_t sum = svdup_u32(0);
+  for (size_t i = 0; i < n; i += svcntb()) {
+    svbool_t pg = svwhilelt_b8((uint64_t)i, (uint64_t)n);
+    svuint8_t d = svabd_u8_z(pg, svld1_u8(pg, x + i), svld1_u8(pg, y + i));
+    sum = svdot_u32(sum, d, d);
+  }
+  return svaddv_u32(svptrue_b32(), sum);
+}
diff --git a/rust/lance-linalg/src/simd/sve2.c b/rust/lance-linalg/src/simd/sve2.c
new file mode 100644
index 000000000..f6e47dca5
--- /dev/null
+++ b/rust/lance-linalg/src/simd/sve2.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+#include <arm_sve.h>
+#include <stddef.h>
+#include <stdint.h>
+
+// Byte table lookups operate on the low byte of each u16 index. Mask off
+// the irrelevant high byte before reconstructing a full u16 table entry.
+static inline svuint16_t lookup16(svuint8_t low, svuint8_t high,
+                                 svuint16_t index) {
+  svuint8_t bytes = svreinterpret_u8_u16(index);
+  svuint16_t l = svand_n_u16_x(svptrue_b16(),
+      svreinterpret_u16_u8(svtbl_u8(low, bytes)), 255);
+  svuint16_t h = svlsl_n_u16_x(svptrue_b16(),
+      svreinterpret_u16_u8(svtbl_u8(high, bytes)), 8);
+  return svorr_u16_x(svptrue_b16(), l, h);
+}
+
+// SVE2 widening addition separates even/odd PERM0 lanes directly into
+// contiguous output rows. It also preserves carries between table bytes.
+void lance_sum_hacc_sve2(const uint8_t *codes, const uint8_t *tables,
+                       size_t code_len, size_t n, uint32_t *out) {
+  svbool_t table_pg = svwhilelt_b8((uint64_t)0, (uint64_t)16);
+  for (size_t batch = 0; batch < n; batch += 32) {
+    for (size_t j = 0; j < 16; j += svcnth()) {
+      svbool_t pg = svwhilelt_b16((uint64_t)j, (uint64_t)16);
+      svuint32_t le = svdup_u32(0), lo = svdup_u32(0);
+      svuint32_t he = svdup_u32(0), ho = svdup_u32(0);
+      for (size_t col = 0; col < code_len; ++col) {
+        const uint8_t *block = codes + batch * code_len + col * 32;
+        const uint8_t *table = tables + col * 64;
+        svuint16_t c0 = svld1ub_u16(pg, block + j);
+        svuint16_t c1 = svld1ub_u16(pg, block + 16 + j);
+        svuint8_t t0 = svld1_u8(table_pg, table);
+        svuint8_t t1 = svld1_u8(table_pg, table + 16);
+        svuint8_t t2 = svld1_u8(table_pg, table + 32);
+        svuint8_t t3 = svld1_u8(table_pg, table + 48);
+        svuint16_t l0 = lookup16(t0, t2, svand_n_u16_x(pg, c0, 15));
+        svuint16_t l1 = lookup16(t1, t3, svand_n_u16_x(pg, c1, 15));
+        svuint16_t h0 = lookup16(t0, t2, svlsr_n_u16_x(pg, c0, 4));
+        svuint16_t h1 = lookup16(t1, t3, svlsr_n_u16_x(pg, c1, 4));
+        le = svadd_u32_x(svptrue_b32(), le, svaddlb_u32(l0, l1));
+        lo = svadd_u32_x(svptrue_b32(), lo, svaddlt_u32(l0, l1));
+        he = svadd_u32_x(svptrue_b32(), he, svaddlb_u32(h0, h1));
+        ho = svadd_u32_x(svptrue_b32(), ho, svaddlt_u32(h0, h1));
+      }
+      svbool_t store_pg = svwhilelt_b32((uint64_t)(j / 2), (uint64_t)8);
+      svst1_u32(store_pg, out + batch + j / 2, le);
+      svst1_u32(store_pg, out + batch + 8 + j / 2, lo);
+      svst1_u32(store_pg, out + batch + 16 + j / 2, he);
+      svst1_u32(store_pg, out + batch + 24 + j / 2, ho);
+    }
+  }
+}
