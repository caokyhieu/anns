+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! PiPNN construction with Lance-native storage, filtering and beam search.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use arrow_array::builder::{ListBuilder, UInt32Builder};
+use arrow_array::cast::AsArray;
+use arrow_array::types::Float32Type;
+use arrow_array::{Array, ArrayRef, Float32Array, RecordBatch, UInt64Array};
+use arrow_schema::{DataType, Field, Schema, SchemaRef};
+use lance_core::deepsize::DeepSizeOf;
+use lance_core::utils::row_addr_remap::RowAddrRemap;
+use lance_core::{Error, Result};
+use lance_linalg::distance::DistanceType;
+use serde::{Deserialize, Serialize};
+
+use crate::metrics::MetricsCollector;
+use crate::prefilter::PreFilter;
+use crate::vector::flat::storage::FlatFloatStorage;
+use crate::vector::graph::{
+    BorrowingGraph, OrderedFloat, OrderedNode, VisitedGenerator, beam_search_borrowed,
+};
+use crate::vector::hnsw::builder::HnswQueryParams;
+use crate::vector::storage::{DistCalculator, VectorStore};
+use crate::vector::v3::subindex::IvfSubIndex;
+use crate::vector::{Query, VECTOR_RESULT_SCHEMA};
+
+/// C++ flags of the linked native builder, for benchmark manifests.
+pub const NATIVE_BUILD_FLAGS: &str = lance_pipnn::BUILD_FLAGS;
+
+const METADATA_KEY: &str = "lance:pipnn";
+const NEIGHBORS: &str = "neighbors";
+
+/// Construction controls for float32 L2 PiPNN. Native workers share this thread budget.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, DeepSizeOf)]
+pub struct PipnnBuildParams {
+    pub leaf_size: usize,
+    pub local_k: usize,
+    pub reservoir: usize,
+    pub degree: usize,
+    pub threads: usize,
+    pub seed: u64,
+    pub alpha: f64,
+}
+
+impl Default for PipnnBuildParams {
+    fn default() -> Self {
+        Self {
+            leaf_size: 1024,
+            local_k: 2,
+            reservoir: 160,
+            degree: 64,
+            threads: 1,
+            seed: 555,
+            alpha: 1.2,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, DeepSizeOf)]
+struct Metadata {
+    version: u32,
+    entry: u32,
+    params: PipnnBuildParams,
+}
+
+/// Single-layer graph; vertex IDs are partition-local vector storage offsets.
+#[derive(Debug, Clone, DeepSizeOf)]
+pub struct PiPNN {
+    adjacency: Vec<u32>,
+    degrees: Vec<u16>,
+    metadata: Metadata,
+    /// Native sketch/routing/leaf/pruning/total timings, excluding adapter copies.
+    pub stage_seconds: [f64; 5],
+}
+
+impl BorrowingGraph for PiPNN {
+    fn len(&self) -> usize {
+        self.degrees.len()
+    }
+    fn neighbors(&self, id: u32) -> &[u32] {
+        let start = id as usize * self.metadata.params.degree;
+        &self.adjacency[start..start + self.degrees[id as usize] as usize]
+    }
+}
+
+/// Structural statistics of a built graph (the source has no connectivity guarantee).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct GraphStats {
+    pub vertices: usize,
+    pub mean_degree: f64,
+    pub max_degree: usize,
+    /// Fraction of vertices reachable from the entry point along out-edges.
+    pub reachable_fraction: f64,
+}
+
+impl PiPNN {
+    /// Mean/max degree and entry-point reachability (BFS over out-edges).
+    pub fn stats(&self) -> GraphStats {
+        let n = self.len();
+        if n == 0 {
+            return GraphStats {
+                vertices: 0,
+                mean_degree: 0.0,
+                max_degree: 0,
+                reachable_fraction: 1.0,
+            };
+        }
+        let mut seen = vec![false; n];
+        let mut stack = vec![self.metadata.entry];
+        seen[self.metadata.entry as usize] = true;
+        let mut reached = 1usize;
+        while let Some(v) = stack.pop() {
+            for &u in self.neighbors(v) {
+                if !seen[u as usize] {
+                    seen[u as usize] = true;
+                    reached += 1;
+                    stack.push(u);
+                }
+            }
+        }
+        GraphStats {
+            vertices: n,
+            mean_degree: self.degrees.iter().map(|&d| d as f64).sum::<f64>() / n as f64,
+            max_degree: self.degrees.iter().copied().max().unwrap_or(0) as usize,
+            reachable_fraction: reached as f64 / n as f64,
+        }
+    }
+
+    /// Build over contiguous vectors. Run on a blocking worker, outside `spawn_cpu`.
+    pub fn build(points: &[f32], dimension: usize, params: PipnnBuildParams) -> Result<Self> {
+        let native = lance_pipnn::BuildParams {
+            leaf_size: params.leaf_size,
+            local_k: params.local_k,
+            reservoir: params.reservoir,
+            degree: params.degree,
+            threads: params.threads,
+            seed: params.seed,
+            alpha: params.alpha,
+        };
+        let graph = lance_pipnn::build(points, dimension, &native).map_err(Error::invalid_input)?;
+        Ok(Self {
+            adjacency: graph.adjacency,
+            degrees: graph.degrees,
+            metadata: Metadata {
+                version: 1,
+                entry: graph.entry,
+                params,
+            },
+            stage_seconds: graph.stage_seconds,
+        })
+    }
+
+    /// Search a centroid graph without converting local vertex IDs into dataset row IDs.
+    pub fn search_centroid_with_scratch(
+        &self,
+        query: ArrayRef,
+        beam: usize,
+        storage: &FlatFloatStorage,
+        scratch: &mut VisitedGenerator,
+    ) -> Result<(u32, f32)> {
+        if beam == 0 || self.is_empty() {
+            return Err(Error::invalid_input(
+                "centroid search requires a nonempty graph and positive beam",
+            ));
+        }
+        let params = HnswQueryParams {
+            ef: beam,
+            lower_bound: None,
+            upper_bound: None,
+            dist_q_c: 0.0,
+            use_acorn: false,
+        };
+        let distances = storage.dist_calculator(query, 0.0);
+        let entry = OrderedNode {
+            id: self.metadata.entry,
+            dist: OrderedFloat(distances.distance(self.metadata.entry)),
+        };
+        let (results, _) = beam_search_borrowed(
+            self,
+            &entry,
+            &params,
+            &distances,
+            None,
+            None,
+            &mut scratch.generate(self.len()),
+        );
+        results
+            .first()
+            .map(|r| (r.id, r.dist.0))
+            .ok_or_else(|| Error::index("PiPNN centroid search returned no candidate"))
+    }
+}
+
+impl IvfSubIndex for PiPNN {
+    type BuildParams = PipnnBuildParams;
+    type QueryParams = HnswQueryParams;
+
+    fn name() -> &'static str {
+        "PIPNN"
+    }
+    fn metadata_key() -> &'static str {
+        METADATA_KEY
+    }
+    fn schema() -> SchemaRef {
+        Arc::new(Schema::new(vec![Field::new(
+            NEIGHBORS,
+            DataType::List(Arc::new(Field::new("item", DataType::UInt32, true))),
+            false,
+        )]))
+    }
+
+    fn empty_partition_metadata(params: Option<&Self::BuildParams>) -> Option<String> {
+        serde_json::to_string(&Metadata {
+            version: 1,
+            entry: 0,
+            params: params.cloned().unwrap_or_default(),
+        })
+        .ok()
+    }
+
+    fn query_params(query: &Query, _query_key: &ArrayRef, dist_q_c: f32) -> Self::QueryParams {
+        let mut params = HnswQueryParams::from(query);
+        params.dist_q_c = dist_q_c;
+        params
+    }
+
+    fn load(data: RecordBatch) -> Result<Self> {
+        let encoded = data
+            .schema_ref()
+            .metadata()
+            .get(METADATA_KEY)
+            .ok_or_else(|| Error::corrupt_file_named("PiPNN", "missing graph metadata"))?;
+        let metadata: Metadata = serde_json::from_str(encoded)
+            .map_err(|e| Error::corrupt_file_named("PiPNN", e.to_string()))?;
+        if metadata.version != 1
+            || metadata.params.degree == 0
+            || metadata.params.degree > u16::MAX as usize
+        {
+            return Err(Error::corrupt_file_named(
+                "PiPNN",
+                "unsupported version or invalid degree",
+            ));
+        }
+        let neighbors = data
+            .column_by_name(NEIGHBORS)
+            .and_then(|a| a.as_list_opt::<i32>())
+            .ok_or_else(|| Error::corrupt_file_named("PiPNN", "missing neighbor lists"))?;
+        let n = neighbors.len();
+        if n >= u32::MAX as usize
+            || (n > 0 && metadata.entry as usize >= n)
+            || neighbors.null_count() != 0
+        {
+            return Err(Error::corrupt_file_named(
+                "PiPNN",
+                "invalid entry, row count, or null adjacency",
+            ));
+        }
+        let size = n
+            .checked_mul(metadata.params.degree)
+            .ok_or_else(|| Error::corrupt_file_named("PiPNN", "adjacency overflow"))?;
+        let mut adjacency = vec![u32::MAX; size];
+        let mut degrees = Vec::with_capacity(n);
+        for i in 0..n {
+            let row = neighbors.value(i);
+            let row = row
+                .as_primitive_opt::<arrow_array::types::UInt32Type>()
+                .ok_or_else(|| Error::corrupt_file_named("PiPNN", "neighbors must be uint32"))?;
+            if row.len() > metadata.params.degree || row.null_count() != 0 {
+                return Err(Error::corrupt_file_named(
+                    "PiPNN",
+                    "invalid neighbor count or null edge",
+                ));
+            }
+            for (j, &id) in row.values().iter().enumerate() {
+                if id as usize >= n || id as usize == i || row.values()[..j].contains(&id) {
+                    return Err(Error::corrupt_file_named(
+                        "PiPNN",
+                        "invalid or duplicate edge",
+                    ));
+                }
+            }
+            degrees.push(row.len() as u16);
+            let start = i * metadata.params.degree;
+            adjacency[start..start + row.len()].copy_from_slice(row.values());
+        }
+        Ok(Self {
+            adjacency,
+            degrees,
+            metadata,
+            stage_seconds: [0.0; 5],
+        })
+    }
+
+    fn to_batch(&self) -> Result<RecordBatch> {
+        let mut neighbors = ListBuilder::new(UInt32Builder::new());
+        for i in 0..self.len() {
+            neighbors.values().append_slice(self.neighbors(i as u32));
+            neighbors.append(true);
+        }
+        let metadata = HashMap::from([(
+            METADATA_KEY.to_owned(),
+            serde_json::to_string(&self.metadata)?,
+        )]);
+        Ok(RecordBatch::try_new(
+            Arc::new(Self::schema().as_ref().clone().with_metadata(metadata)),
+            vec![Arc::new(neighbors.finish())],
+        )?)
+    }
+
+    fn index_vectors(storage: &impl VectorStore, params: Self::BuildParams) -> Result<Self> {
+        if storage.distance_type() != DistanceType::L2 {
+            return Err(Error::not_supported("PiPNN currently supports L2 only"));
+        }
+        let flat = storage
+            .as_any()
+            .downcast_ref::<FlatFloatStorage>()
+            .ok_or_else(|| Error::not_supported("PiPNN currently requires flat float32 storage"))?;
+        if storage.is_empty() {
+            return Self::build(&[], 1, params);
+        }
+        let first = flat.vector(0);
+        let dimension = first.len();
+        let count = dimension
+            .checked_mul(storage.len())
+            .ok_or_else(|| Error::invalid_input("PiPNN vector buffer overflow"))?;
+        let mut points = Vec::with_capacity(count);
+        for i in 0..storage.len() {
+            let row = flat.vector(i as u32);
+            let row = row
+                .as_primitive_opt::<Float32Type>()
+                .ok_or_else(|| Error::not_supported("PiPNN currently requires float32 vectors"))?;
+            if row.null_count() != 0 {
+                return Err(Error::invalid_input("PiPNN cannot build null vectors"));
+            }
+            points.extend_from_slice(row.values());
+        }
+        Self::build(&points, dimension, params)
+    }
+
+    fn search(
+        &self,
+        query: ArrayRef,
+        k: usize,
+        params: Self::QueryParams,
+        storage: &impl VectorStore,
+        prefilter: Arc<dyn PreFilter>,
+        metrics: &dyn MetricsCollector,
+    ) -> Result<RecordBatch> {
+        if params.ef < k || params.ef == 0 || storage.len() != self.len() {
+            return Err(Error::invalid_input(
+                "PiPNN requires ef >= k, positive ef, and matching graph/storage sizes",
+            ));
+        }
+        if self.is_empty() || k == 0 {
+            return Ok(RecordBatch::new_empty(VECTOR_RESULT_SCHEMA.clone()));
+        }
+        let mut visited = VisitedGenerator::new(self.len());
+        let mut accepted = VisitedGenerator::new(self.len());
+        let mut mask = accepted.generate(self.len());
+        let mask = if prefilter.is_empty() {
+            None
+        } else {
+            for i in prefilter.filter_row_ids(Box::new(storage.row_ids())) {
+                mask.insert(i as u32);
+            }
+            Some(&mask)
+        };
+        let distances = storage.dist_calculator(query, params.dist_q_c);
+        let entry = OrderedNode {
+            id: self.metadata.entry,
+            dist: OrderedFloat(distances.distance(self.metadata.entry)),
+        };
+        let (mut results, comparisons) = beam_search_borrowed(
+            self,
+            &entry,
+            &params,
+            &distances,
+            mask,
+            Some(2),
+            &mut visited.generate(self.len()),
+        );
+        metrics.record_comparisons(comparisons + 1);
+        results.truncate(k);
+        let (ids, distances): (Vec<_>, Vec<_>) = results
+            .into_iter()
+            .map(|r| (storage.row_id(r.id), r.dist.0))
+            .unzip();
+        Ok(RecordBatch::try_new(
+            VECTOR_RESULT_SCHEMA.clone(),
+            vec![
+                Arc::new(Float32Array::from(distances)),
+                Arc::new(UInt64Array::from(ids)),
+            ],
+        )?)
+    }
+
+    fn remap(&self, _mapping: &RowAddrRemap, _storage: &impl VectorStore) -> Result<Self> {
+        Err(Error::not_supported(
+            "PiPNN remapping requires an explicit graph rebuild",
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::metrics::NoOpMetricsCollector;
+    use crate::prefilter::NoFilter;
+    use arrow_array::FixedSizeListArray;
+    use lance_arrow::FixedSizeListArrayExt;
+    use lance_linalg::distance::l2::l2;
+    use lance_testing::datagen::generate_random_array_with_seed;
+
+    const DIM: usize = 16;
+
+    fn storage(n: usize, seed: u8) -> FlatFloatStorage {
+        let values = generate_random_array_with_seed::<Float32Type>(n * DIM, [seed; 32]);
+        FlatFloatStorage::new(
+            FixedSizeListArray::try_new_from_values(values, DIM as i32).unwrap(),
+            DistanceType::L2,
+        )
+    }
+
+    fn params() -> PipnnBuildParams {
+        PipnnBuildParams {
+            leaf_size: 64,
+            degree: 24,
+            reservoir: 64,
+            threads: 2,
+            ..Default::default()
+        }
+    }
+
+    fn flat_values(store: &FlatFloatStorage) -> Vec<f32> {
+        (0..store.len())
+            .flat_map(|i| {
+                store
+                    .vector(i as u32)
+                    .as_primitive::<Float32Type>()
+                    .values()
+                    .to_vec()
+            })
+            .collect()
+    }
+
+    #[test]
+    fn graph_is_structurally_valid_and_round_trips() {
+        let store = storage(2000, 7);
+        let graph = PiPNN::index_vectors(&store, params()).unwrap();
+        assert_eq!(graph.len(), 2000);
+        for i in 0..graph.len() as u32 {
+            let n = graph.neighbors(i);
+            assert!(n.len() <= 24);
+            assert!(n.iter().all(|&j| j != i && (j as usize) < 2000));
+            let unique: std::collections::HashSet<_> = n.iter().collect();
+            assert_eq!(unique.len(), n.len(), "duplicate edge at {i}");
+        }
+        let loaded = PiPNN::load(graph.to_batch().unwrap()).unwrap();
+        assert_eq!(loaded.degrees, graph.degrees);
+        assert_eq!(loaded.metadata.entry, graph.metadata.entry);
+        for i in 0..graph.len() as u32 {
+            assert_eq!(loaded.neighbors(i), graph.neighbors(i));
+        }
+    }
+
+    #[test]
+    fn search_recall_against_brute_force() {
+        let store = storage(2000, 9);
+        let points = flat_values(&store);
+        let graph = PiPNN::index_vectors(&store, params()).unwrap();
+        let queries = generate_random_array_with_seed::<Float32Type>(50 * DIM, [3; 32]);
+        let k = 10;
+        let mut hits = 0;
+        for q in queries.values().chunks(DIM) {
+            let query: ArrayRef = Arc::new(Float32Array::from(q.to_vec()));
+            let params = HnswQueryParams {
+                ef: 128,
+                lower_bound: None,
+                upper_bound: None,
+                dist_q_c: 0.0,
+                use_acorn: false,
+            };
+            let batch = graph
+                .search(
+                    query,
+                    k,
+                    params,
+                    &store,
+                    Arc::new(NoFilter),
+                    &NoOpMetricsCollector,
+                )
+                .unwrap();
+            let ids = batch[lance_core::ROW_ID]
+                .as_primitive::<arrow_array::types::UInt64Type>()
+                .values()
+                .to_vec();
+            assert_eq!(ids.len(), k);
+            let mut exact: Vec<(f32, u64)> = points
+                .chunks(DIM)
+                .enumerate()
+                .map(|(i, p)| (l2(q, p), i as u64))
+                .collect();
+            exact.sort_by(|a, b| a.0.total_cmp(&b.0));
+            let truth: std::collections::HashSet<u64> =
+                exact[..k].iter().map(|(_, i)| *i).collect();
+            hits += ids.iter().filter(|i| truth.contains(i)).count();
+        }
+        let recall = hits as f64 / (50 * k) as f64;
+        assert!(recall >= 0.9, "recall@10 {recall} below 0.9");
+    }
+
+    /// Regression for the branch defaults on small inputs: when every point fits in
+    /// one leaf, only the leaf k-NN edges remain and the graph fragments.
+    #[test]
+    fn single_leaf_inputs_are_sparse_and_reported() {
+        let store = storage(1024, 5);
+        let points = flat_values(&store);
+        let single = PiPNN::build(
+            &points,
+            DIM,
+            PipnnBuildParams {
+                leaf_size: 1024,
+                threads: 2,
+                ..Default::default()
+            },
+        )
+        .unwrap()
+        .stats();
+        let multi = PiPNN::build(
+            &points,
+            DIM,
+            PipnnBuildParams {
+                leaf_size: 64,
+                threads: 2,
+                ..Default::default()
+            },
+        )
+        .unwrap()
+        .stats();
+        println!("single-leaf {single:?}\nmulti-leaf {multi:?}");
+        assert!(single.mean_degree < multi.mean_degree);
+        assert!(multi.reachable_fraction > 0.99, "{multi:?}");
+    }
+
+    #[test]
+    fn centroid_search_returns_exact_distance_to_choice() {
+        let store = storage(500, 11);
+        let points = flat_values(&store);
+        let graph = PiPNN::build(&points, DIM, params()).unwrap();
+        let mut scratch = VisitedGenerator::new(graph.len());
+        let q = &points[37 * DIM..38 * DIM];
+        let (id, dist) = graph
+            .search_centroid_with_scratch(
+                Arc::new(Float32Array::from(q.to_vec())),
+                32,
+                &store,
+                &mut scratch,
+            )
+            .unwrap();
+        assert_eq!(id, 37);
+        assert_eq!(dist, l2(q, &points[id as usize * DIM..(id as usize + 1) * DIM]));
+    }
+
+    #[test]
+    fn empty_and_singleton_partitions_and_maintenance_contract() {
+        let empty = storage(0, 1);
+        let graph = PiPNN::index_vectors(&empty, params()).unwrap();
+        assert!(graph.is_empty());
+        let batch = graph
+            .search(
+                Arc::new(Float32Array::from(vec![0.0; DIM])),
+                5,
+                HnswQueryParams {
+                    ef: 16,
+                    lower_bound: None,
+                    upper_bound: None,
+                    dist_q_c: 0.0,
+                    use_acorn: false,
+                },
+                &empty,
+                Arc::new(NoFilter),
+                &NoOpMetricsCollector,
+            );
+        assert!(batch.is_err() || batch.unwrap().num_rows() == 0);
+
+        let one = storage(1, 2);
+        let graph = PiPNN::index_vectors(&one, params()).unwrap();
+        assert_eq!(graph.len(), 1);
+        let loaded = PiPNN::load(graph.to_batch().unwrap()).unwrap();
+        assert_eq!(loaded.len(), 1);
+        assert!(loaded.neighbors(0).is_empty());
+
+        assert!(PiPNN::empty_partition_metadata(Some(&params())).is_some());
+        let mut corrupt = PiPNN::index_vectors(&storage(100, 4), params())
+            .unwrap()
+            .to_batch()
+            .unwrap();
+        let schema = Arc::new(Schema::new(vec![Field::new(
+            NEIGHBORS,
+            DataType::List(Arc::new(Field::new("item", DataType::UInt32, true))),
+            false,
+        )]));
+        corrupt = RecordBatch::try_new(schema, corrupt.columns().to_vec()).unwrap();
+        assert!(PiPNN::load(corrupt).is_err(), "missing metadata must be rejected");
+    }
+}
