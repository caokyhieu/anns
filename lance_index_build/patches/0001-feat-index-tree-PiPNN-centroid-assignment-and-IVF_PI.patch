index 000000000..3e12d0038
--- /dev/null
+++ b/rust/lance-pipnn/src/lib.rs
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! Owned graph output from the existing fast PiPNN builder.
+//! Call construction on a bounded blocking worker: native workers use locks/joins.
+
+use std::ffi::{CStr, c_char};
+
+/// C++ flags the native builder was compiled with (portable unless `LANCE_PIPNN_NATIVE=1`).
+pub const BUILD_FLAGS: &str = env!("LANCE_PIPNN_BUILD_FLAGS");
+
+/// Native construction parameters. All capacities and thread counts are positive.
+#[repr(C)]
+#[derive(Debug, Clone)]
+pub struct BuildParams {
+    pub leaf_size: usize,
+    pub local_k: usize,
+    pub reservoir: usize,
+    pub degree: usize,
+    pub threads: usize,
+    pub seed: u64,
+    pub alpha: f64,
+}
+
+impl Default for BuildParams {
+    fn default() -> Self {
+        Self {
+            leaf_size: 1024,
+            local_k: 2,
+            reservoir: 160,
+            degree: 64,
+            threads: 1,
+            seed: 555,
+            alpha: 1.2,
+        }
+    }
+}
+
+/// Fixed-stride adjacency; only the first `degrees[row]` entries are valid.
+#[derive(Debug)]
+pub struct Graph {
+    pub adjacency: Vec<u32>,
+    pub degrees: Vec<u16>,
+    pub entry: u32,
+    /// Sketch, routing, leaf, prune/medoid, and total construction seconds.
+    pub stage_seconds: [f64; 5],
+}
+
+unsafe extern "C" {
+    fn lance_pipnn_build(
+        points: *const f32,
+        n: usize,
+        dim: usize,
+        params: *const BuildParams,
+        adjacency: *mut u32,
+        degrees: *mut u16,
+        entry: *mut u32,
+        times: *mut f64,
+        error: *mut c_char,
+        error_capacity: usize,
+    ) -> i32;
+}
+
+/// Build a graph over contiguous float32 L2 vectors. Empty/singleton graphs are valid.
+/// Input buffers are borrowed only for the duration of the synchronous call.
+pub fn build(points: &[f32], dimension: usize, params: &BuildParams) -> Result<Graph, String> {
+    if dimension == 0 || !points.len().is_multiple_of(dimension) {
+        return Err("PiPNN requires a positive dimension dividing the input length".into());
+    }
+    if points.iter().any(|x| !x.is_finite()) {
+        return Err("PiPNN requires finite vectors".into());
+    }
+    if params.leaf_size < 2
+        || params.local_k == 0
+        || params.local_k > params.leaf_size
+        || params.reservoir == 0
+        || params.reservoir > u16::MAX as usize
+        || params.degree == 0
+        || params.degree > params.reservoir
+        || params.threads == 0
+        || !params.alpha.is_finite()
+        || params.alpha < 1.0
+    {
+        return Err(
+            "invalid PiPNN leaf, neighbor, reservoir, degree, thread, or alpha parameter".into(),
+        );
+    }
+    let n = points.len() / dimension;
+    if n >= u32::MAX as usize {
+        return Err("PiPNN uses 32-bit local vertex IDs".into());
+    }
+    let edges = n
+        .checked_mul(params.degree)
+        .ok_or("PiPNN adjacency size overflow")?;
+    let slots = params.reservoir.div_ceil(32) * 32;
+    n.checked_mul(slots)
+        .and_then(|v| v.checked_mul(8))
+        .ok_or("PiPNN reservoir size overflow")?;
+    params
+        .leaf_size
+        .checked_mul(params.leaf_size)
+        .and_then(|v| v.checked_mul(4))
+        .ok_or("PiPNN leaf scratch size overflow")?;
+    let mut graph = Graph {
+        adjacency: vec![u32::MAX; edges],
+        degrees: vec![0; n],
+        entry: 0,
+        stage_seconds: [0.0; 5],
+    };
+    if n < 2 {
+        return Ok(graph);
+    }
+    let mut error = [0 as c_char; 1024];
+    // SAFETY: all lengths/products were checked, input is contiguous and remains
+    // alive until all native workers join. Output arrays are initialized and sized
+    // for n * degree edges/n degrees. C++ catches exceptions at the ABI boundary.
+    let status = unsafe {
+        lance_pipnn_build(
+            points.as_ptr(),
+            n,
+            dimension,
+            params,
+            graph.adjacency.as_mut_ptr(),
+            graph.degrees.as_mut_ptr(),
+            &mut graph.entry,
+            graph.stage_seconds.as_mut_ptr(),
+            error.as_mut_ptr(),
+            error.len(),
+        )
+    };
+    if status != 0 {
+        // SAFETY: the error buffer is initially zero and the bridge always terminates it.
+        return Err(unsafe { CStr::from_ptr(error.as_ptr()) }
+            .to_string_lossy()
+            .into_owned());
+    }
+    if graph.entry as usize >= n {
+        return Err("PiPNN returned invalid entry point".into());
+    }
+    for (i, &degree) in graph.degrees.iter().enumerate() {
+        if degree as usize > params.degree {
+            return Err("PiPNN returned excessive degree".into());
+        }
+        let neighbors = &graph.adjacency[i * params.degree..i * params.degree + degree as usize];
+        for (j, &neighbor) in neighbors.iter().enumerate() {
+            if neighbor as usize >= n
+                || neighbor as usize == i
+                || neighbors[..j].contains(&neighbor)
+            {
+                return Err("PiPNN returned invalid or duplicate edge".into());
+            }
+        }
+    }
+    Ok(graph)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn build_owns_edges_and_handles_small_inputs() {
+        let params = BuildParams {
+            leaf_size: 16,
+            degree: 8,
+            reservoir: 32,
+            threads: 2,
+            ..Default::default()
+        };
+        let points: Vec<f32> = (0..64).flat_map(|i| [i as f32, (i % 7) as f32]).collect();
+        let graph = build(&points, 2, &params).unwrap();
+        assert_eq!(graph.degrees.len(), 64);
+        assert!(graph.degrees.iter().any(|&d| d > 0));
+        assert!(build(&[], 2, &params).unwrap().degrees.is_empty());
+        assert_eq!(build(&[1.0, 2.0], 2, &params).unwrap().degrees, vec![0]);
+        assert!(build(&[f32::NAN, 0.0], 2, &params).is_err());
+        assert!(build(&points, 0, &params).is_err());
+    }
+}
