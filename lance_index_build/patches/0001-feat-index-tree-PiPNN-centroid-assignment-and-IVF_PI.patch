+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+#![allow(clippy::print_stdout, clippy::print_stderr)]
+#![recursion_limit = "256"]
+
+//! Index-build benchmark for the tree / PiPNN assignment and partition-graph suites.
+//!
+//! Configuration is read from environment variables (see `lance_index_build/README.md`):
+//!
+//! - `DATASET` = `gist` (base.f32, query.f32, gt.i32, meta.txt) or `bigann`
+//!   (base.10M.u8bin, query.u8bin, gt.10M.ibin); `DATA_DIR` holds the files.
+//! - `DS_PATH`: Lance dataset path, ingested once outside all timings.
+//! - `N_LIMIT`: optional prefix subset for smoke tests; exact ground truth is then
+//!   recomputed over the subset (the published ground truth is not valid for it).
+//! - `INDEX` = `ivf_rq` | `ivf_flat` | `ivf_hnsw_flat` | `ivf_pipnn_flat`.
+//! - `ASSIGN`: comma list of `auto`, `exact`, `tree:<beam>`, `hnsw` (Lance default
+//!   12/15/15), `hnsw:<m>:<ef_construction>:<ef>`, `pipnn:<beam>[:<degree>:<leaf>]`.
+//! - `MODE` = `complete` (every build trains) or `fixed` (train once, reuse the same
+//!   centroids and retained tree for every assignment backend).
+//! - `NUM_PARTITIONS`, `NUM_BITS`, `MAX_ITERS`, `SAMPLE_RATE`, `SEED`, `HIER_K`,
+//!   `REFINE_ITERS`, `REPEATS`, `HNSW_M`, `HNSW_EFC`, `PIPNN_DEGREE`, `PIPNN_LEAF`,
+//!   `PIPNN_LOCAL_K`, `PIPNN_THREADS`.
+//! - `NPROBES`, `KS`, `EFS` comma lists; `QUERY_SET` = `tune` | `final` | `all`;
+//!   `WARMUP` query passes before timing (default 1).
+//! - `ASSIGN_SAMPLE`: base vectors sampled for assignment quality (fixed mode; 0 = off).
+//! - `RUN_DIR`: output directory for manifest.json, builds.jsonl, queries.csv,
+//!   assignments.jsonl.  `SKIP_QUERY=1` skips search evaluation.
+
+use std::collections::HashSet;
+use std::fs::{File, OpenOptions};
+use std::io::{BufReader, BufWriter, Read, Write};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+use arrow_array::cast::AsArray;
+use arrow_array::types::Int32Type;
+use arrow_array::{
+    Array, FixedSizeListArray, Float32Array, Int32Array, RecordBatch, RecordBatchIterator,
+};
+use arrow_schema::{ArrowError, DataType, Field, Schema as ArrowSchema};
+use async_trait::async_trait;
+use futures::TryStreamExt;
+use lance::dataset::{Dataset, WriteMode, WriteParams};
+use lance::index::DatasetIndexExt;
+use lance::index::vector::VectorIndexParams;
+use lance::index::vector::ivf::build_ivf_model;
+use lance_arrow::FixedSizeListArrayExt;
+use lance_index::IndexType;
+use lance_index::progress::IndexBuildProgress;
+use lance_index::vector::bq::RQBuildParams;
+use lance_index::vector::hnsw::builder::HnswBuildParams;
+use lance_index::vector::ivf::IvfBuildParams;
+use lance_index::vector::ivf::PreparedAssignment;
+use lance_index::vector::ivf::builder::CentroidAssignment;
+use lance_linalg::distance::MetricType;
+use rayon::prelude::*;
+use serde_json::{Value, json};
+
+const INDEX_NAME: &str = "vec_idx";
+
+fn env_or<T: std::str::FromStr>(name: &str, default: T) -> T {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
+
+fn env_list<T: std::str::FromStr>(name: &str, default: &str) -> Vec<T>
+where
+    T::Err: std::fmt::Debug,
+{
+    std::env::var(name)
+        .unwrap_or_else(|_| default.into())
+        .split(',')
+        .filter(|s| !s.is_empty())
+        .map(|v| v.trim().parse().unwrap())
+        .collect()
+}
+
+fn read_bytes(path: &Path) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    BufReader::new(File::open(path).unwrap_or_else(|e| panic!("{}: {e}", path.display())))
+        .read_to_end(&mut bytes)
+        .unwrap();
+    bytes
+}
+
+fn le_u32(b: &[u8]) -> u32 {
+    u32::from_le_bytes([b[0], b[1], b[2], b[3]])
+}
+
+/// Vectors (float32, row-major), number of rows and dimension.
+struct Matrix {
+    values: Vec<f32>,
+    rows: usize,
+    dim: usize,
+}
+
+impl Matrix {
+    fn row(&self, i: usize) -> &[f32] {
+        &self.values[i * self.dim..(i + 1) * self.dim]
+    }
+}
+
+/// Ground truth: `k` neighbor ordinals per query.
+struct Truth {
+    ids: Vec<u32>,
+    k: usize,
+}
+
+fn read_f32_matrix(path: &Path, dim: usize) -> Matrix {
+    let bytes = read_bytes(path);
+    let values: Vec<f32> = bytes
+        .chunks_exact(4)
+        .map(|b| f32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        .collect();
+    let rows = values.len() / dim;
+    Matrix { values, rows, dim }
+}
+
+/// `.u8bin`: u32 rows, u32 dim, then row-major uint8 values (converted exactly to f32).
+fn read_u8bin(path: &Path, limit: Option<usize>) -> Matrix {
+    let mut file = BufReader::new(File::open(path).unwrap());
+    let mut header = [0u8; 8];
+    file.read_exact(&mut header).unwrap();
+    let total = le_u32(&header[..4]) as usize;
+    let dim = le_u32(&header[4..]) as usize;
+    let rows = limit.map_or(total, |l| l.min(total));
+    let mut raw = vec![0u8; rows * dim];
+    file.read_exact(&mut raw).unwrap();
+    Matrix {
+        values: raw.into_iter().map(f32::from).collect(),
+        rows,
+        dim,
+    }
+}
+
+/// `.ibin` ground truth: u32 queries, u32 k, u32 ids[q*k], then f32 distances[q*k].
+fn read_ibin_truth(path: &Path, queries: usize) -> Truth {
+    let bytes = read_bytes(path);
+    let nq = le_u32(&bytes[..4]) as usize;
+    let k = le_u32(&bytes[4..8]) as usize;
+    assert_eq!(nq, queries, "ground truth query count");
+    assert_eq!(bytes.len(), 8 + nq * k * 8, "ibin must hold ids then distances");
+    let ids = bytes[8..8 + nq * k * 4].chunks_exact(4).map(le_u32).collect();
+    Truth { ids, k }
+}
+
+/// Exact squared-L2 top-k over a base subset; only used for N_LIMIT smoke runs.
+fn exact_truth(base: &Matrix, queries: &Matrix, k: usize) -> Truth {
+    let k = k.min(base.rows);
+    let ids = (0..queries.rows)
+        .into_par_iter()
+        .flat_map_iter(|q| {
+            let query = queries.row(q);
+            let mut scored: Vec<(f32, u32)> = (0..base.rows)
+                .map(|i| (lance_linalg::distance::l2::l2(query, base.row(i)), i as u32))
+                .collect();
+            scored.select_nth_unstable_by(k - 1, |a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+            scored.truncate(k);
+            scored.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+            scored.into_iter().map(|(_, id)| id).collect::<Vec<_>>()
+        })
+        .collect();
+    Truth { ids, k }
+}
+
+struct Data {
+    base: Matrix,
+    queries: Matrix,
+    truth: Truth,
+}
+
+fn load_data(kind: &str, dir: &Path, limit: Option<usize>) -> Data {
+    let (base, queries, truth) = match kind {
+        "gist" => {
+            let meta = std::fs::read_to_string(dir.join("meta.txt")).unwrap();
+            let meta: Vec<usize> = meta.split_whitespace().map(|v| v.parse().unwrap()).collect();
+            let (n, dim, nq, gt_k) = (meta[0], meta[1], meta[2], meta[3]);
+            let mut base = read_f32_matrix(&dir.join("base.f32"), dim);
+            assert_eq!(base.rows, n, "GIST base rows");
+            if let Some(l) = limit {
+                base.rows = base.rows.min(l);
+                base.values.truncate(base.rows * dim);
+            }
+            let queries = read_f32_matrix(&dir.join("query.f32"), dim);
+            assert_eq!(queries.rows, nq, "GIST query rows");
+            let gt = read_bytes(&dir.join("gt.i32"));
+            let ids: Vec<u32> = gt.chunks_exact(4).map(le_u32).collect();
+            assert_eq!(ids.len(), nq * gt_k, "GIST ground truth size");
+            (base, queries, Truth { ids, k: gt_k })
+        }
+        "bigann" => {
+            let base = read_u8bin(&dir.join("base.10M.u8bin"), limit);
+            let queries = read_u8bin(&dir.join("query.u8bin"), None);
+            let truth = read_ibin_truth(&dir.join("gt.10M.ibin"), queries.rows);
+            (base, queries, truth)
+        }
+        other => panic!("unknown DATASET {other}"),
+    };
+    let truth = if limit.is_some() {
+        let t = Instant::now();
+        let truth = exact_truth(&base, &queries, truth.k);
+        println!(
+            "recomputed exact top-{} ground truth over {} rows in {:.1}s",
+            truth.k,
+            base.rows,
+            t.elapsed().as_secs_f64()
+        );
+        truth
+    } else {
+        truth
+    };
+    assert!(
+        truth.ids.iter().all(|&id| (id as usize) < base.rows),
+        "ground-truth id outside base"
+    );
+    Data {
+        base,
+        queries,
+        truth,
+    }
+}
+
+fn vector_schema(dim: usize) -> Arc<ArrowSchema> {
+    Arc::new(ArrowSchema::new(vec![
+        Field::new("id", DataType::Int32, false),
+        Field::new(
+            "vector",
+            DataType::FixedSizeList(
+                Arc::new(Field::new("item", DataType::Float32, true)),
+                dim as i32,
+            ),
+            false,
+        ),
+    ]))
+}
+
+async fn write_dataset(base: &Matrix, uri: &str) {
+    let schema = vector_schema(base.dim);
+    let rows_per_batch = 50_000;
+    let s = schema.clone();
+    let batches = (0..base.rows).step_by(rows_per_batch).map(move |start| {
+        let end = (start + rows_per_batch).min(base.rows);
+        let ids = Int32Array::from_iter_values(start as i32..end as i32);
+        let values = Float32Array::from(base.values[start * base.dim..end * base.dim].to_vec());
+        let fsl = FixedSizeListArray::try_new_from_values(values, base.dim as i32)?;
+        Ok::<_, ArrowError>(RecordBatch::try_new(
+            s.clone(),
+            vec![Arc::new(ids), Arc::new(fsl)],
+        )?)
+    });
+    let batches: Vec<_> = batches.collect();
+    let reader = RecordBatchIterator::new(batches, schema);
+    let params = WriteParams {
+        max_rows_per_file: 1 << 30,
+        max_rows_per_group: 8192,
+        mode: WriteMode::Create,
+        ..Default::default()
+    };
+    Dataset::write(reader, uri, Some(params)).await.unwrap();
+}
+
+#[derive(Debug, Default)]
+struct StageTimer {
+    started: Mutex<std::collections::HashMap<String, Instant>>,
+    done: Mutex<Vec<(String, f64)>>,
+}
+
+#[async_trait]
+impl IndexBuildProgress for StageTimer {
+    async fn stage_start(&self, stage: &str, _: Option<u64>, _: &str) -> lance_core::Result<()> {
+        self.started
+            .lock()
+            .unwrap()
+            .insert(stage.to_string(), Instant::now());
+        Ok(())
+    }
+    async fn stage_progress(&self, _: &str, _: u64) -> lance_core::Result<()> {
+        Ok(())
+    }
+    async fn stage_complete(&self, stage: &str) -> lance_core::Result<()> {
+        if let Some(t) = self.started.lock().unwrap().remove(stage) {
+            self.done
+                .lock()
+                .unwrap()
+                .push((stage.to_string(), t.elapsed().as_secs_f64()));
+        }
+        Ok(())
+    }
+}
+
+fn parse_assignment(spec: &str) -> CentroidAssignment {
+    let parts: Vec<&str> = spec.split(':').collect();
+    let num = |i: usize| -> usize {
+        parts
+            .get(i)
+            .unwrap_or_else(|| panic!("assignment {spec}: missing field {i}"))
+            .parse()
+            .unwrap_or_else(|_| panic!("assignment {spec}: bad field {i}"))
+    };
+    match parts[0] {
+        "auto" => CentroidAssignment::Auto,
+        "exact" => CentroidAssignment::Exact,
+        "tree" => CentroidAssignment::Tree { beam: num(1) },
+        "hnsw" if parts.len() == 1 => CentroidAssignment::Hnsw {
+            m: 12,
+            ef_construction: 15,
+            ef: 15,
+        },
+        "hnsw" => CentroidAssignment::Hnsw {
+            m: num(1),
+            ef_construction: num(2),
+            ef: num(3),
+        },
+        #[cfg(feature = "pipnn")]
+        "pipnn" => {
+            let mut params = pipnn_params();
+            if parts.len() > 2 {
+                params.degree = num(2);
+                params.leaf_size = num(3);
+            }
+            CentroidAssignment::Pipnn {
+                params,
+                beam: num(1),
+            }
+        }
+        #[cfg(not(feature = "pipnn"))]
+        "pipnn" => panic!("PiPNN assignment requires building the benchmark with --features pipnn"),
+        other => panic!("unknown assignment backend {other}"),
+    }
+}
+
+#[cfg(feature = "pipnn")]
+fn pipnn_params() -> lance_index::vector::pipnn::PipnnBuildParams {
+    let d = lance_index::vector::pipnn::PipnnBuildParams::default();
+    lance_index::vector::pipnn::PipnnBuildParams {
+        degree: env_or("PIPNN_DEGREE", d.degree),
+        leaf_size: env_or("PIPNN_LEAF", d.leaf_size),
+        local_k: env_or("PIPNN_LOCAL_K", d.local_k),
+        reservoir: env_or("PIPNN_RESERVOIR", d.reservoir),
+        threads: env_or(
+            "PIPNN_THREADS",
+            std::thread::available_parallelism().map_or(1, |n| n.get()),
+        ),
+        seed: env_or("PIPNN_SEED", d.seed),
+        alpha: env_or("PIPNN_ALPHA", d.alpha),
+    }
+}
+
+fn pipnn_flags() -> Option<&'static str> {
+    #[cfg(feature = "pipnn")]
+    {
+        Some(lance_index::vector::pipnn::NATIVE_BUILD_FLAGS)
+    }
+    #[cfg(not(feature = "pipnn"))]
+    {
+        None
+    }
+}
+
+fn ivf_params() -> IvfBuildParams {
+    let mut ivf = IvfBuildParams::new(env_or("NUM_PARTITIONS", 1000));
+    ivf.max_iters = env_or("MAX_ITERS", 50);
+    ivf.sample_rate = env_or("SAMPLE_RATE", ivf.sample_rate);
+    ivf.seed = Some(env_or("SEED", 42u64));
+    ivf.hierarchical_k = env_or("HIER_K", ivf.hierarchical_k);
+    ivf.refine_iters = env_or("REFINE_ITERS", ivf.refine_iters);
+    ivf
+}
+
+fn index_params(kind: &str, ivf: IvfBuildParams) -> VectorIndexParams {
+    match kind {
+        "ivf_rq" => VectorIndexParams::with_ivf_rq_params(
+            MetricType::L2,
+            ivf,
+            RQBuildParams::new(env_or("NUM_BITS", 5)),
+        ),
+        "ivf_flat" => VectorIndexParams::with_ivf_flat_params(MetricType::L2, ivf),
+        "ivf_hnsw_flat" => VectorIndexParams::ivf_hnsw(
+            MetricType::L2,
+            ivf,
+            HnswBuildParams::default()
+                .num_edges(env_or("HNSW_M", 20))
+                .ef_construction(env_or("HNSW_EFC", 150)),
+        ),
+        #[cfg(feature = "pipnn")]
+        "ivf_pipnn_flat" => VectorIndexParams::ivf_pipnn(MetricType::L2, ivf, pipnn_params()),
+        other => panic!("unknown or unavailable INDEX {other}"),
+    }
+}
+
+fn is_graph_index(kind: &str) -> bool {
+    matches!(kind, "ivf_hnsw_flat" | "ivf_pipnn_flat")
+}
+
+fn find_key(v: &Value, key: &str) -> Value {
+    match v {
+        Value::Object(m) => m
+            .get(key)
+            .cloned()
+            .or_else(|| m.values().map(|c| find_key(c, key)).find(|c| !c.is_null()))
+            .unwrap_or(Value::Null),
+        Value::Array(a) => a
+            .iter()
+            .map(|c| find_key(c, key))
+            .find(|c| !c.is_null())
+            .unwrap_or(Value::Null),
+        _ => Value::Null,
+    }
+}
+
+fn splitmix(mut x: u64) -> u64 {
+    x = x.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    x = (x ^ (x >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    x = (x ^ (x >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    x ^ (x >> 31)
+}
+
+/// Deterministic 20% tuning / 80% final split, independent of the build seed.
+fn is_tuning_query(id: usize) -> bool {
+    splitmix(id as u64 ^ 0x7475_6e65) % 5 == 0
+}
+
+fn peak_rss_reset() {
+    // Linux >= 4.0: writing 5 resets VmHWM to the current RSS.
+    let _ = std::fs::write("/proc/self/clear_refs", "5");
+}
+
+fn peak_rss_bytes() -> Option<u64> {
+    let status = std::fs::read_to_string("/proc/self/status").ok()?;
+    let line = status.lines().find(|l| l.starts_with("VmHWM:"))?;
+    let kb: u64 = line.split_whitespace().nth(1)?.parse().ok()?;
+    Some(kb * 1024)
+}
+
+fn cpu_seconds() -> f64 {
+    // SAFETY: getrusage writes into a zeroed, properly sized struct.
+    let mut usage: libc::rusage = unsafe { std::mem::zeroed() };
+    unsafe { libc::getrusage(libc::RUSAGE_SELF, &mut usage) };
+    let tv = |t: libc::timeval| t.tv_sec as f64 + t.tv_usec as f64 * 1e-6;
+    tv(usage.ru_utime) + tv(usage.ru_stime)
+}
+
+fn dir_bytes(path: &Path) -> u64 {
+    let Ok(entries) = std::fs::read_dir(path) else {
+        return 0;
+    };
+    entries
+        .flatten()
+        .map(|e| match e.metadata() {
+            Ok(m) if m.is_dir() => dir_bytes(&e.path()),
+            Ok(m) => m.len(),
+            Err(_) => 0,
+        })
+        .sum()
+}
+
+fn percentile(sorted: &[f64], p: f64) -> f64 {
+    if sorted.is_empty() {
+        return f64::NAN;
+    }
+    let rank = (p * (sorted.len() - 1) as f64).round() as usize;
+    sorted[rank.min(sorted.len() - 1)]
+}
