@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Run the same benchmark with and without LANCE_DISABLE_SVE_BUILD. This
+//! isolates kernel selection while retaining algorithms, inputs and profiles.
+
+use std::hint::black_box;
+
+use criterion::{BenchmarkId, Criterion, Throughput, criterion_group, criterion_main};
+use lance_linalg::distance::{Dot, L2, dot::dot_f32, dot_u8::dot_u8, l2::l2_f32, l2_u8::l2_u8};
+use lance_linalg::simd::dist_table::{sum_4bit_dist_table_f32_rows, sum_4bit_hacc_dist_table};
+
+fn distances(c: &mut Criterion) {
+    let mut group = c.benchmark_group("arm_distances");
+    for dim in [8, 16, 32, 128, 768, 960, 1536, 4097] {
+        let x: Vec<f32> = (0..dim).map(|i| (i % 101) as f32 / 101.0).collect();
+        let y: Vec<f32> = (0..dim).map(|i| (i % 79) as f32 / 79.0).collect();
+        let a: Vec<u8> = (0..dim).map(|i| (i * 17 % 256) as u8).collect();
+        let b: Vec<u8> = (0..dim).map(|i| (i * 31 % 256) as u8).collect();
+        group.throughput(Throughput::Elements(dim as u64));
+        group.bench_function(BenchmarkId::new("dot_f32", dim), |b| {
+            b.iter(|| black_box(dot_f32(black_box(&x), black_box(&y))))
+        });
+        group.bench_function(BenchmarkId::new("l2_f32", dim), |b| {
+            b.iter(|| black_box(l2_f32(black_box(&x), black_box(&y))))
+        });
+        group.bench_function(BenchmarkId::new("dot_u8", dim), |bencher| {
+            bencher.iter(|| black_box(dot_u8(black_box(&a), black_box(&b))))
+        });
+        group.bench_function(BenchmarkId::new("l2_u8", dim), |bencher| {
+            bencher.iter(|| black_box(l2_u8(black_box(&a), black_box(&b))))
+        });
+        let batch = y.repeat(64);
+        let mut out = vec![0.0; 64];
+        group.throughput(Throughput::Elements((64 * dim) as u64));
+        group.bench_function(BenchmarkId::new("dot_f32_batch", dim), |b| {
+            b.iter(|| {
+                f32::dot_batch_into(black_box(&x), black_box(&batch), dim, &mut out);
+                black_box(&out);
+            })
+        });
+        group.bench_function(BenchmarkId::new("l2_f32_batch", dim), |b| {
+            b.iter(|| {
+                f32::l2_batch_into(black_box(&x), black_box(&batch), dim, &mut out);
+                black_box(&out);
+            })
+        });
+    }
+    group.finish();
+}
+
+fn lookup(c: &mut Criterion) {
+    let mut group = c.benchmark_group("arm_lookup");
+    for (n, cols, selected) in [(32, 16, 7), (1024, 96, 129), (16384, 192, 1024)] {
+        let codes: Vec<u8> = (0..n * cols).map(|i| (i * 73 % 256) as u8).collect();
+        let tables: Vec<f32> = (0..32 * cols).map(|i| (i % 251) as f32 / 251.0).collect();
+        let hacc: Vec<u8> = (0..64 * cols).map(|i| (i * 41 % 256) as u8).collect();
+        let rows: Vec<u32> = (0..selected).map(|i| ((i * 257) % n) as u32).collect();
+        let mut out = vec![0.0; selected];
+        let mut hout = vec![0; n];
+        let label = format!("n{n}_cols{cols}_selected{selected}");
+        group.throughput(Throughput::Elements(selected as u64));
+        group.bench_function(BenchmarkId::new("f32_rows", &label), |b| {
+            b.iter(|| {
+                sum_4bit_dist_table_f32_rows(
+                    n,
+                    cols,
+                    black_box(&codes),
+                    black_box(&tables),
+                    &rows,
+                    &mut out,
+                );
+                black_box(&out);
+            })
+        });
+        group.throughput(Throughput::Elements(n as u64));
+        group.bench_function(BenchmarkId::new("hacc", &label), |b| {
+            b.iter(|| {
+                sum_4bit_hacc_dist_table(n, cols, black_box(&codes), black_box(&hacc), &mut hout);
+                black_box(&hout);
+            })
+        });
+    }
+    group.finish();
+}
+
+criterion_group!(benches, distances, lookup);
+criterion_main!(benches);
