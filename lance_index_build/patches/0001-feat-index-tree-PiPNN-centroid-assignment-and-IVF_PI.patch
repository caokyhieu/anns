diff --git a/rust/lance-index/src/vector/assignment_tree.rs b/rust/lance-index/src/vector/assignment_tree.rs
new file mode 100644
index 000000000..1a1451385
--- /dev/null
+++ b/rust/lance-index/src/vector/assignment_tree.rs
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Build-only routing tree retained from hierarchical k-means.
+
+use std::collections::BTreeMap;
+
+use lance_core::deepsize::DeepSizeOf;
+use lance_core::{Error, Result};
+use lance_linalg::distance::l2::l2;
+use rayon::prelude::*;
+
+/// A hierarchy over float32 L2 centroids. Leaves retain their original IVF IDs.
+///
+/// Internal centers are weighted means of descendant centroids. Their distances
+/// are routing heuristics, not lower bounds. A bounded beam is approximate.
+/// This state is intentionally not part of the persisted IVF format.
+#[derive(Debug, Clone, PartialEq, DeepSizeOf)]
+pub struct AssignmentTree {
+    dimension: usize,
+    centers: Vec<f32>,
+    children: Vec<Vec<usize>>,
+    partitions: Vec<Option<u32>>,
+    paths: Vec<Vec<usize>>,
+    weights: Vec<usize>,
+}
+
+#[derive(Default)]
+struct RoutingNode {
+    children: BTreeMap<usize, usize>,
+    partition: Option<u32>,
+    sum: Vec<f64>,
+    weight: f64,
+}
+
+#[derive(Default)]
+struct SearchScratch {
+    frontier: Vec<(f32, usize)>,
+    candidates: Vec<(f32, usize)>,
+}
+
+impl AssignmentTree {
+    pub(crate) fn from_paths(
+        centroids: &[f32],
+        dimension: usize,
+        paths: Vec<Vec<usize>>,
+        weights: Vec<usize>,
+    ) -> Result<Self> {
+        if dimension == 0
+            || paths.is_empty()
+            || paths.len() > u32::MAX as usize
+            || paths.len().checked_mul(dimension) != Some(centroids.len())
+            || weights.len() != paths.len()
+            || weights.contains(&0)
+            || centroids.iter().any(|v| !v.is_finite())
+        {
+            return Err(Error::invalid_input(
+                "assignment tree requires finite centroids, nonzero dimension and positive leaf weights",
+            ));
+        }
+        let mut nodes = vec![RoutingNode::default()];
+        for (partition, path) in paths.iter().enumerate() {
+            let mut node = 0;
+            let mut ancestors = vec![0];
+            for &label in path {
+                if nodes[node].partition.is_some() {
+                    return Err(Error::invalid_input(
+                        "assignment tree paths must be prefix-free",
+                    ));
+                }
+                node = if let Some(&child) = nodes[node].children.get(&label) {
+                    child
+                } else {
+                    let child = nodes.len();
+                    nodes.push(RoutingNode::default());
+                    nodes[node].children.insert(label, child);
+                    child
+                };
+                ancestors.push(node);
+            }
+            if nodes[node].partition.is_some() || !nodes[node].children.is_empty() {
+                return Err(Error::invalid_input(
+                    "assignment tree paths must be unique and prefix-free",
+                ));
+            }
+            nodes[node].partition = Some(partition as u32);
+            let center = &centroids[partition * dimension..(partition + 1) * dimension];
+            for node in ancestors {
+                nodes[node].sum.resize(dimension, 0.0);
+                nodes[node].weight += weights[partition] as f64;
+                for (sum, &value) in nodes[node].sum.iter_mut().zip(center) {
+                    *sum += value as f64 * weights[partition] as f64;
+                }
+            }
+        }
+        let mut centers = Vec::with_capacity(nodes.len() * dimension);
+        let mut children = Vec::with_capacity(nodes.len());
+        let mut partitions = Vec::with_capacity(nodes.len());
+        for node in nodes {
+            // Keep leaf coordinates bit-identical to the original centroid table.
+            if let Some(partition) = node.partition {
+                let start = partition as usize * dimension;
+                centers.extend_from_slice(&centroids[start..start + dimension]);
+            } else {
+                centers.extend(node.sum.iter().map(|sum| (sum / node.weight) as f32));
+            }
+            children.push(node.children.into_values().collect());
+            partitions.push(node.partition);
+        }
+        Ok(Self {
+            dimension,
+            centers,
+            children,
+            partitions,
+            paths,
+            weights,
+        })
+    }
+
+    /// Refresh internal centers after global refinement, retaining leaf IDs/topology.
+    pub fn with_centroids(&self, centroids: &[f32]) -> Result<Self> {
+        Self::from_paths(
+            centroids,
+            self.dimension,
+            self.paths.clone(),
+            self.weights.clone(),
+        )
+    }
+
+    /// Number of leaf centroids represented by this tree.
+    pub fn num_partitions(&self) -> usize {
+        self.paths.len()
+    }
+
+    /// Check that the tree belongs to this exact centroid generation.
+    pub fn matches_centroids(&self, centroids: &[f32], dimension: usize) -> bool {
+        dimension == self.dimension
+            && self.num_partitions().checked_mul(dimension) == Some(centroids.len())
+            && self.partitions.iter().enumerate().all(|(node, partition)| {
+                partition.is_none_or(|partition| {
+                    let start = partition as usize * dimension;
+                    self.centers[node * dimension..(node + 1) * dimension]
+                        == centroids[start..start + dimension]
+                })
+            })
+    }
+
+    /// Assign finite rows to centroids with a positive beam width.
+    ///
+    /// A beam of one is greedy. A beam at least as wide as the number of leaves
+    /// visits every leaf. Returned distances are squared L2 to the selected leaf,
+    /// with the lowest partition ID winning ties. Nonfinite rows are unassigned.
+    pub fn assign(&self, vectors: &[f32], beam: usize) -> Result<Vec<Option<(u32, f32)>>> {
+        if beam == 0 || !vectors.len().is_multiple_of(self.dimension) {
+            return Err(Error::invalid_input(format!(
+                "assignment tree requires beam > 0 and vector length divisible by {}; got beam={beam}, length={}",
+                self.dimension,
+                vectors.len()
+            )));
+        }
+        Ok(vectors
+            .par_chunks(self.dimension)
+            .map_init(SearchScratch::default, |scratch, query| {
+                self.search(query, beam, scratch)
+            })
+            .collect())
+    }
+
+    fn search(
+        &self,
+        query: &[f32],
+        beam: usize,
+        scratch: &mut SearchScratch,
+    ) -> Option<(u32, f32)> {
+        if query.iter().any(|x| !x.is_finite()) {
+            return None;
+        }
+        scratch.frontier.clear();
+        scratch.frontier.push((0.0, 0));
+        let mut best: Option<(u32, f32)> = None;
+        while !scratch.frontier.is_empty() {
+            scratch.candidates.clear();
+            for &(_, node) in &scratch.frontier {
+                if let Some(partition) = self.partitions[node] {
+                    let distance = l2(
+                        query,
+                        &self.centers[node * self.dimension..(node + 1) * self.dimension],
+                    );
+                    if !distance.is_nan()
+                        && best
+                            .is_none_or(|(id, d)| distance < d || (distance == d && partition < id))
+                    {
+                        best = Some((partition, distance));
+                    }
+                } else {
+                    for &child in &self.children[node] {
+                        let distance = l2(
+                            query,
+                            &self.centers[child * self.dimension..(child + 1) * self.dimension],
+                        );
+                        scratch.candidates.push((distance, child));
+                    }
+                }
+            }
+            let compare =
+                |a: &(f32, usize), b: &(f32, usize)| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1));
+            if scratch.candidates.len() > beam {
+                scratch.candidates.select_nth_unstable_by(beam, compare);
+                scratch.candidates.truncate(beam);
+            }
+            std::mem::swap(&mut scratch.frontier, &mut scratch.candidates);
+        }
+        best
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn exhaustive_irregular_tree_matches_exact_and_preserves_ids() {
+        let centers = [8.0, 9.0, -2.0, -1.0, 3.0, 4.0, 3.0, 4.0];
+        let tree = AssignmentTree::from_paths(
+            &centers,
+            2,
+            vec![vec![1, 2], vec![0], vec![1, 0, 0], vec![1, 0, 1]],
+            vec![1, 5, 2, 1],
+        )
+        .unwrap();
+        let queries = [8.5, 8.5, -1.0, 0.0, 3.0, 4.0, 0.0, 0.0];
+        let assignments = tree.assign(&queries, 4).unwrap();
+        for (query, assigned) in queries.chunks(2).zip(assignments) {
+            let expected = centers
+                .chunks(2)
+                .enumerate()
+                .map(|(id, c)| (id as u32, l2(query, c)))
+                .min_by(|a, b| a.1.total_cmp(&b.1).then(a.0.cmp(&b.0)))
+                .unwrap();
+            assert_eq!(assigned, Some(expected));
+        }
+        assert!(tree.matches_centroids(&centers, 2));
+        assert_eq!(tree.assign(&[f32::NAN, 0.0], 1).unwrap(), vec![None]);
+    }
+
+    #[test]
+    fn greedy_and_beam_are_distinct_and_refresh_uses_new_centroids() {
+        let tree = AssignmentTree::from_paths(
+            &[0.0, 100.0, 49.0, 51.0],
+            1,
+            vec![vec![0, 0], vec![0, 1], vec![1, 0], vec![1, 1]],
+            vec![1; 4],
+        )
+        .unwrap();
+        assert_eq!(tree.assign(&[49.0], 4).unwrap()[0], Some((2, 0.0)));
+        let fresh = tree.with_centroids(&[0.0, 100.0, 200.0, 201.0]).unwrap();
+        assert!(!fresh.matches_centroids(&[0.0, 100.0, 49.0, 51.0], 1));
+        assert_eq!(fresh.assign(&[200.0], 4).unwrap()[0], Some((2, 0.0)));
+        assert!(tree.assign(&[1.0], 0).is_err());
+    }
+
+    #[test]
+    fn invalid_topology_and_singleton() {
+        assert!(
+            AssignmentTree::from_paths(&[1.0, 2.0], 1, vec![vec![0], vec![0, 1]], vec![1, 1])
+                .is_err()
+        );
+        let tree = AssignmentTree::from_paths(&[2.0], 1, vec![vec![]], vec![1]).unwrap();
+        assert_eq!(tree.assign(&[3.0], 1).unwrap(), vec![Some((0, 1.0))]);
+    }
+}
diff --git a/rust/lance-index/src/vector/blocked_l2.rs b/rust/lance-index/src/vector/blocked_l2.rs
new file mode 100644
index 000000000..a33b3d51c
--- /dev/null
+++ b/rust/lance-index/src/vector/blocked_l2.rs
@@ -0,0 +1,386 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Register- and cache-blocked exact nearest-centroid search for f32 L2.
+//!
+//! The per-vector path scores one vector against every centroid, so for a
+//! centroid table larger than L2 (1000 x 960 f32 is 3.8 MB) each vector
+//! re-streams the whole table from L3 or DRAM and the kernel is bandwidth
+//! bound. This path scores a block of rows against an L2-resident tile of
+//! centroids with a 4x4 register tile, so every loaded centroid lane feeds
+//! four FMAs and every loaded row lane feeds four.
+//!
+//! Distances use `|x|^2 + |c|^2 - 2 x.c` to pick the winner. The returned
+//! distance is then recomputed exactly against the winning centroid, because
+//! callers use it as `|x - c|^2` (RaBitQ's L2 add factor, cluster radius and
+//! loss), and the expansion loses precision when `|x|` is large relative to
+//! the residual.
+//!
+//! Selection matches `argmin_value_float_with_bias`: the first centroid with
+//! the strictly smallest `dist + bias` wins, and a row whose distances are all
+//! NaN gets `None`. Near-ties can resolve differently from the per-vector
+//! kernel because the dot products are summed in a different order.
+
+use std::sync::LazyLock;
+
+use lance_linalg::distance::L2;
+use rayon::prelude::*;
+
+const MR: usize = 4;
+const NR: usize = 4;
+const ROW_BLOCK: usize = 64;
+/// Target bytes for one centroid tile; sized to stay resident in L2 next to a
+/// row block of similar size.
+const TILE_BYTES: usize = 256 * 1024;
+/// Below these sizes the per-vector kernel is already cache resident.
+pub(crate) const MIN_DIMENSION: usize = 32;
+pub(crate) const MIN_CENTROIDS: usize = 8;
+
+#[derive(Clone, Copy)]
+enum Kernel {
+    #[cfg(target_arch = "x86_64")]
+    Avx512,
+    #[cfg(target_arch = "x86_64")]
+    Avx2,
+}
+
+static KERNEL: LazyLock<Option<Kernel>> = LazyLock::new(|| {
+    if std::env::var_os("LANCE_DISABLE_BLOCKED_L2").is_some() {
+        return None;
+    }
+    #[cfg(target_arch = "x86_64")]
+    {
+        if std::arch::is_x86_feature_detected!("avx512f") {
+            return Some(Kernel::Avx512);
+        }
+        if std::arch::is_x86_feature_detected!("avx2") && std::arch::is_x86_feature_detected!("fma")
+        {
+            return Some(Kernel::Avx2);
+        }
+    }
+    None
+});
+
+/// Whether the blocked path will be used for this shape.
+pub(crate) fn applies(num_centroids: usize, dimension: usize) -> bool {
+    KERNEL.is_some() && dimension >= MIN_DIMENSION && num_centroids >= MIN_CENTROIDS
+}
+
+/// Exact nearest centroid (with optional additive per-centroid bias) for each
+/// row of `data`. Returns `None` when no SIMD kernel is available.
+pub(crate) fn l2_argmin(
+    centroids: &[f32],
+    data: &[f32],
+    dimension: usize,
+    biases: Option<&[f32]>,
+) -> Option<Vec<Option<(u32, f32)>>> {
+    let kernel = (*KERNEL)?;
+    let k = centroids.len() / dimension;
+    debug_assert_eq!(centroids.len(), k * dimension);
+    debug_assert_eq!(data.len() % dimension, 0);
+
+    // Pad the centroid table to a multiple of NR; padding columns are never
+    // read back as candidates.
+    let k_pad = k.div_ceil(NR) * NR;
+    let mut padded = centroids.to_vec();
+    padded.resize(k_pad * dimension, 0.0);
+    let c_norms: Vec<f32> = centroids
+        .chunks_exact(dimension)
+        .map(|c| c.iter().map(|v| v * v).sum())
+        .collect();
+    let tile = ((TILE_BYTES / (dimension * 4)) / NR * NR).max(NR);
+
+    let results = data
+        .par_chunks(ROW_BLOCK * dimension)
+        .map_init(
+            || vec![0.0f32; ROW_BLOCK.div_ceil(MR) * MR * dimension],
+            |xbuf, rows| {
+                let n = rows.len() / dimension;
+                let n_pad = n.div_ceil(MR) * MR;
+                xbuf[..rows.len()].copy_from_slice(rows);
+                xbuf[rows.len()..n_pad * dimension].fill(0.0);
+                let x_norms: Vec<f32> = rows
+                    .chunks_exact(dimension)
+                    .map(|x| x.iter().map(|v| v * v).sum())
+                    .collect();
+                let mut best_score = vec![f32::INFINITY; n];
+                let mut best_idx: Vec<Option<u32>> = vec![None; n];
+                let mut out = [0.0f32; MR * NR];
+                for tile_start in (0..k_pad).step_by(tile) {
+                    let tile_end = (tile_start + tile).min(k_pad);
+                    for r in (0..n_pad).step_by(MR) {
+                        for j in (tile_start..tile_end).step_by(NR) {
+                            // SAFETY: rows r..r+MR and centroids j..j+NR are in
+                            // bounds of the padded buffers, and the kernel was
+                            // chosen by runtime feature detection.
+                            unsafe {
+                                let x = xbuf.as_ptr().add(r * dimension);
+                                let c = padded.as_ptr().add(j * dimension);
+                                match kernel {
+                                    #[cfg(target_arch = "x86_64")]
+                                    Kernel::Avx512 => x86::tile_avx512(x, c, dimension, &mut out),
+                                    #[cfg(target_arch = "x86_64")]
+                                    Kernel::Avx2 => x86::tile_avx2(x, c, dimension, &mut out),
+                                }
+                            }
+                            for a in 0..MR {
+                                let row = r + a;
+                                if row >= n {
+                                    break;
+                                }
+                                for b in 0..NR {
+                                    let cj = j + b;
+                                    if cj >= k {
+                                        break;
+                                    }
+                                    let mut dist =
+                                        x_norms[row] + c_norms[cj] - 2.0 * out[a * NR + b];
+                                    // Keep NaN (f32::max would drop it).
+                                    if dist < 0.0 {
+                                        dist = 0.0;
+                                    }
+                                    let score = match biases {
+                                        Some(bias) => dist + bias[cj],
+                                        None => dist,
+                                    };
+                                    if score < best_score[row] {
+                                        best_score[row] = score;
+                                        best_idx[row] = Some(cj as u32);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                best_idx
+                    .into_iter()
+                    .zip(rows.chunks_exact(dimension))
+                    .map(|(idx, x)| {
+                        idx.map(|idx| {
+                            let c = &centroids[idx as usize * dimension..][..dimension];
+                            (idx, f32::l2(x, c))
+                        })
+                    })
+                    .collect::<Vec<_>>()
+            },
+        )
+        .flatten_iter()
+        .collect();
+    Some(results)
+}
+
+#[cfg(target_arch = "x86_64")]
+mod x86 {
+    use std::arch::x86_64::*;
+
+    use super::{MR, NR};
+
+    /// `out[a * NR + b] = dot(x[a], c[b])` for a 4x4 tile.
+    #[target_feature(enable = "avx512f")]
+    pub(super) unsafe fn tile_avx512(
+        x: *const f32,
+        c: *const f32,
+        dim: usize,
+        out: &mut [f32; MR * NR],
+    ) {
+        unsafe {
+            let (x0, x1, x2, x3) = (x, x.add(dim), x.add(2 * dim), x.add(3 * dim));
+            let (c0, c1, c2, c3) = (c, c.add(dim), c.add(2 * dim), c.add(3 * dim));
+            let mut a00 = _mm512_setzero_ps();
+            let mut a01 = _mm512_setzero_ps();
+            let mut a02 = _mm512_setzero_ps();
+            let mut a03 = _mm512_setzero_ps();
+            let mut a10 = _mm512_setzero_ps();
+            let mut a11 = _mm512_setzero_ps();
+            let mut a12 = _mm512_setzero_ps();
+            let mut a13 = _mm512_setzero_ps();
+            let mut a20 = _mm512_setzero_ps();
+            let mut a21 = _mm512_setzero_ps();
+            let mut a22 = _mm512_setzero_ps();
+            let mut a23 = _mm512_setzero_ps();
+            let mut a30 = _mm512_setzero_ps();
+            let mut a31 = _mm512_setzero_ps();
+            let mut a32 = _mm512_setzero_ps();
+            let mut a33 = _mm512_setzero_ps();
+            let full = dim / 16 * 16;
+            let mut d = 0;
+            while d < full {
+                let v0 = _mm512_loadu_ps(x0.add(d));
+                let v1 = _mm512_loadu_ps(x1.add(d));
+                let v2 = _mm512_loadu_ps(x2.add(d));
+                let v3 = _mm512_loadu_ps(x3.add(d));
+                let w = _mm512_loadu_ps(c0.add(d));
+                a00 = _mm512_fmadd_ps(v0, w, a00);
+                a10 = _mm512_fmadd_ps(v1, w, a10);
+                a20 = _mm512_fmadd_ps(v2, w, a20);
+                a30 = _mm512_fmadd_ps(v3, w, a30);
+                let w = _mm512_loadu_ps(c1.add(d));
+                a01 = _mm512_fmadd_ps(v0, w, a01);
+                a11 = _mm512_fmadd_ps(v1, w, a11);
+                a21 = _mm512_fmadd_ps(v2, w, a21);
+                a31 = _mm512_fmadd_ps(v3, w, a31);
+                let w = _mm512_loadu_ps(c2.add(d));
+                a02 = _mm512_fmadd_ps(v0, w, a02);
+                a12 = _mm512_fmadd_ps(v1, w, a12);
+                a22 = _mm512_fmadd_ps(v2, w, a22);
+                a32 = _mm512_fmadd_ps(v3, w, a32);
+                let w = _mm512_loadu_ps(c3.add(d));
+                a03 = _mm512_fmadd_ps(v0, w, a03);
+                a13 = _mm512_fmadd_ps(v1, w, a13);
+                a23 = _mm512_fmadd_ps(v2, w, a23);
+                a33 = _mm512_fmadd_ps(v3, w, a33);
+                d += 16;
+            }
+            let acc = [
+                a00, a01, a02, a03, a10, a11, a12, a13, a20, a21, a22, a23, a30, a31, a32, a33,
+            ];
+            for (o, a) in out.iter_mut().zip(acc) {
+                *o = _mm512_reduce_add_ps(a);
+            }
+            tail(x, c, dim, full, out);
+        }
+    }
+
+    #[inline]
+    #[target_feature(enable = "avx2,fma")]
+    unsafe fn hsum256(v: __m256) -> f32 {
+        let lo = _mm256_castps256_ps128(v);
+        let hi = _mm256_extractf128_ps(v, 1);
+        let s = _mm_add_ps(lo, hi);
+        let s = _mm_add_ps(s, _mm_movehl_ps(s, s));
+        let s = _mm_add_ss(s, _mm_shuffle_ps(s, s, 0x55));
+        _mm_cvtss_f32(s)
+    }
+
+    /// Same contract as [`tile_avx512`]; computed as two 2x4 halves so the
+    /// accumulators fit in the 16 ymm registers.
+    #[target_feature(enable = "avx2,fma")]
+    pub(super) unsafe fn tile_avx2(
+        x: *const f32,
+        c: *const f32,
+        dim: usize,
+        out: &mut [f32; MR * NR],
+    ) {
+        unsafe {
+            let (c0, c1, c2, c3) = (c, c.add(dim), c.add(2 * dim), c.add(3 * dim));
+            let full = dim / 8 * 8;
+            for half in 0..2 {
+                let x0 = x.add(2 * half * dim);
+                let x1 = x0.add(dim);
+                let mut a00 = _mm256_setzero_ps();
+                let mut a01 = _mm256_setzero_ps();
+                let mut a02 = _mm256_setzero_ps();
+                let mut a03 = _mm256_setzero_ps();
+                let mut a10 = _mm256_setzero_ps();
+                let mut a11 = _mm256_setzero_ps();
+                let mut a12 = _mm256_setzero_ps();
+                let mut a13 = _mm256_setzero_ps();
+                let mut d = 0;
+                while d < full {
+                    let v0 = _mm256_loadu_ps(x0.add(d));
+                    let v1 = _mm256_loadu_ps(x1.add(d));
+                    let w = _mm256_loadu_ps(c0.add(d));
+                    a00 = _mm256_fmadd_ps(v0, w, a00);
+                    a10 = _mm256_fmadd_ps(v1, w, a10);
+                    let w = _mm256_loadu_ps(c1.add(d));
+                    a01 = _mm256_fmadd_ps(v0, w, a01);
+                    a11 = _mm256_fmadd_ps(v1, w, a11);
+                    let w = _mm256_loadu_ps(c2.add(d));
+                    a02 = _mm256_fmadd_ps(v0, w, a02);
+                    a12 = _mm256_fmadd_ps(v1, w, a12);
+                    let w = _mm256_loadu_ps(c3.add(d));
+                    a03 = _mm256_fmadd_ps(v0, w, a03);
+                    a13 = _mm256_fmadd_ps(v1, w, a13);
+                    d += 8;
+                }
+                let base = 2 * half * NR;
+                let acc = [a00, a01, a02, a03, a10, a11, a12, a13];
+                for (i, a) in acc.into_iter().enumerate() {
+                    out[base + i] = hsum256(a);
+                }
+            }
+            tail(x, c, dim, full, out);
+        }
+    }
+
+    #[inline(always)]
+    unsafe fn tail(
+        x: *const f32,
+        c: *const f32,
+        dim: usize,
+        from: usize,
+        out: &mut [f32; MR * NR],
+    ) {
+        unsafe {
+            for d in from..dim {
+                for a in 0..MR {
+                    let xv = *x.add(a * dim + d);
+                    for b in 0..NR {
+                        out[a * NR + b] += xv * *c.add(b * dim + d);
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rand::{Rng, SeedableRng, rngs::SmallRng};
+
+    fn reference(c: &[f32], x: &[f32], dim: usize, bias: Option<&[f32]>) -> Vec<Option<u32>> {
+        x.chunks_exact(dim)
+            .map(|x| {
+                let mut best = (f32::INFINITY, None);
+                for (j, c) in c.chunks_exact(dim).enumerate() {
+                    let s = f32::l2(x, c) + bias.map_or(0.0, |b| b[j]);
+                    if s < best.0 {
+                        best = (s, Some(j as u32));
+                    }
+                }
+                best.1
+            })
+            .collect()
+    }
+
+    #[test]
+    fn matches_per_vector_assignment() {
+        let mut rng = SmallRng::seed_from_u64(7);
+        for &(n, k, dim) in &[(1, 8, 32), (67, 13, 33), (300, 64, 128), (130, 101, 960)] {
+            let x: Vec<f32> = (0..n * dim).map(|_| rng.random::<f32>()).collect();
+            let c: Vec<f32> = (0..k * dim).map(|_| rng.random::<f32>()).collect();
+            let bias: Vec<f32> = (0..k).map(|_| rng.random::<f32>() * 0.01).collect();
+            for b in [None, Some(bias.as_slice())] {
+                let Some(got) = l2_argmin(&c, &x, dim, b) else {
+                    return;
+                };
+                let want = reference(&c, &x, dim, b);
+                let agree = got
+                    .iter()
+                    .zip(&want)
+                    .filter(|(g, w)| g.map(|g| g.0) == **w)
+                    .count();
+                // Random uniform data has no near-ties at this scale.
+                assert_eq!(agree, n, "n={n} k={k} dim={dim}");
+                for (g, xv) in got.iter().zip(x.chunks_exact(dim)) {
+                    let (idx, dist) = g.unwrap();
+                    let exact = f32::l2(xv, &c[idx as usize * dim..][..dim]);
+                    assert_eq!(dist, exact);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn nan_row_is_unassigned() {
+        let dim = 32;
+        let mut x = vec![0.5f32; 2 * dim];
+        x[3] = f32::NAN;
+        let c = vec![0.1f32; 8 * dim];
+        if let Some(got) = l2_argmin(&c, &x, dim, None) {
+            assert!(got[0].is_none());
+            assert!(got[1].is_some());
+        }
+    }
+}
