     }
 }
 
+/// Benchmark control: `LANCE_L2_BATCH_AVX512=1` runs the per-vector f32 L2
+/// batch on 512-bit registers (`l2_f32_avx512` per row) when the host allows
+/// AVX-512 (see `LANCE_SIMD_MAX_WIDTH`). Default dispatch has no AVX-512 batch
+/// candidate, so without this a per-vector vs. blocked comparison on an
+/// AVX-512 host would compare 256-bit against 512-bit kernels.
+#[cfg(target_arch = "x86_64")]
+static L2_F32_BATCH_AVX512_OPT_IN: std::sync::LazyLock<
+    Option<lance_core::utils::cpu::Kernel<BatchKernel>>,
+> = std::sync::LazyLock::new(|| {
+    std::env::var_os("LANCE_L2_BATCH_AVX512")
+        .and_then(|_| x86::L2_F32_BATCH_AVX512.kernel())
+});
+
+/// Name of the f32 L2 batch kernel `l2_distance_batch` uses on this host, for
+/// benchmark records.
+pub fn l2_f32_batch_kernel_name() -> &'static str {
+    #[cfg(target_arch = "x86_64")]
+    if L2_F32_BATCH_AVX512_OPT_IN.is_some() {
+        return x86::L2_F32_BATCH_AVX512.name();
+    }
+    L2_F32_BATCH.selected().name()
+}
+
+/// Name of the f32 pairwise L2 kernel on this host, for benchmark records.
+pub fn l2_f32_kernel_name() -> &'static str {
+    L2_F32.selected().name()
+}
+
 lance_core::dispatch! {
     static L2_F32: Dispatch<PairKernel> = {
         #[cfg(target_arch = "x86_64")]
@@ -791,6 +823,28 @@ mod x86 {
         (acc_sum + tail) as f32
     }
 
+    lance_core::target_kernel! {
+        #[target_features("avx512f")]
+        #[candidate(pub(super) L2_F32_BATCH_AVX512: BatchKernel)]
+        /// Opt-in (`LANCE_L2_BATCH_AVX512=1`) per-vector batch at 512 bits: the
+        /// same subtract + FMA per element as the default batch, one row at a
+        /// time, on `__m512`. Dimensions up to 16 keep the AVX+FMA kernel.
+        pub(super) fn l2_batch_f32_avx512(
+            x: &[f32],
+            batch: &[f32],
+            dimension: usize,
+            output: &mut [f32],
+        ) {
+            if dimension <= 16 {
+                l2_batch_f32_avx_fma(x, batch, dimension, output);
+                return;
+            }
+            for (distance, y) in output.iter_mut().zip(batch.chunks_exact(dimension)) {
+                *distance = l2_f32_avx512(x, y);
+            }
+        }
+    }
+
     lance_core::target_kernel! {
         #[target_features("avx512f")]
         #[candidate(pub(super) L2_F32_AVX512: PairKernel)]
@@ -1129,6 +1183,36 @@ pub fn l2_distance_arrow_batch(
 
 #[cfg(test)]
 mod tests {
+    /// The opt-in AVX-512 batch must equal the AVX-512 pair kernel row by row
+    /// above 16 dimensions, and the AVX+FMA batch at or below 16.
+    #[cfg(target_arch = "x86_64")]
+    #[rstest::rstest]
+    fn avx512_batch_matches_reference(#[values(8, 16, 17, 128, 960, 1001)] dimension: usize) {
+        let (Some(batch512), Some(pair512), Some(batch256)) = (
+            x86::L2_F32_BATCH_AVX512.kernel(),
+            x86::L2_F32_AVX512.kernel(),
+            x86::L2_F32_BATCH_AVX_FMA.kernel(),
+        ) else {
+            return;
+        };
+        let n = 37;
+        let x: Vec<f32> = (0..dimension).map(|i| (i as f32 * 0.37).sin()).collect();
+        let batch: Vec<f32> = (0..dimension * n).map(|i| (i as f32 * 0.73).cos() * 2.0).collect();
+        let mut got = vec![f32::NAN; n];
+        batch512.call(&x, &batch, dimension, &mut got);
+        let mut want = vec![f32::NAN; n];
+        if dimension <= 16 {
+            batch256.call(&x, &batch, dimension, &mut want);
+        } else {
+            for (w, y) in want.iter_mut().zip(batch.chunks_exact(dimension)) {
+                *w = pair512.call(&x, y);
+            }
+        }
+        for (g, w) in got.iter().zip(&want) {
+            assert_eq!(g.to_bits(), w.to_bits(), "dim {dimension}: {g} != {w}");
+        }
+    }
+
     #[cfg(all(target_arch = "aarch64", kernel_support = "sve"))]
     #[test]
     fn sve_candidate_is_selected_when_supported() {
