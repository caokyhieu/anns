diff --git a/rust/lance-core/src/utils/cpu.rs b/rust/lance-core/src/utils/cpu.rs
index ef29a6cae..f665401fa 100644
--- a/rust/lance-core/src/utils/cpu.rs
+++ b/rust/lance-core/src/utils/cpu.rs
@@ -312,7 +312,58 @@ const BASELINE: CpuFeatures = {
 // assumes. `Dispatch` relies on the host set containing the baseline, so add
 // it explicitly.
 static HOST_FEATURES: LazyLock<CpuFeatures> =
-    LazyLock::new(|| detect_host_features().union(BASELINE));
+    LazyLock::new(|| cap_vector_width(detect_host_features()).union(BASELINE));
+
+/// Every AVX-512 feature bit, which `LANCE_SIMD_MAX_WIDTH=256` hides.
+const AVX512_ALL: CpuFeatures = CpuFeatures(
+    CpuFeatures::AVX512F.0
+        | CpuFeatures::AVX512BW.0
+        | CpuFeatures::AVX512CD.0
+        | CpuFeatures::AVX512DQ.0
+        | CpuFeatures::AVX512VL.0
+        | CpuFeatures::AVX512FP16.0
+        | CpuFeatures::AVX512VNNI.0
+        | CpuFeatures::AVX512VPOPCNTDQ.0
+        | CpuFeatures::AVX512VBMI.0
+        | CpuFeatures::AVX512BF16.0,
+);
+
+/// Benchmark control: `LANCE_SIMD_MAX_WIDTH=256` removes AVX-512 from the
+/// host set, so every [`Dispatch`] picks its best kernel of at most 256 bits.
+/// Kernel comparisons can then hold vector width fixed. Code that calls
+/// `is_x86_feature_detected!` itself is not affected. Any other value, or no
+/// value, leaves detection unchanged.
+fn cap_vector_width(features: CpuFeatures) -> CpuFeatures {
+    cap_vector_width_to(features, std::env::var("LANCE_SIMD_MAX_WIDTH").ok().as_deref())
+}
+
+fn cap_vector_width_to(features: CpuFeatures, max_width: Option<&str>) -> CpuFeatures {
+    match max_width {
+        Some("256") => CpuFeatures(features.0 & !AVX512_ALL.0),
+        _ => features,
+    }
+}
+
+#[cfg(test)]
+mod width_cap_tests {
+    use super::*;
+
+    #[test]
+    fn cap_256_removes_only_avx512() {
+        let all = CpuFeatures::AVX2
+            .union(CpuFeatures::FMA)
+            .union(CpuFeatures::AVX512F)
+            .union(CpuFeatures::AVX512BF16)
+            .union(CpuFeatures::AVX512VL);
+        let capped = cap_vector_width_to(all, Some("256"));
+        assert!(capped.contains(CpuFeatures::AVX2.union(CpuFeatures::FMA)));
+        assert!(!capped.contains(CpuFeatures::AVX512F));
+        assert!(!capped.contains(CpuFeatures::AVX512BF16));
+        assert!(!capped.contains(CpuFeatures::AVX512VL));
+        assert_eq!(cap_vector_width_to(all, None).0, all.0);
+        assert_eq!(cap_vector_width_to(all, Some("512")).0, all.0);
+    }
+}
 
 #[cfg(target_arch = "x86_64")]
 fn detect_host_features() -> CpuFeatures {
diff --git a/rust/lance-index-bench/src/bin/assign_micro.rs b/rust/lance-index-bench/src/bin/assign_micro.rs
new file mode 100644
index 000000000..7dfe8c960
--- /dev/null
+++ b/rust/lance-index-bench/src/bin/assign_micro.rs
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Exact nearest-centroid microbenchmark through Lance's public assignment entry
+//! point (`compute_partitions_arrow_array`, the code IVF builds use), so kernel
+//! selection follows the same environment switches as a full build:
+//!
+//! * `LANCE_DISABLE_BLOCKED_L2=1`  per-vector (pairwise) instead of blocked 4x4 tiles
+//! * `LANCE_SIMD_MAX_WIDTH=256`    hide AVX-512 from runtime dispatch
+//! * `LANCE_L2_BATCH_AVX512=1`     per-vector batch on 512-bit registers
+//!
+//! Each process measures one kernel arm; run arms as separate processes because
+//! dispatch is decided once per process.
+//!
+//! Usage: assign_micro <bigann|gist> <data_dir> <rows> <k1,k2,..> <reps> <out_prefix>
+//! Rows are the first `rows` base vectors; centroids are `k` base vectors taken
+//! at a fixed stride from the second half of the file, identical for every arm.
+//! Prints one JSON line per k and writes the assignments to `<out_prefix>-k<k>.u32`.
+
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::path::Path;
+use std::sync::Arc;
+use std::time::Instant;
+
+use arrow_array::{FixedSizeListArray, Float32Array};
+use arrow_schema::{DataType, Field};
+use lance_linalg::distance::DistanceType;
+use serde_json::json;
+
+fn read_rows(kind: &str, dir: &Path, start: usize, count: usize) -> (Vec<f32>, usize, usize) {
+    match kind {
+        "bigann" => {
+            let mut f = File::open(dir.join("base.10M.u8bin")).unwrap();
+            let mut h = [0u8; 8];
+            f.read_exact(&mut h).unwrap();
+            let total = u32::from_le_bytes(h[0..4].try_into().unwrap()) as usize;
+            let dim = u32::from_le_bytes(h[4..8].try_into().unwrap()) as usize;
+            f.seek(SeekFrom::Start(8 + (start * dim) as u64)).unwrap();
+            let mut raw = vec![0u8; count * dim];
+            f.read_exact(&mut raw).unwrap();
+            (raw.into_iter().map(f32::from).collect(), dim, total)
+        }
+        "gist" => {
+            let meta = std::fs::read_to_string(dir.join("meta.txt")).unwrap();
+            let mut it = meta.split_whitespace().map(|v| v.parse::<usize>().unwrap());
+            let (total, dim) = (it.next().unwrap(), it.next().unwrap());
+            let mut f = File::open(dir.join("base.f32")).unwrap();
+            f.seek(SeekFrom::Start((start * dim * 4) as u64)).unwrap();
+            let mut raw = vec![0u8; count * dim * 4];
+            f.read_exact(&mut raw).unwrap();
+            let v = raw
+                .chunks_exact(4)
+                .map(|b| f32::from_le_bytes(b.try_into().unwrap()))
+                .collect();
+            (v, dim, total)
+        }
+        _ => panic!("dataset must be bigann or gist"),
+    }
+}
+
+fn fsl(values: Vec<f32>, dim: usize) -> FixedSizeListArray {
+    FixedSizeListArray::try_new(
+        Arc::new(Field::new("item", DataType::Float32, true)),
+        dim as i32,
+        Arc::new(Float32Array::from(values)),
+        None,
+    )
+    .unwrap()
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    assert!(a.len() == 7, "usage: assign_micro <bigann|gist> <data_dir> <rows> <k,..> <reps> <out_prefix>");
+    let (kind, dir) = (a[1].as_str(), Path::new(&a[2]));
+    let rows: usize = a[3].parse().unwrap();
+    let ks: Vec<usize> = a[4].split(',').map(|k| k.parse().unwrap()).collect();
+    let reps: usize = a[5].parse().unwrap();
+    let out_prefix = &a[6];
+
+    let (data, dim, total) = read_rows(kind, dir, 0, rows);
+    let vectors = fsl(data, dim);
+    let threads = rayon::current_num_threads();
+    for &k in &ks {
+        // k centroids at a fixed stride from the second half of the file.
+        let half = total / 2;
+        let stride = (total - half) / k;
+        let mut cent = Vec::with_capacity(k * dim);
+        for j in 0..k {
+            cent.extend(read_rows(kind, dir, half + j * stride, 1).0);
+        }
+        let centroids = fsl(cent, dim);
+        // One warm-up, then `reps` timed calls.
+        let (parts, _) =
+            lance_index::vector::kmeans::compute_partitions_arrow_array(&centroids, &vectors, DistanceType::L2).unwrap();
+        let mut times = Vec::with_capacity(reps);
+        for _ in 0..reps {
+            let t = Instant::now();
+            let r = lance_index::vector::kmeans::compute_partitions_arrow_array(&centroids, &vectors, DistanceType::L2)
+                .unwrap();
+            times.push(t.elapsed().as_secs_f64());
+            std::hint::black_box(r);
+        }
+        let mut sorted = times.clone();
+        sorted.sort_by(f64::total_cmp);
+        let median = sorted[reps / 2];
+        let mut f = File::create(format!("{out_prefix}-k{k}.u32")).unwrap();
+        let ids: Vec<u8> = parts.iter().flat_map(|p| p.unwrap_or(u32::MAX).to_le_bytes()).collect();
+        f.write_all(&ids).unwrap();
+        let pairs = (rows * k) as f64;
+        println!(
+            "{}",
+            json!({
+                "dataset": kind, "dim": dim, "rows": rows, "k": k, "threads": threads,
+                "table_bytes": k * dim * 4,
+                "times_s": times, "median_s": median,
+                "ns_per_distance": median * 1e9 / pairs,
+                "gflops_2kd": 2.0 * pairs * dim as f64 / median / 1e9,
+                "kernels": {
+                    "blocked_l2": lance_index::vector::blocked_l2_kernel_name(),
+                    "dot_tile": lance_linalg::distance::tile::dot_tile_kernel_name(),
+                    "l2_f32_batch": lance_linalg::distance::l2::l2_f32_batch_kernel_name(),
+                    "l2_f32_pair": lance_linalg::distance::l2::l2_f32_kernel_name(),
+                },
+                "env": {
+                    "LANCE_DISABLE_BLOCKED_L2": std::env::var("LANCE_DISABLE_BLOCKED_L2").ok(),
+                    "LANCE_SIMD_MAX_WIDTH": std::env::var("LANCE_SIMD_MAX_WIDTH").ok(),
+                    "LANCE_L2_BATCH_AVX512": std::env::var("LANCE_L2_BATCH_AVX512").ok(),
+                },
+            })
+        );
+    }
+}
