+    /// Allows rows whose id is a multiple of `step`.
+    struct EveryNth {
+        step: u64,
+    }
+
+    #[async_trait::async_trait]
+    impl PreFilter for EveryNth {
+        async fn wait_for_ready(&self) -> Result<()> {
+            Ok(())
+        }
+
+        fn is_empty(&self) -> bool {
+            false
+        }
+
+        fn mask(&self) -> Arc<lance_select::RowAddrMask> {
+            Arc::new(lance_select::RowAddrMask::all_rows())
+        }
+
+        fn filter_row_ids<'a>(&self, row_ids: Box<dyn Iterator<Item = &'a u64> + 'a>) -> Vec<u64> {
+            row_ids
+                .enumerate()
+                .filter(|(_, id)| **id % self.step == 0)
+                .map(|(i, _)| i as u64)
+                .collect()
+        }
+    }
+
+    /// Below 10 % selectivity the graph walk is replaced by an exact scan of the
+    /// allowed rows, so results must equal brute force over those rows.
+    #[test]
+    fn selective_filter_is_exact() {
+        let store = storage(2000, 13);
+        let points = flat_values(&store);
+        let graph = PiPNN::index_vectors(&store, params()).unwrap();
+        let k = 5;
+        let queries = generate_random_array_with_seed::<Float32Type>(10 * DIM, [5; 32]);
+        for q in queries.values().chunks(DIM) {
+            let query: ArrayRef = Arc::new(Float32Array::from(q.to_vec()));
+            let params = HnswQueryParams {
+                ef: 32,
+                lower_bound: None,
+                upper_bound: None,
+                dist_q_c: 0.0,
+                use_acorn: false,
+            };
+            let batch = graph
+                .search(
+                    query,
+                    k,
+                    params,
+                    &store,
+                    Arc::new(EveryNth { step: 50 }),
+                    &NoOpMetricsCollector,
+                )
+                .unwrap();
+            let ids = batch[lance_core::ROW_ID]
+                .as_primitive::<arrow_array::types::UInt64Type>()
+                .values()
+                .to_vec();
+            let mut exact: Vec<(f32, u64)> = points
+                .chunks(DIM)
+                .enumerate()
+                .filter(|(i, _)| i % 50 == 0)
+                .map(|(i, p)| (l2(q, p), i as u64))
+                .collect();
+            exact.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+            let truth: Vec<u64> = exact[..k].iter().map(|(_, i)| *i).collect();
+            assert_eq!(ids, truth);
+        }
+    }
