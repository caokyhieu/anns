diff --git a/rust/lance-index/src/vector/bq/builder.rs b/rust/lance-index/src/vector/bq/builder.rs
index f33c372d0..0578654ff 100644
--- a/rust/lance-index/src/vector/bq/builder.rs
+++ b/rust/lance-index/src/vector/bq/builder.rs
@@ -319,8 +319,27 @@ static CONST_EX_SCALES: LazyLock<Mutex<HashMap<(usize, u8), f32>>> =
 
 const CONST_EX_SCALE_SAMPLES: usize = 100;
 
+thread_local! {
+    /// Last `(dim, ex_bits)` factor seen by this thread. Every row of a build shares
+    /// one key, so the per-row lookup stays off the process-wide mutex.
+    static LAST_CONST_EX_SCALE: std::cell::Cell<Option<((usize, u8), f32)>> =
+        const { std::cell::Cell::new(None) };
+}
+
 /// Mean optimal rescale factor over Gaussian rows of dimension `dim`.
 fn const_ex_rescale_factor(dim: usize, ex_bits: u8) -> f32 {
+    let key = (dim, ex_bits);
+    if let Some((cached, t)) = LAST_CONST_EX_SCALE.get()
+        && cached == key
+    {
+        return t;
+    }
+    let t = shared_const_ex_rescale_factor(dim, ex_bits);
+    LAST_CONST_EX_SCALE.set(Some((key, t)));
+    t
+}
+
+fn shared_const_ex_rescale_factor(dim: usize, ex_bits: u8) -> f32 {
     if let Some(t) = CONST_EX_SCALES.lock().unwrap().get(&(dim, ex_bits)) {
         return *t;
     }
