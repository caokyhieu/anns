+#[cfg(pipnn_stub)]
+#[allow(clippy::too_many_arguments)]
+mod stub {
+    use std::ffi::c_char;
+
+    use super::BuildParams;
+
+    const MISSING: &[u8] =
+        b"lance-pipnn was built without Eigen headers; set EIGEN_INCLUDE_DIR and rebuild\0";
+
+    pub unsafe fn lance_pipnn_build(
+        _points: *const f32,
+        _n: usize,
+        _dim: usize,
+        _params: *const BuildParams,
+        _adjacency: *mut u32,
+        _degrees: *mut u16,
+        _entry: *mut u32,
+        _times: *mut f64,
+        error: *mut c_char,
+        error_capacity: usize,
+    ) -> i32 {
+        let len = MISSING.len().min(error_capacity);
+        if len > 0 {
+            // SAFETY: the caller passes a writable buffer of `error_capacity` bytes;
+            // the last copied byte is forced to NUL.
+            unsafe {
+                std::ptr::copy_nonoverlapping(MISSING.as_ptr().cast::<c_char>(), error, len);
+                *error.add(len - 1) = 0;
+            }
+        }
+        3
+    }
+
+    pub unsafe fn lance_pipnn_kernel_name() -> *const c_char {
