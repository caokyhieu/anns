-/// Exact squared-L2 top-k over a base subset; only used for N_LIMIT smoke runs.
-fn exact_truth(base: &Matrix, queries: &Matrix, k: usize) -> Truth {
+fn write_ibin_truth(path: &Path, truth: &Truth, distances: &[f32]) {
+    let nq = truth.ids.len() / truth.k;
+    let mut out = BufWriter::new(File::create(path).unwrap());
+    out.write_all(&(nq as u32).to_le_bytes()).unwrap();
+    out.write_all(&(truth.k as u32).to_le_bytes()).unwrap();
+    for id in &truth.ids {
+        out.write_all(&id.to_le_bytes()).unwrap();
+    }
+    for d in distances {
+        out.write_all(&d.to_le_bytes()).unwrap();
+    }
+    out.flush().unwrap();
+}
+
+/// A distance with a total order, for the top-k heaps.
+#[derive(Clone, Copy, Debug)]
+struct OrdDist(f32);
+
+impl PartialEq for OrdDist {
+    fn eq(&self, other: &Self) -> bool {
+        self.cmp(other) == Ordering::Equal
+    }
+}
+impl Eq for OrdDist {}
+impl PartialOrd for OrdDist {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+impl Ord for OrdDist {
+    fn cmp(&self, other: &Self) -> Ordering {
+        self.0.total_cmp(&other.0)
+    }
+}
+
+/// Exact squared-L2 top-`k` (ties to the lower id) of the first `nq` queries. The
+/// base streams through in ~256 MiB blocks, the next block read while the current
+/// one is scored, so memory stays bounded at any base size.
+fn exact_truth(base: &BaseFile, queries: &Matrix, nq: usize, k: usize) -> (Truth, Vec<f32>) {
     let k = k.min(base.rows);
-    let ids = (0..queries.rows)
-        .into_par_iter()
-        .flat_map_iter(|q| {
-            let query = queries.row(q);
-            let mut scored: Vec<(f32, u32)> = (0..base.rows)
-                .map(|i| (lance_linalg::distance::l2::l2(query, base.row(i)), i as u32))
-                .collect();
-            scored.select_nth_unstable_by(k - 1, |a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
-            scored.truncate(k);
-            scored.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
-            scored.into_iter().map(|(_, id)| id).collect::<Vec<_>>()
-        })
-        .collect();
-    Truth { ids, k }
+    let dim = base.dim;
+    let block_rows = ((256usize << 20) / (dim * 4)).max(1);
+    let mut heaps: Vec<BinaryHeap<(OrdDist, u32)>> =
+        (0..nq).map(|_| BinaryHeap::with_capacity(k + 1)).collect();
+    let t = Instant::now();
+    let mut reported = 0;
+    std::thread::scope(|s| {
+        let read = |start: usize| {
+            let count = block_rows.min(base.rows - start);
+            s.spawn(move || (start, base.read_rows(start, count)))
+        };
+        let mut pending = (base.rows > 0).then(|| read(0));
+        while let Some(handle) = pending.take() {
+            let (start, block) = handle.join().unwrap();
+            let count = block.len() / dim;
+            if start + count < base.rows {
+                pending = Some(read(start + count));
+            }
+            heaps.par_iter_mut().enumerate().for_each(|(q, heap)| {
+                let mut distances = vec![0.0f32; count];
+                f32::l2_batch_into(queries.row(q), &block, dim, &mut distances);
+                for (i, &d) in distances.iter().enumerate() {
+                    let item = (OrdDist(d), (start + i) as u32);
+                    if heap.len() < k {
+                        heap.push(item);
+                    } else if item < *heap.peek().unwrap() {
+                        heap.pop();
+                        heap.push(item);
+                    }
+                }
+            });
+            let percent = (start + count) * 100 / base.rows;
+            if percent >= reported + 5 {
+                reported = percent;
+                println!(
+                    "  ground truth: {percent}% of {} rows, {:.0}s",
+                    base.rows,
+                    t.elapsed().as_secs_f64()
+                );
+            }
+        }
+    });
+    let mut ids = Vec::with_capacity(nq * k);
+    let mut distances = Vec::with_capacity(nq * k);
+    for heap in heaps {
+        for (d, id) in heap.into_sorted_vec() {
+            ids.push(id);
+            distances.push(d.0);
+        }
+    }
+    (Truth { ids, k }, distances)
+}
+
+/// [`exact_truth`], cached as `.ibin` next to the Lance dataset so it runs once.
+fn cached_exact_truth(
+    base: &BaseFile,
+    queries: &Matrix,
+    nq: usize,
+    k: usize,
+    uri: &str,
+) -> Truth {
+    let cache = PathBuf::from(format!(
+        "{uri}.gt-{}x{}-q{nq}-k{}.ibin",
+        base.rows,
+        base.dim,
+        k.min(base.rows)
+    ));
+    if cache.is_file() {
+        println!("ground truth from cache {}", cache.display());
+        return read_ibin_truth(&cache);
+    }
+    let t = Instant::now();
+    let (truth, distances) = exact_truth(base, queries, nq, k);
+    println!(
+        "computed exact top-{} ground truth for {nq} queries over {} rows in {:.1}s (untimed)",
+        truth.k,
+        base.rows,
+        t.elapsed().as_secs_f64()
+    );
+    if let Some(parent) = cache.parent() {
+        std::fs::create_dir_all(parent).unwrap();
+    }
+    write_ibin_truth(&cache, &truth, &distances);
+    truth
 }
 
