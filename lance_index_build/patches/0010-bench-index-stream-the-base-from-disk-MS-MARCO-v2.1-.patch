+/// Pass/fail of a finished build row against the `TARGET_*` limits, when any is
+/// set. The search check takes, among settings at `TARGET_K` whose latency
+/// statistic meets `TARGET_LATENCY_MS`, the one with the highest recall.
+fn check_targets(row: &Value) -> Option<Value> {
+    let limit = |name: &str| std::env::var(name).ok().and_then(|v| v.parse::<f64>().ok());
+    let build_secs = limit("TARGET_BUILD_SECS");
+    let index_gb = limit("TARGET_INDEX_GB");
+    let mem_gb = limit("TARGET_MEM_GB");
+    let recall = limit("TARGET_RECALL");
+    let latency_ms = limit("TARGET_LATENCY_MS");
+    if [build_secs, index_gb, mem_gb, recall, latency_ms]
+        .iter()
+        .all(Option::is_none)
+    {
+        return None;
+    }
+    let mut checks = serde_json::Map::new();
+    for (name, max, actual) in [
+        ("build_secs", build_secs, row["build_secs"].as_f64()),
+        ("index_gb", index_gb, row["index_bytes"].as_f64().map(|b| b / 1e9)),
+        ("peak_rss_gb", mem_gb, row["peak_rss_bytes"].as_f64().map(|b| b / 1e9)),
+    ] {
+        if let Some(max) = max {
+            let ok = actual.is_some_and(|a| a <= max);
+            checks.insert(name.into(), json!({"max": max, "actual": actual, "ok": ok}));
+        }
+    }
+    if recall.is_some() || latency_ms.is_some() {
+        let k = limit("TARGET_K").map(|k| k as u64);
+        let stat = std::env::var("TARGET_LATENCY_STAT").unwrap_or_else(|_| "p99".into());
+        let stat_key = format!("{stat}_us");
+        let recall_of = |s: &Value| s["recall"].as_f64().unwrap_or(0.0);
+        let best = row["search"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter(|s| k.is_none_or(|k| s["k"].as_u64() == Some(k)))
+            .filter(|s| {
+                latency_ms.is_none_or(|ms| {
+                    s[stat_key.as_str()]
+                        .as_f64()
+                        .is_some_and(|us| us <= ms * 1000.0)
+                })
+            })
+            .max_by(|a, b| recall_of(a).total_cmp(&recall_of(b)));
+        let ok = best.is_some_and(|s| recall.is_none_or(|r| recall_of(s) >= r));
+        checks.insert(
+            "search".into(),
+            json!({"k": k, "min_recall": recall, "max_latency_ms": latency_ms,
+                   "latency_stat": stat, "best": best, "ok": ok}),
+        );
+    }
