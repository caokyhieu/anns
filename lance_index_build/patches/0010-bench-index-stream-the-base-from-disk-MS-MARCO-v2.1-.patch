+/// Element type of a vector file; values are read as f32 (uint8 converts exactly).
+#[derive(Clone, Copy, Debug)]
+enum Elem {
+    U8,
+    F32,
+}
+
+impl Elem {
+    fn bytes(self) -> usize {
+        match self {
+            Self::U8 => 1,
+            Self::F32 => 4,
+        }
+    }
+}
+
+/// Row-major vectors on disk, read by row range. The scale configs (MS MARCO v2.1,
+/// 113.5M x 1024 float32, 465 GB) do not fit in memory, so nothing loads a whole base.
+struct BaseFile {
+    file: File,
+    path: PathBuf,
+    /// Bytes before the first row.
+    header: u64,
+    elem: Elem,
+    rows: usize,
+    dim: usize,
+}
+
+impl BaseFile {
+    fn new(path: &Path, header: u64, elem: Elem, rows: usize, dim: usize) -> Self {
+        let file = File::open(path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+        let need = header + (rows * dim * elem.bytes()) as u64;
+        let have = file.metadata().unwrap().len();
+        assert!(
+            have >= need,
+            "{}: {have} bytes, but {rows} x {dim} {elem:?} rows need {need}",
+            path.display()
+        );
+        Self {
+            file,
+            path: path.to_path_buf(),
+            header,
+            elem,
+            rows,
+            dim,
+        }
+    }
+
+    /// A big-ann `.u8bin` / `.fbin` file: u32 rows, u32 dim, then row-major values.
+    fn open_bin(path: &Path, elem: Elem) -> Self {
+        let mut header = [0u8; 8];
+        File::open(path)
+            .and_then(|mut f| f.read_exact(&mut header))
+            .unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+        let rows = le_u32(&header[..4]) as usize;
+        let dim = le_u32(&header[4..]) as usize;
+        Self::new(path, 8, elem, rows, dim)
+    }
+
+    /// Keeps the first `limit` rows.
+    fn with_limit(mut self, limit: Option<usize>) -> Self {
+        if let Some(limit) = limit {
+            self.rows = self.rows.min(limit);
+        }
+        self
+    }
+
+    /// An independent handle, for readers that must own their source.
+    fn reopen(&self) -> Self {
+        Self::new(&self.path, self.header, self.elem, self.rows, self.dim)
+    }
+
+    /// Rows `start..start + count` as row-major f32.
+    fn read_rows(&self, start: usize, count: usize) -> Vec<f32> {
+        assert!(start + count <= self.rows, "rows {start}+{count} of {}", self.rows);
+        let row_bytes = self.dim * self.elem.bytes();
+        let mut raw = vec![0u8; count * row_bytes];
+        self.file
+            .read_exact_at(&mut raw, self.header + (start * row_bytes) as u64)
+            .unwrap_or_else(|e| panic!("{}: {e}", self.path.display()));
+        match self.elem {
+            Elem::U8 => raw.into_iter().map(f32::from).collect(),
+            Elem::F32 => raw
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .map(|b| f32::from_le_bytes(*b))
+                .collect(),
+        }
+    }
+
+    fn to_matrix(&self) -> Matrix {
+        Matrix {
+            values: self.read_rows(0, self.rows),
+            rows: self.rows,
+            dim: self.dim,
+        }
     }
 }
 
