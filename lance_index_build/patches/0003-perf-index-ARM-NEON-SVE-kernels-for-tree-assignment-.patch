index 000000000..e8b0cd858
--- /dev/null
+++ b/rust/lance-pipnn/cpp/kernels.h
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+// Distance kernels for the PiPNN builder, selected once per process.
+//
+// The builder compiles with -ffp-contract=off and without fast-math, so a plain
+// float reduction loop is not vectorized. These kernels vectorize explicitly:
+// SSE2 (x86_64 baseline), NEON (aarch64 baseline) and SVE when the object was
+// built and the kernel reports SVE (Linux HWCAP). LANCE_PIPNN_SCALAR=1 forces
+// the scalar loop, for ablations. Lane-partitioned sums round differently from
+// the scalar loop; RobustPrune and the medoid only rank by these distances.
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#if defined(__x86_64__)
+#include <emmintrin.h>
+#elif defined(__aarch64__)
+#include <arm_neon.h>
+#if defined(__linux__)
+#include <sys/auxv.h>
+#ifndef HWCAP_SVE
+#define HWCAP_SVE (1 << 22)
+#endif
+#endif
+#endif
+
+#if defined(LANCE_PIPNN_HAVE_SVE)
+extern "C" float lance_pipnn_sqdist_sve(const float* a, const float* b, size_t d);
+#endif
+
+namespace fastpipnn::kernels {
+
+using SqdistFn = float (*)(const float*, const float*, size_t);
+
+inline float sqdist_scalar(const float* a, const float* b, size_t d) {
+  float s = 0;
+  for (size_t i = 0; i < d; ++i) { float t = a[i] - b[i]; s += t * t; }
+  return s;
+}
+
+#if defined(__x86_64__)
+inline float sqdist_sse2(const float* a, const float* b, size_t d) {
+  __m128 s0 = _mm_setzero_ps(), s1 = _mm_setzero_ps();
+  size_t i = 0;
+  for (; i + 8 <= d; i += 8) {
+    __m128 t0 = _mm_sub_ps(_mm_loadu_ps(a + i), _mm_loadu_ps(b + i));
+    __m128 t1 = _mm_sub_ps(_mm_loadu_ps(a + i + 4), _mm_loadu_ps(b + i + 4));
+    s0 = _mm_add_ps(s0, _mm_mul_ps(t0, t0));
+    s1 = _mm_add_ps(s1, _mm_mul_ps(t1, t1));
+  }
+  alignas(16) float lanes[4];
+  _mm_store_ps(lanes, _mm_add_ps(s0, s1));
+  float s = (lanes[0] + lanes[1]) + (lanes[2] + lanes[3]);
+  for (; i < d; ++i) { float t = a[i] - b[i]; s += t * t; }
+  return s;
+}
+#endif
+
+#if defined(__aarch64__)
+inline float sqdist_neon(const float* a, const float* b, size_t d) {
+  float32x4_t s0 = vdupq_n_f32(0), s1 = vdupq_n_f32(0);
+  size_t i = 0;
+  for (; i + 8 <= d; i += 8) {
+    float32x4_t t0 = vsubq_f32(vld1q_f32(a + i), vld1q_f32(b + i));
+    float32x4_t t1 = vsubq_f32(vld1q_f32(a + i + 4), vld1q_f32(b + i + 4));
+    s0 = vfmaq_f32(s0, t0, t0);
+    s1 = vfmaq_f32(s1, t1, t1);
+  }
+  float s = vaddvq_f32(vaddq_f32(s0, s1));
+  for (; i < d; ++i) { float t = a[i] - b[i]; s += t * t; }
+  return s;
+}
+#endif
+
+inline bool force_scalar() {
+  const char* v = std::getenv("LANCE_PIPNN_SCALAR");
+  return v && v[0] == '1';
+}
+
+inline bool host_has_sve() {
+#if defined(LANCE_PIPNN_HAVE_SVE) && defined(__aarch64__) && defined(__linux__)
+  return (getauxval(AT_HWCAP) & HWCAP_SVE) != 0;
+#else
+  return false;
+#endif
+}
+
+struct Selection {
+  SqdistFn sqdist;
+  bool simd_scan;  // vector leaf top-k scan (NEON, or AVX-512 in -march=native builds)
+  const char* name;
+};
+
+inline Selection select() {
+  if (force_scalar()) return {sqdist_scalar, false, "scalar"};
+#if defined(LANCE_PIPNN_HAVE_SVE)
+  if (host_has_sve()) return {lance_pipnn_sqdist_sve, true, "sve+neon"};
+#endif
+#if defined(__aarch64__)
+  return {sqdist_neon, true, "neon"};
+#elif defined(__x86_64__)
+#if defined(__AVX512F__)
+  return {sqdist_sse2, true, "sse2+avx512"};
+#else
+  return {sqdist_sse2, false, "sse2"};
+#endif
+#else
+  return {sqdist_scalar, false, "scalar"};
+#endif
+}
+
+// Chosen once at load time; LANCE_PIPNN_SCALAR must be set before the process starts.
+inline const Selection selected = select();
+
+}  // namespace fastpipnn::kernels
