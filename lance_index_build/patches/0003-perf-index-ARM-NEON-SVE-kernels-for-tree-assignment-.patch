+// out[a * 4 + b] = <x[a], c[b]> for four rows and four centroids of `dim`
+// elements: each loaded lane feeds four FMAs (16 accumulators of 32 registers).
+// Sizeless SVE types cannot form arrays, hence the named accumulators.
+#define LANCE_TILE_COL(b)                                                      \
+  do {                                                                         \
+    svfloat32_t w = svld1_f32(pg, c + (b) * dim + i);                          \
+    s0##b = svmla_f32_m(pg, s0##b, v0, w);                                      \
+    s1##b = svmla_f32_m(pg, s1##b, v1, w);                                      \
+    s2##b = svmla_f32_m(pg, s2##b, v2, w);                                      \
+    s3##b = svmla_f32_m(pg, s3##b, v3, w);                                      \
+  } while (0)
+#define LANCE_TILE_STORE(a)                                                    \
+  do {                                                                         \
+    out[(a) * 4 + 0] = svaddv_f32(svptrue_b32(), s##a##0);                     \
+    out[(a) * 4 + 1] = svaddv_f32(svptrue_b32(), s##a##1);                     \
+    out[(a) * 4 + 2] = svaddv_f32(svptrue_b32(), s##a##2);                     \
+    out[(a) * 4 + 3] = svaddv_f32(svptrue_b32(), s##a##3);                     \
+  } while (0)
+
+void lance_dot_tile_f32_sve(const float *x, const float *c, size_t dim,
+                            float *out) {
+  svfloat32_t s00 = svdup_f32(0), s01 = svdup_f32(0), s02 = svdup_f32(0),
+              s03 = svdup_f32(0), s10 = svdup_f32(0), s11 = svdup_f32(0),
+              s12 = svdup_f32(0), s13 = svdup_f32(0), s20 = svdup_f32(0),
+              s21 = svdup_f32(0), s22 = svdup_f32(0), s23 = svdup_f32(0),
+              s30 = svdup_f32(0), s31 = svdup_f32(0), s32 = svdup_f32(0),
+              s33 = svdup_f32(0);
+  for (size_t i = 0; i < dim; i += svcntw()) {
