+extern "C" int lance_pipnn_leaf_knn(const float* points, size_t m, size_t dim, size_t k, int simd,
+                                    uint32_t* ids, float* dists) noexcept {
+  try {
+    if (m < 2 || dim == 0 || k == 0 || k >= m) return 1;
+    using RowMat = fastpipnn::RowMat;
+    std::vector<float> gram(m * m), norms(m);
+    Eigen::Map<const RowMat> P(points, m, dim);
+    Eigen::Map<RowMat> G(gram.data(), m, m);
+    Eigen::Map<Eigen::VectorXf>(norms.data(), m) = P.rowwise().squaredNorm();
+    G.triangularView<Eigen::Lower>().setZero();
+    G.selfadjointView<Eigen::Lower>().rankUpdate(P);
