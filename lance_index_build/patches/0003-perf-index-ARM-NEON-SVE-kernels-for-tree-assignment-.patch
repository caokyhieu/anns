+                batch_kernel.call(&x, &batch, dimension, &mut out);
+                for (row, got) in out.iter().enumerate() {
+                    let want = pair.call(&x, &batch[row * dimension..(row + 1) * dimension]);
+                    assert_eq!(got.to_bits(), want.to_bits(), "dim={dimension} row={row}");
+                }
+            }
+        }
+    }
+
