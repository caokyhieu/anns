+  const svbool_t all = svptrue_b32();
+  const size_t lanes = svcntw();
+  svfloat32_t s0 = svdup_f32(0), s1 = svdup_f32(0);
+  size_t i = 0;
+  for (; d - i >= 2 * lanes; i += 2 * lanes) {
+    svfloat32_t t0 = svsub_f32_x(all, svld1_f32(all, a + i), svld1_f32(all, b + i));
+    svfloat32_t t1 = svsub_f32_x(all, svld1_f32(all, a + i + lanes),
+                                 svld1_f32(all, b + i + lanes));
+    s0 = svmla_f32_m(all, s0, t0, t0);
+    s1 = svmla_f32_m(all, s1, t1, t1);
+  }
+  for (; i < d; i += lanes) {
+    svbool_t pg = svwhilelt_b32((uint64_t)i, (uint64_t)d);
+    svfloat32_t t = svsub_f32_x(pg, svld1_f32(pg, a + i), svld1_f32(pg, b + i));
+    s0 = svmla_f32_m(pg, s0, t, t);
+  }
+  return svaddv_f32(all, svadd_f32_x(all, s0, s1));
+}
