+      for (size_t t = 0; t < k; ++t) {
+        ids[a * k + t] = ki[t * m + a];
+        dists[a * k + t] = kd[t * m + a];
+      }
+    return 0;
+  } catch (...) {
+    return 2;
+  }
+}
