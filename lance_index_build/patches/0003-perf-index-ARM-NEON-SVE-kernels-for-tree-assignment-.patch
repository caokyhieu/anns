+// Four rows per pass share each load of x. Every row keeps the two-accumulator
+// schedule of lance_l2_f32_sve, so batch and pair distances are bit-identical.
+#define LANCE_L2_ROW_STEP(r)                                                   \
+  do {                                                                         \
+    svfloat32_t d0 = svsub_f32_x(all, xl, svld1_f32(all, y##r + i));            \
+    svfloat32_t d1 = svsub_f32_x(all, xh, svld1_f32(all, y##r + i + lanes));    \
+    a##r = svmla_f32_m(all, a##r, d0, d0);                                      \
+    b##r = svmla_f32_m(all, b##r, d1, d1);                                      \
+  } while (0)
+#define LANCE_L2_ROW_TAIL(r)                                                   \
+  do {                                                                         \
+    svfloat32_t d = svsub_f32_x(pg, xv, svld1_f32(pg, y##r + i));               \
+    a##r = svmla_f32_m(pg, a##r, d, d);                                         \
+  } while (0)
+
+void lance_l2_batch_f32_sve(const float *x, const float *batch, size_t dim,
+                            size_t count, float *out) {
+  const svbool_t all = svptrue_b32();
+  const size_t lanes = svcntw();
+  size_t row = 0;
+  for (; count - row >= 4; row += 4) {
+    const float *y0 = batch + row * dim, *y1 = y0 + dim, *y2 = y1 + dim,
+                *y3 = y2 + dim;
+    svfloat32_t a0 = svdup_f32(0), a1 = svdup_f32(0), a2 = svdup_f32(0),
+                a3 = svdup_f32(0);
+    svfloat32_t b0 = svdup_f32(0), b1 = svdup_f32(0), b2 = svdup_f32(0),
+                b3 = svdup_f32(0);
+    size_t i = 0;
+    for (; dim - i >= 2 * lanes; i += 2 * lanes) {
+      svfloat32_t xl = svld1_f32(all, x + i), xh = svld1_f32(all, x + i + lanes);
+      LANCE_L2_ROW_STEP(0);
+      LANCE_L2_ROW_STEP(1);
+      LANCE_L2_ROW_STEP(2);
+      LANCE_L2_ROW_STEP(3);
+    }
+    for (; i < dim; i += lanes) {
+      svbool_t pg = svwhilelt_b32((uint64_t)i, (uint64_t)dim);
+      svfloat32_t xv = svld1_f32(pg, x + i);
+      LANCE_L2_ROW_TAIL(0);
+      LANCE_L2_ROW_TAIL(1);
+      LANCE_L2_ROW_TAIL(2);
+      LANCE_L2_ROW_TAIL(3);
+    }
+    out[row] = svaddv_f32(all, svadd_f32_x(all, a0, b0));
+    out[row + 1] = svaddv_f32(all, svadd_f32_x(all, a1, b1));
+    out[row + 2] = svaddv_f32(all, svadd_f32_x(all, a2, b2));
+    out[row + 3] = svaddv_f32(all, svadd_f32_x(all, a3, b3));
+  }
+  for (; row < count; ++row) out[row] = lance_l2_f32_sve(x, batch + row * dim, dim);
+}
+#undef LANCE_L2_ROW_STEP
+#undef LANCE_L2_ROW_TAIL
