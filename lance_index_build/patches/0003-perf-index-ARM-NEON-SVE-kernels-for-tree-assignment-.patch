diff --git a/rust/lance-linalg/src/distance/tile.rs b/rust/lance-linalg/src/distance/tile.rs
new file mode 100644
index 000000000..7f9a18874
--- /dev/null
+++ b/rust/lance-linalg/src/distance/tile.rs
@@ -0,0 +1,365 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! Register-blocked f32 dot-product tiles for dense nearest-centroid search.
+//!
+//! [`dot_tile`] computes the 4x4 block `out[a * 4 + b] = <x[a], c[b]>` for four
+//! contiguous rows `x` and four contiguous centroids `c`. Iterating tiles over a
+//! cache-resident centroid block makes every loaded row lane feed four FMAs and
+//! every loaded centroid lane feed four, which is what k-means training and exact
+//! IVF assignment need once the centroid table no longer fits in L2.
+//!
+//! Candidates sum in different orders (lane-partitioned, fused multiply-add), so
+//! results can differ from each other and from [`crate::distance::dot`] in the
+//! last bits. Callers use tiles to rank candidates and recompute the winning
+//! distance with the pairwise kernel.
+
+/// Rows per tile.
+pub const TILE_ROWS: usize = 4;
+/// Centroids per tile.
+pub const TILE_COLS: usize = 4;
+/// One tile of dot products, row-major: `out[a * TILE_COLS + b] = <x[a], c[b]>`.
+pub type DotTile = [f32; TILE_ROWS * TILE_COLS];
+
+type DotTileKernel = unsafe fn(&[f32], &[f32], usize, &mut DotTile);
+
+/// Writes the 4x4 dot products of the rows in `x` with the rows in `c`.
+///
+/// `x` holds [`TILE_ROWS`] and `c` holds [`TILE_COLS`] contiguous rows of
+/// `dimension` elements each.
+///
+/// # Panics
+///
+/// Panics if `dimension == 0` or either slice is not exactly four rows long.
+pub fn dot_tile(x: &[f32], c: &[f32], dimension: usize, out: &mut DotTile) {
+    DOT_TILE.get().call(x, c, dimension, out);
+}
+
+/// Whether [`dot_tile`] runs a SIMD kernel on this host.
+///
+/// The portable fallback is slower than scoring each row with the per-vector
+/// batch kernel, so blocked callers should only use tiles when this is true.
+pub fn dot_tile_is_accelerated() -> bool {
+    DOT_TILE.selected().name() != DOT_TILE_SCALAR.name()
+}
+
+/// Name of the [`dot_tile`] kernel selected for this host, for benchmark records.
+pub fn dot_tile_kernel_name() -> &'static str {
+    DOT_TILE.selected().name()
+}
+
+#[inline(always)]
+#[track_caller]
+fn check_tile_layout(x_len: usize, c_len: usize, dimension: usize) {
+    // Every kernel dereferences raw row pointers, so this is a safety check.
+    assert!(
+        dimension > 0 && x_len == TILE_ROWS * dimension && c_len == TILE_COLS * dimension,
+        "dot tile needs {TILE_ROWS} rows and {TILE_COLS} centroids of dimension {dimension}: rows={x_len}, centroids={c_len}"
+    );
+}
+
+/// Adds the products of elements `from..dimension` to `out` (SIMD remainders).
+#[inline(always)]
+fn add_tail(x: &[f32], c: &[f32], dimension: usize, from: usize, out: &mut DotTile) {
+    for d in from..dimension {
+        for a in 0..TILE_ROWS {
+            let xv = x[a * dimension + d];
+            for b in 0..TILE_COLS {
+                out[a * TILE_COLS + b] += xv * c[b * dimension + d];
+            }
+        }
+    }
+}
+
+lance_core::dispatch! {
+    static DOT_TILE: Dispatch<DotTileKernel> = {
+        #[cfg(target_arch = "x86_64")]
+        {
+            &[x86::DOT_TILE_AVX512, x86::DOT_TILE_AVX2_FMA, DOT_TILE_SCALAR]
+        }
+        #[cfg(all(target_arch = "aarch64", kernel_support = "sve"))]
+        {
+            &[DOT_TILE_SVE, aarch64::DOT_TILE_NEON, DOT_TILE_SCALAR]
+        }
+        #[cfg(all(target_arch = "aarch64", not(kernel_support = "sve")))]
+        {
+            &[aarch64::DOT_TILE_NEON, DOT_TILE_SCALAR]
+        }
+        #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+        {
+            &[DOT_TILE_SCALAR]
+        }
+    };
+}
+
+lance_core::target_kernel! {
+    #[target_features()]
+    #[candidate(DOT_TILE_SCALAR: DotTileKernel)]
+    fn dot_tile_scalar(x: &[f32], c: &[f32], dimension: usize, out: &mut DotTile) {
+        check_tile_layout(x.len(), c.len(), dimension);
+        out.fill(0.0);
+        add_tail(x, c, dimension, 0, out);
+    }
+}
+
+#[cfg(all(target_arch = "aarch64", kernel_support = "sve"))]
+lance_core::target_kernel! {
+    #[target_features("sve")]
+    #[candidate(DOT_TILE_SVE: DotTileKernel)]
+    fn dot_tile_sve(x: &[f32], c: &[f32], dimension: usize, out: &mut DotTile) {
+        check_tile_layout(x.len(), c.len(), dimension);
+        // SAFETY: the layout check bounds every row the C kernel reads, `out`
+        // holds the 16 values it writes, and the candidate checks SVE.
+        unsafe {
+            crate::simd::arm::lance_dot_tile_f32_sve(
+                x.as_ptr(),
+                c.as_ptr(),
+                dimension,
+                out.as_mut_ptr(),
+            )
+        }
+    }
+}
+
+#[cfg(target_arch = "aarch64")]
+mod aarch64 {
+    use std::arch::aarch64::*;
+
+    use super::{DotTile, DotTileKernel, TILE_COLS, TILE_ROWS, add_tail, check_tile_layout};
+
+    lance_core::target_kernel! {
+        #[target_features("neon")]
+        #[candidate(pub(super) DOT_TILE_NEON: DotTileKernel)]
+        fn dot_tile_neon(x: &[f32], c: &[f32], dimension: usize, out: &mut DotTile) {
+            check_tile_layout(x.len(), c.len(), dimension);
+            let full = dimension / 4 * 4;
+            // SAFETY: the layout check gives four rows of `dimension` elements in
+            // each slice, and every load reads lanes `d..d + 4 <= full`.
+            unsafe {
+                let xp = x.as_ptr();
+                let cp = c.as_ptr();
+                // 16 accumulators + 4 row lanes + 1 centroid lane fit in the 32
+                // NEON registers, so the constant-bound loops stay in registers.
+                // acc[b][a] accumulates <x[a], c[b]>.
+                let mut acc = [[vdupq_n_f32(0.0); TILE_ROWS]; TILE_COLS];
+                let mut d = 0;
+                while d < full {
+                    let rows = [
+                        vld1q_f32(xp.add(d)),
+                        vld1q_f32(xp.add(dimension + d)),
+                        vld1q_f32(xp.add(2 * dimension + d)),
+                        vld1q_f32(xp.add(3 * dimension + d)),
+                    ];
+                    for (b, column) in acc.iter_mut().enumerate() {
+                        let w = vld1q_f32(cp.add(b * dimension + d));
+                        for (sum, &row) in column.iter_mut().zip(&rows) {
+                            *sum = vfmaq_f32(*sum, row, w);
+                        }
+                    }
+                    d += 4;
+                }
+                for (b, column) in acc.iter().enumerate() {
+                    for (a, &sum) in column.iter().enumerate() {
+                        out[a * TILE_COLS + b] = vaddvq_f32(sum);
+                    }
+                }
+            }
+            add_tail(x, c, dimension, full, out);
+        }
+    }
+}
+
+#[cfg(target_arch = "x86_64")]
+mod x86 {
+    use std::arch::x86_64::*;
+
+    use super::{DotTile, DotTileKernel, TILE_COLS, TILE_ROWS, add_tail, check_tile_layout};
+
+    lance_core::target_kernel! {
+        #[target_features("avx512f")]
+        #[candidate(pub(super) DOT_TILE_AVX512: DotTileKernel)]
+        fn dot_tile_avx512(x: &[f32], c: &[f32], dimension: usize, out: &mut DotTile) {
+            check_tile_layout(x.len(), c.len(), dimension);
+            let full = dimension / 16 * 16;
+            // SAFETY: the layout check gives four rows of `dimension` elements in
+            // each slice, and every load reads lanes `d..d + 16 <= full`.
+            unsafe {
+                let xp = x.as_ptr();
+                let cp = c.as_ptr();
+                // acc[b][a] accumulates <x[a], c[b]>.
+                let mut acc = [[_mm512_setzero_ps(); TILE_ROWS]; TILE_COLS];
+                let mut d = 0;
+                while d < full {
+                    let rows = [
+                        _mm512_loadu_ps(xp.add(d)),
+                        _mm512_loadu_ps(xp.add(dimension + d)),
+                        _mm512_loadu_ps(xp.add(2 * dimension + d)),
+                        _mm512_loadu_ps(xp.add(3 * dimension + d)),
+                    ];
+                    for (b, column) in acc.iter_mut().enumerate() {
+                        let w = _mm512_loadu_ps(cp.add(b * dimension + d));
+                        for (sum, &row) in column.iter_mut().zip(&rows) {
+                            *sum = _mm512_fmadd_ps(row, w, *sum);
+                        }
+                    }
+                    d += 16;
+                }
+                for (b, column) in acc.iter().enumerate() {
+                    for (a, &sum) in column.iter().enumerate() {
+                        out[a * TILE_COLS + b] = _mm512_reduce_add_ps(sum);
+                    }
+                }
+            }
+            add_tail(x, c, dimension, full, out);
+        }
+    }
+
+    #[inline]
+    #[target_feature(enable = "avx2,fma")]
+    fn hsum256(v: __m256) -> f32 {
+        let lo = _mm256_castps256_ps128(v);
+        let hi = _mm256_extractf128_ps(v, 1);
+        let s = _mm_add_ps(lo, hi);
+        let s = _mm_add_ps(s, _mm_movehl_ps(s, s));
+        let s = _mm_add_ss(s, _mm_shuffle_ps(s, s, 0x55));
+        _mm_cvtss_f32(s)
+    }
+
+    lance_core::target_kernel! {
+        #[target_features("avx2", "fma")]
+        #[candidate(pub(super) DOT_TILE_AVX2_FMA: DotTileKernel)]
+        /// Computed as two 2x4 halves so the accumulators fit in 16 ymm registers.
+        fn dot_tile_avx2_fma(x: &[f32], c: &[f32], dimension: usize, out: &mut DotTile) {
+            check_tile_layout(x.len(), c.len(), dimension);
+            let full = dimension / 8 * 8;
+            // SAFETY: the layout check gives four rows of `dimension` elements in
+            // each slice, and every load reads lanes `d..d + 8 <= full`.
+            unsafe {
+                let cp = c.as_ptr();
+                for half in 0..2 {
+                    let x0 = x.as_ptr().add(2 * half * dimension);
+                    let x1 = x0.add(dimension);
+                    // acc[b] holds <x0, c[b]> and <x1, c[b]>.
+                    let mut acc = [[_mm256_setzero_ps(); 2]; TILE_COLS];
+                    let mut d = 0;
+                    while d < full {
+                        let v0 = _mm256_loadu_ps(x0.add(d));
+                        let v1 = _mm256_loadu_ps(x1.add(d));
+                        for (b, [s0, s1]) in acc.iter_mut().enumerate() {
+                            let w = _mm256_loadu_ps(cp.add(b * dimension + d));
+                            *s0 = _mm256_fmadd_ps(v0, w, *s0);
+                            *s1 = _mm256_fmadd_ps(v1, w, *s1);
+                        }
+                        d += 8;
+                    }
+                    for (b, column) in acc.iter().enumerate() {
+                        for (r, &v) in column.iter().enumerate() {
+                            out[(2 * half + r) * TILE_COLS + b] = hsum256(v);
+                        }
+                    }
+                }
+            }
+            add_tail(x, c, dimension, full, out);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rstest::rstest;
+
+    fn candidates() -> &'static [lance_core::utils::cpu::Candidate<DotTileKernel>] {
+        DOT_TILE.candidates()
+    }
+
+    fn reference(x: &[f32], c: &[f32], dimension: usize) -> [f64; 16] {
+        let mut out = [0.0; 16];
+        for a in 0..TILE_ROWS {
+            for b in 0..TILE_COLS {
+                out[a * TILE_COLS + b] = (0..dimension)
+                    .map(|d| x[a * dimension + d] as f64 * c[b * dimension + d] as f64)
+                    .sum();
+            }
+        }
+        out
+    }
+
+    fn values(len: usize, seed: u32) -> Vec<f32> {
+        // Deterministic values in [-1, 1) without a RNG dependency.
+        (0..len as u32)
+            .map(|i| {
+                let h = (i.wrapping_add(seed)).wrapping_mul(2_654_435_761) >> 8;
+                (h % 2001) as f32 / 1000.0 - 1.0
+            })
+            .collect()
+    }
+
+    #[rstest]
+    #[case::one(1)]
+    #[case::below_neon(3)]
+    #[case::neon(4)]
+    #[case::irregular(7)]
+    #[case::avx2(8)]
+    #[case::avx512_tail(17)]
+    #[case::sift(128)]
+    #[case::prime(131)]
+    #[case::gist(960)]
+    fn every_candidate_matches_reference(#[case] dimension: usize) {
+        let x = values(TILE_ROWS * dimension, 1);
+        let c = values(TILE_COLS * dimension, 7);
+        let want = reference(&x, &c, dimension);
+        for candidate in candidates() {
+            let Some(kernel) = candidate.kernel() else {
+                continue;
+            };
+            let mut out = [f32::NAN; 16];
+            kernel.call(&x, &c, dimension, &mut out);
+            for (got, want) in out.iter().zip(want) {
+                let tolerance = 1e-5 * (dimension as f64).sqrt().max(1.0);
+                assert!(
+                    (*got as f64 - want).abs() <= tolerance,
+                    "{} dim={dimension}: got {got}, want {want}",
+                    candidate.name()
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn non_finite_inputs_propagate() {
+        let dimension = 9;
+        let mut x = values(TILE_ROWS * dimension, 3);
+        let c = values(TILE_COLS * dimension, 5);
+        x[dimension + 2] = f32::NAN;
+        for candidate in candidates() {
+            let Some(kernel) = candidate.kernel() else {
+                continue;
+            };
+            let mut out = [0.0; 16];
+            kernel.call(&x, &c, dimension, &mut out);
+            for (i, v) in out.iter().enumerate() {
+                assert_eq!(
+                    v.is_nan(),
+                    i / TILE_COLS == 1,
+                    "{} lane {i}",
+                    candidate.name()
+                );
+            }
+        }
+    }
+
+    #[test]
+    #[should_panic(expected = "dot tile needs 4 rows")]
+    fn rejects_short_inputs() {
+        let mut out = [0.0; 16];
+        dot_tile(&[0.0; 15], &[0.0; 16], 4, &mut out);
+    }
+
+    #[test]
+    fn selection_is_reported() {
+        assert!(!dot_tile_kernel_name().is_empty());
+        #[cfg(target_arch = "aarch64")]
+        assert!(dot_tile_is_accelerated(), "NEON is baseline on aarch64");
+    }
+}
