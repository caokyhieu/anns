+/// Process-wide counters for centroid assignment inside IVF builds.
+///
+/// Times are summed over concurrently transformed batches (thread-seconds, not
+/// wall time). Benchmarks reset them before a build and read them afterwards.
+pub mod assignment_stats {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::Instant;
+
+    static NANOS: AtomicU64 = AtomicU64::new(0);
+    static ROWS: AtomicU64 = AtomicU64::new(0);
+    static BATCHES: AtomicU64 = AtomicU64::new(0);
+
+    pub(crate) struct Timer(Instant, usize);
+
+    impl Timer {
+        pub(crate) fn start(rows: usize) -> Self {
+            Self(Instant::now(), rows)
+        }
+    }
+
+    impl Drop for Timer {
+        fn drop(&mut self) {
+            NANOS.fetch_add(self.0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+            ROWS.fetch_add(self.1 as u64, Ordering::Relaxed);
+            BATCHES.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    /// Reset all counters to zero.
+    pub fn reset() {
+        NANOS.store(0, Ordering::Relaxed);
+        ROWS.store(0, Ordering::Relaxed);
+        BATCHES.store(0, Ordering::Relaxed);
+    }
+
+    /// `(thread_seconds, rows, batches)` since the last reset.
+    pub fn snapshot() -> (f64, u64, u64) {
+        (
+            NANOS.load(Ordering::Relaxed) as f64 * 1e-9,
+            ROWS.load(Ordering::Relaxed),
+            BATCHES.load(Ordering::Relaxed),
+        )
+    }
+}
