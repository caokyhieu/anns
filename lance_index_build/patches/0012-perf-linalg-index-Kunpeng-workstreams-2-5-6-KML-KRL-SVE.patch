+            // uzp1 / uzp2 of (PERM0[0..8], PERM0[8..16]) rows = rows 0..8 / 8..16.
+            let groups = [
+                (vuzp1q_u16(r[0], r[1]), vuzp1q_u16(r[2], r[3])),
+                (vuzp2q_u16(r[0], r[1]), vuzp2q_u16(r[2], r[3])),
+            ];
