+    let tp = tables.as_ptr();
+    // acc[q] holds rows 4q..4q+4.
+    let mut acc = [vdupq_n_u32(0); 8];
+    for chunk_start in (0..code_len).step_by(SAFE_U16_CODE_LEN) {
+        let chunk_end = (chunk_start + SAFE_U16_CODE_LEN).min(code_len);
+        // Per nibble half: [low plane bytes 0..8, low plane bytes 8..16,
+        // high plane bytes 0..8, high plane bytes 8..16].
+        let mut rows = [[vdupq_n_u16(0); 4]; 2];
+        for col in chunk_start..chunk_end {
+            let (c_cur, c_next, tl_cur, tl_next, th_cur, th_next) = unsafe {
+                (
