+                    vld1q_u8(cp.add(col * 32 + 16)),
+                    vld1q_u8(tp.add(col * 64)),
+                    vld1q_u8(tp.add(col * 64 + 16)),
+                    vld1q_u8(tp.add(col * 64 + 32)),
+                    vld1q_u8(tp.add(col * 64 + 48)),
