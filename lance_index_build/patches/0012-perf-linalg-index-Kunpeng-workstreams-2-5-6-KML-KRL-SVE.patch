+                let expected: i64 = query
+                    .iter()
+                    .zip(&values)
+                    .map(|(q, &c)| *q as i64 * c as i64)
+                    .sum();
+                let codes = kernel_codes(&values, dim, ex_bits);
+                let mut ex_query = vec![0.0; padded_query_len(dim)];
+                pad_query_into(&query, &mut ex_query);
+                let variants = ex_dot_kernel_variants(ex_bits);
+                #[cfg(target_arch = "aarch64")]
+                if lance_linalg::kunpeng::ex_dot_sve_supported(ex_bits) {
+                    assert!(variants.iter().any(|(n, _)| *n == "sve"));
+                }
+                for (name, kernel) in &variants {
+                    assert_eq!(
+                        kernel(&ex_query, &codes) as i64,
+                        expected,
+                        "ex_bits={ex_bits} dim={dim} {name}"
+                    );
+                    // Dropping trailing all-zero-code bytes must not change the sum.
+                    let mut trimmed = codes.clone();
+                    while trimmed.last() == Some(&0) {
+                        trimmed.pop();
+                    }
+                    assert_eq!(
+                        kernel(&ex_query, &trimmed) as i64,
+                        expected,
+                        "trimmed ex_bits={ex_bits} dim={dim} {name}"
+                    );
+                }
+            }
+        }
+    }
+
+    /// SVE and NEON must agree bit for bit on ordinary float queries.
+    #[cfg(target_arch = "aarch64")]
+    #[test]
+    fn test_ex_dot_sve_is_bit_identical_to_neon() {
+        let mut rng = SmallRng::seed_from_u64(3);
+        for ex_bits in [2u8, 3, 4, 5, 8] {
+            let Some(sve) = sve::available(ex_bits) else {
+                continue;
+            };
+            let max_code = ((1u16 << ex_bits) - 1) as u8;
+            for dim in [7usize, 16, 64, 100, 960, 1024, 1536] {
+                let values: Vec<u8> = (0..dim).map(|_| rng.random_range(0..=max_code)).collect();
+                let query: Vec<f32> = (0..dim).map(|_| rng.random_range(-1.0f32..1.0)).collect();
+                let codes = kernel_codes(&values, dim, ex_bits);
+                let mut q = vec![0.0; padded_query_len(dim)];
+                pad_query_into(&query, &mut q);
+                for len in [codes.len(), codes.len().saturating_sub(3)] {
+                    let c = &codes[..len];
+                    assert_eq!(
+                        sve(&q, c).to_bits(),
+                        neon::kernel(ex_bits)(&q, c).to_bits(),
+                        "ex_bits={ex_bits} dim={dim} len={len}"
+                    );
+                }
+            }
+        }
+    }
