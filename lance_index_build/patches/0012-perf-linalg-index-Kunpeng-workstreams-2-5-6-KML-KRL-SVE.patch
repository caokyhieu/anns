+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+// Benchmark adapter for Huawei's Kunpeng Math Library (KML_BLAS). Compiled
+// only when LANCE_KML_DIR is set, against the installed <kblas.h>, so the
+// CBLAS types and enum values come from the vendor header. The Rust side sees
+// plain C types only.
+
+#include <kblas.h>
+
+// c[m x n] = a[m x k] * b[n x k]^T, all row-major.
+void lance_kml_sgemm_nt(int m, int n, int k, const float *a, int lda,
+                        const float *b, int ldb, float *c, int ldc) {
+  cblas_sgemm(CblasRowMajor, CblasNoTrans, CblasTrans, m, n, k, 1.0f, a, lda,
+              b, ldb, 0.0f, c, ldc);
+}
