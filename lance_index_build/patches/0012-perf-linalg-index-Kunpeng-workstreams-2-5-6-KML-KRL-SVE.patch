-/// Index of the first candidate `host` supports.
+/// Index of the first candidate `host` supports, after [`KernelOverrides`].
 fn select<F>(candidates: &[Candidate<F>], host: CpuFeatures) -> usize {
+    select_with(candidates, host, kernel_overrides())
+}
+
+fn select_with<F>(
+    candidates: &[Candidate<F>],
+    host: CpuFeatures,
+    overrides: &KernelOverrides,
+) -> usize {
+    let last = candidates.len() - 1;
+    if let Some(i) = candidates
+        .iter()
+        .position(|c| overrides.prefers(c.name) && host.contains(c.features))
+    {
+        return i;
+    }
     candidates
         .iter()
-        .position(|candidate| host.contains(candidate.features))
+        .enumerate()
+        .position(|(i, c)| host.contains(c.features) && (i == last || !overrides.disables(c.name)))
         .expect("Dispatch::new requires a candidate without features")
 }
 
+/// Benchmark control: `LANCE_KERNELS` is a comma list of candidate names,
+/// each prefixed `+` (prefer it when the host supports it) or `-` (skip it),
+/// e.g. `LANCE_KERNELS=-sum_hacc_sve,+sum_u16_krl`. It lets one build compare
+/// every kernel arm. The last (portable) candidate of a dispatch can never be
+/// disabled, and dispatches resolved at compile time (the best candidate is
+/// in the build baseline) ignore it.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct KernelOverrides {
+    prefer: Vec<String>,
+    disable: Vec<String>,
+}
+
+impl KernelOverrides {
+    /// Parses a `LANCE_KERNELS` value; entries without a sign are preferred.
+    pub fn parse(spec: &str) -> Self {
+        let mut overrides = Self::default();
+        for entry in spec.split(',').map(str::trim).filter(|e| !e.is_empty()) {
+            match entry.strip_prefix('-') {
+                Some(name) => overrides.disable.push(name.to_string()),
+                None => overrides
+                    .prefer
+                    .push(entry.strip_prefix('+').unwrap_or(entry).to_string()),
+            }
+        }
+        overrides
+    }
+
+    /// Whether `name` was listed with `+`.
+    pub fn prefers(&self, name: &str) -> bool {
+        self.prefer.iter().any(|n| n == name)
+    }
+
+    /// Whether `name` was listed with `-`.
+    pub fn disables(&self, name: &str) -> bool {
+        self.disable.iter().any(|n| n == name)
+    }
+}
+
+/// The process-wide `LANCE_KERNELS` overrides, read once. Code that selects
+/// kernels without a [`Dispatch`] (per-width tables) should honour it too.
+pub fn kernel_overrides() -> &'static KernelOverrides {
+    static OVERRIDES: OnceLock<KernelOverrides> = OnceLock::new();
+    OVERRIDES.get_or_init(|| {
+        std::env::var("LANCE_KERNELS")
+            .map(|v| KernelOverrides::parse(&v))
+            .unwrap_or_default()
+    })
+}
+
 /// Declares a kernel and a [`Candidate`] for it from one feature list.
 ///
 /// The kernel gets one `#[target_feature(enable = ...)]` per listed feature,
@@ -274,6 +339,26 @@ macro_rules! dispatch {
 mod tests {
     use super::*;
 
+    #[test]
+    fn overrides_prefer_and_disable() {
+        let o = KernelOverrides::parse(" +b, -a ,c,,");
+        assert!(o.prefers("b") && o.prefers("c") && o.disables("a"));
+        assert!(!o.prefers("a") && !o.disables("b"));
+        let kernels = [
+            unsafe { Candidate::new("a", CpuFeatures::empty(), 0u8) },
+            unsafe { Candidate::new("b", CpuFeatures::AVX2, 1u8) },
+            unsafe { Candidate::new("z", CpuFeatures::empty(), 2u8) },
+        ];
+        let none = KernelOverrides::default();
+        assert_eq!(select_with(&kernels, CpuFeatures::empty(), &none), 0);
+        // "b" is preferred but unsupported: fall through, skipping disabled "a".
+        assert_eq!(select_with(&kernels, CpuFeatures::empty(), &o), 2);
+        assert_eq!(select_with(&kernels, CpuFeatures::AVX2, &o), 1);
+        // The portable fallback cannot be disabled.
+        let all = KernelOverrides::parse("-a,-z");
+        assert_eq!(select_with(&kernels, CpuFeatures::empty(), &all), 2);
+    }
