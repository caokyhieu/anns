new file mode 100644
index 0000000..a66bd6e
--- /dev/null
+++ b/rust/lance-linalg/src/kunpeng.rs
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+//! ARM / Kunpeng kernel backends that callers outside this crate select
+//! explicitly (they are not behind a [`lance_core::utils::cpu::Dispatch`]):
+//!
+//! - SVE RaBitQ extra-bit dot products ([`ex_dot_sve`]);
+//! - SVE FP32 matrix-multiply (`FMMLA`) dot blocks for nearest-centroid
+//!   search ([`F32mmBlock`]);
+//! - Huawei Kunpeng Math Library SGEMM ([`kml_sgemm_nt`]) and Kunpeng
+//!   Retrieval Library L2 distances ([`KrlL2Handle`], [`krl_l2sqr_ny`]),
+//!   compiled only when `LANCE_KML_DIR` / `LANCE_KRL_DIR` name an install.
+//!
+//! Every entry point reports unavailability (`None` / `false`) instead of
+//! failing, so callers keep their existing kernels as the fallback. On other
+//! targets everything here is unavailable.
+
+/// The calling thread's SVE vector length in bytes, if this build has the SVE
+/// objects and the host supports SVE.
+pub fn sve_vector_bytes() -> Option<usize> {
+    #[cfg(all(target_arch = "aarch64", kernel_support = "sve"))]
+    {
+        use lance_core::utils::cpu::CpuFeatures;
+        if CpuFeatures::host().contains(CpuFeatures::SVE) {
+            // SAFETY: the host supports SVE.
+            return Some(unsafe { crate::simd::arm::lance_sve_vector_bytes() });
+        }
+    }
+    None
+}
+
+/// Code group geometry of the blocked ex-code layout (`lance-index`
+/// `bq/ex_dot.rs`): (dims, bytes) per group.
+#[cfg_attr(
+    not(all(target_arch = "aarch64", kernel_support = "sve")),
+    allow(dead_code)
+)]
+const fn ex_group(ex_bits: u8) -> (usize, usize) {
+    match ex_bits {
+        4 => (16, 8),
+        8 => (16, 16),
+        _ => (64, 64 * ex_bits as usize / 8),
+    }
+}
+
+/// Whether [`ex_dot_sve`] has a kernel for `ex_bits` on this host: SVE with
+/// vectors of at least 256 bits, and `ex_bits` in {2, 3, 4, 5, 8}.
+pub fn ex_dot_sve_supported(ex_bits: u8) -> bool {
+    matches!(ex_bits, 2 | 3 | 4 | 5 | 8) && sve_vector_bytes().is_some_and(|b| b >= 32)
+}
+
+/// `sum_d query[d] * code[d]` with the contract of `lance-index`'s `ExDotFn`:
+/// `query` covers whole 64-dim blocks and `codes` is one blocked row, treated
+/// as zero-padded when shorter. `None` when no SVE kernel can run (see
+/// [`ex_dot_sve_supported`]); the caller then uses its NEON kernel.
+#[inline]
+pub fn ex_dot_sve<const EX_BITS: u8>(query: &[f32], codes: &[u8]) -> Option<f32> {
+    #[cfg(all(target_arch = "aarch64", kernel_support = "sve"))]
+    {
+        use crate::simd::arm;
+        type Raw = unsafe extern "C" fn(*const f32, *const u8, usize, *const u8, *mut f32) -> i32;
+        let raw: Raw = match EX_BITS {
+            2 => arm::lance_ex_dot_u2_sve,
+            3 => arm::lance_ex_dot_u3_sve,
+            4 => arm::lance_ex_dot_u4_sve,
+            5 => arm::lance_ex_dot_u5_sve,
+            8 => arm::lance_ex_dot_u8_sve,
+            _ => return None,
+        };
+        let (group_dims, group_bytes) = const { ex_group(EX_BITS) };
+        assert_eq!(
+            query.len() % group_dims,
+            0,
+            "query is not padded to whole groups"
+        );
+        let groups = query.len() / group_dims;
+        let full = (codes.len() / group_bytes).min(groups);
+        let consumed = full * group_bytes;
+        // A partial final group is zero-padded and accumulated in place, as
+        // the NEON kernels do, so the result matches them bit for bit.
+        let mut padded = [0u8; 64];
+        let tail = if consumed < codes.len() && full < groups {
+            let avail = (codes.len() - consumed).min(group_bytes);
+            padded[..avail].copy_from_slice(&codes[consumed..consumed + avail]);
+            padded.as_ptr()
+        } else {
+            std::ptr::null()
+        };
+        let mut sum = 0.0f32;
+        // SAFETY: `full` groups of codes plus the optional padded group, and
+        // their query runs, are in bounds.
+        if unsafe { raw(query.as_ptr(), codes.as_ptr(), full, tail, &mut sum) } != 0 {
+            return None;
+        }
+        Some(sum)
+    }
+    #[cfg(not(all(target_arch = "aarch64", kernel_support = "sve")))]
+    {
+        let _ = (query, codes);
+        None
+    }
+}
+
+/// Rows of a [`F32mmBlock`] tile; row blocks are padded to a multiple.
+pub const F32MM_ROWS: usize = 8;
+/// Centroids of a [`F32mmBlock`] tile; centroid sets are padded to a multiple.
+pub const F32MM_COLS: usize = 4;
+
+/// Whether the SVE `FMMLA` dot blocks can run on this host.
+pub fn f32mm_available() -> bool {
+    #[cfg(all(target_arch = "aarch64", kernel_support = "sve_f32mm"))]
+    {
+        use lance_core::utils::cpu::CpuFeatures;
+        return CpuFeatures::host().contains(CpuFeatures::F32MM);
+    }
+    #[allow(unreachable_code)]
+    false
+}
+
+/// A matrix in the pair-packed layout of the `FMMLA` kernel: rows `2p` and
+/// `2p + 1` interleaved in two-float granules, every 128-bit segment a 2x2
+/// block. Rows are zero-padded to `pad_rows` and the dimension to even.
+pub struct F32mmBlock {
+    data: Vec<f32>,
+    rows: usize,
+    kp: usize,
+}
+
+impl F32mmBlock {
+    /// Packs `rows.len() / dim` rows, zero-padding to a multiple of `pad_rows`
+    /// (which must be even).
+    pub fn pack(rows: &[f32], dim: usize, pad_rows: usize) -> Self {
+        let mut block = Self {
+            data: Vec::new(),
+            rows: 0,
+            kp: 0,
+        };
+        block.repack(rows, dim, pad_rows);
+        block
+    }
+
+    /// [`Self::pack`] into the existing allocation.
+    pub fn repack(&mut self, rows: &[f32], dim: usize, pad_rows: usize) {
+        assert!(dim > 0 && pad_rows.is_multiple_of(2) && rows.len().is_multiple_of(dim));
+        let n = rows.len() / dim;
+        let n_pad = n.div_ceil(pad_rows) * pad_rows;
+        let half = dim.div_ceil(2);
+        let kp = 4 * half;
+        self.data.clear();
+        self.data.resize(n_pad / 2 * kp, 0.0);
+        for (r, row) in rows.chunks_exact(dim).enumerate() {
+            let base = (r / 2) * kp + 2 * (r % 2);
+            for (k2, pair) in row.chunks(2).enumerate() {
+                self.data[base + 4 * k2] = pair[0];
+                if let Some(&v) = pair.get(1) {
+                    self.data[base + 4 * k2 + 1] = v;
+                }
+            }
+        }
+        self.rows = n_pad;
+        self.kp = kp;
+    }
+
+    /// Padded row count.
+    pub fn rows(&self) -> usize {
+        self.rows
+    }
+
+    /// Packed floats per row pair.
+    pub fn pair_len(&self) -> usize {
+        self.kp
+    }
+
+    /// The packed rows `start..start + count` (both even) as a sub-block view.
+    fn pairs(&self, start: usize, count: usize) -> &[f32] {
+        &self.data[start / 2 * self.kp..(start + count) / 2 * self.kp]
+    }
+}
+
+/// `out[r * ldo + c] = <x[x_start + r], cent[c_start + c]>` for
+/// `r < x_count`, `c < c_count`, with `x_count` a multiple of
+/// [`F32MM_ROWS`] and `c_count` of [`F32MM_COLS`]. Returns `false` (writing
+/// nothing) when [`f32mm_available`] is false.
+#[allow(clippy::too_many_arguments)]
+pub fn dot_block_f32mm(
+    x: &F32mmBlock,
+    x_start: usize,
+    x_count: usize,
+    cent: &F32mmBlock,
+    c_start: usize,
+    c_count: usize,
+    out: &mut [f32],
+    ldo: usize,
+) -> bool {
+    if !f32mm_available() {
+        return false;
+    }
+    assert_eq!(x.kp, cent.kp, "row and centroid dimensions differ");
+    assert!(x_count.is_multiple_of(F32MM_ROWS) && c_count.is_multiple_of(F32MM_COLS));
+    assert!(x_start.is_multiple_of(2) && c_start.is_multiple_of(2));
+    assert!(x_start + x_count <= x.rows && c_start + c_count <= cent.rows);
+    assert!(c_count <= ldo && out.len() >= x_count.saturating_sub(1) * ldo + c_count);
+    #[cfg(all(target_arch = "aarch64", kernel_support = "sve_f32mm"))]
+    {
+        let xs = x.pairs(x_start, x_count);
+        let cs = cent.pairs(c_start, c_count);
+        // SAFETY: the host supports F32MM; the slices hold exactly the pairs
+        // the kernel reads and `out` covers every row/column it writes.
+        unsafe {
+            crate::simd::arm::lance_dot_block_f32mm(
+                xs.as_ptr(),
+                x_count / 2,
+                cs.as_ptr(),
+                c_count / 2,
+                x.kp,
+                out.as_mut_ptr(),
+                ldo,
+            )
+        };
+        return true;
+    }
+    #[allow(unreachable_code)]
+    {
+        let _ = (x.pairs(0, 0), cent, out);
+        false
+    }
+}
+
+/// Whether the KML adapter was built (`LANCE_KML_DIR`).
+pub const KML_AVAILABLE: bool = cfg!(all(target_arch = "aarch64", kernel_support = "kml"));
+/// Whether the KRL adapter was built (`LANCE_KRL_DIR`).
+pub const KRL_AVAILABLE: bool = cfg!(all(target_arch = "aarch64", kernel_support = "krl"));
+
+/// KML `cblas_sgemm`: `c[m x n] = a[m x k] * b[n x k]^T`, row-major with
+/// leading dimensions `k`, `k` and `n`. Returns `false` when KML is not built.
+/// KML threading follows `BLAS_NUM_THREADS`; set it to 1 inside rayon workers.
+pub fn kml_sgemm_nt(m: usize, n: usize, k: usize, a: &[f32], b: &[f32], c: &mut [f32]) -> bool {
+    assert!(a.len() >= m * k && b.len() >= n * k && c.len() >= m * n);
+    #[cfg(all(target_arch = "aarch64", kernel_support = "kml"))]
+    {
+        let to_i32 = |v: usize| i32::try_from(v).expect("sgemm dimension exceeds i32");
+        // SAFETY: the slices cover the m x k, n x k and m x n operands.
+        unsafe {
+            crate::simd::arm::lance_kml_sgemm_nt(
+                to_i32(m),
+                to_i32(n),
+                to_i32(k),
+                a.as_ptr(),
+                to_i32(k),
+                b.as_ptr(),
+                to_i32(k),
+                c.as_mut_ptr(),
+                to_i32(n),
+            )
+        };
+        return true;
+    }
+    #[allow(unreachable_code)]
+    false
+}
+
+/// KRL `krl_L2sqr_ny`: squared L2 from `x` to each of the `y.len() / x.len()`
+/// rows of `y`. `None` when KRL is not built; `Err` carries a KRL status.
+pub fn krl_l2sqr_ny(x: &[f32], y: &[f32], out: &mut [f32]) -> Option<Result<(), i32>> {
+    let d = x.len();
+    assert!(d > 0 && y.len().is_multiple_of(d) && out.len() >= y.len() / d);
+    #[cfg(all(target_arch = "aarch64", kernel_support = "krl"))]
+    {
+        // SAFETY: `out` holds one distance per row of `y`.
+        let status = unsafe {
+            crate::simd::arm::lance_krl_l2sqr_ny(
+                out.as_mut_ptr(),
+                x.as_ptr(),
+                y.as_ptr(),
+                y.len() / d,
+                d,
+            )
+        };
+        return Some(if status == 0 { Ok(()) } else { Err(status) });
+    }
+    #[allow(unreachable_code)]
+    {
+        let _ = out;
+        None
+    }
+}
+
+/// A KRL fp32 squared-L2 distance handle over a fixed base set (one query
+/// per call). The base is zero-padded to a multiple of the KRL block size;
+/// padded entries are returned too and must be ignored by the caller.
+/// Each handle is used from one thread at a time (KRL documents no
+/// concurrency guarantee), hence `!Sync`.
+pub struct KrlL2Handle {
+    #[cfg(all(target_arch = "aarch64", kernel_support = "krl"))]
+    raw: *mut std::ffi::c_void,
+    padded: usize,
+    dim: usize,
+}
+
+// SAFETY: the handle owns its KRL state and may move between threads; it is
+// not `Sync`, so it is never used concurrently.
+unsafe impl Send for KrlL2Handle {}
+
+impl KrlL2Handle {
+    /// Builds a handle over `base` (`base.len() / dim` rows). `None` when KRL
+    /// is not built; `Err` carries a KRL status.
+    pub fn new(base: &[f32], dim: usize) -> Option<Result<Self, i32>> {
+        assert!(dim > 0 && base.len().is_multiple_of(dim));
+        #[cfg(all(target_arch = "aarch64", kernel_support = "krl"))]
+        {
+            let n = base.len() / dim;
+            let blocksize = if n % 64 == 0 {
+                64
+            } else if n % 32 == 0 {
+                32
+            } else {
+                16
+            };
+            let padded = n.div_ceil(blocksize) * blocksize;
+            let mut owned;
+            let data = if padded == n {
+                base
+            } else {
+                owned = vec![0.0f32; padded * dim];
+                owned[..base.len()].copy_from_slice(base);
+                owned.as_slice()
+            };
+            let mut raw = std::ptr::null_mut();
+            // SAFETY: `data` holds `padded * dim` floats; KRL copies the base.
+            let status = unsafe {
+                crate::simd::arm::lance_krl_create_l2_handle(
+                    &mut raw,
+                    blocksize,
+                    padded,
+                    dim,
+                    data.as_ptr(),
+                )
+            };
+            return Some(if status == 0 && !raw.is_null() {
+                Ok(Self { raw, padded, dim })
+            } else {
+                Err(status)
+            });
+        }
+        #[allow(unreachable_code)]
+        None
+    }
+
+    /// Base rows including padding: the length `distances` writes.
+    pub fn padded_len(&self) -> usize {
+        self.padded
+    }
+
+    /// Squared L2 from `x` to every (padded) base row.
+    pub fn distances(&self, x: &[f32], out: &mut [f32]) -> Result<(), i32> {
+        assert!(x.len() == self.dim && out.len() >= self.padded);
+        #[cfg(all(target_arch = "aarch64", kernel_support = "krl"))]
+        {
+            // SAFETY: `out` holds `padded` distances, `x` one query.
+            let status = unsafe {
+                crate::simd::arm::lance_krl_l2_with_handle(
+                    self.raw,
+                    out.as_mut_ptr(),
+                    self.padded,
+                    x.as_ptr(),
+                    self.dim,
+                )
+            };
+            return if status == 0 { Ok(()) } else { Err(status) };
+        }
+        #[allow(unreachable_code)]
+        Err(-1)
+    }
+}
+
+impl Drop for KrlL2Handle {
+    fn drop(&mut self) {
+        #[cfg(all(target_arch = "aarch64", kernel_support = "krl"))]
+        // SAFETY: `raw` came from `lance_krl_create_l2_handle` and is dropped once.
+        unsafe {
+            crate::simd::arm::lance_krl_clean_handle(self.raw)
+        };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn f32mm_block_matches_scalar_dots() {
+        if !f32mm_available() {
+            return;
+        }
+        for dim in [1usize, 2, 3, 7, 32, 33, 960] {
+            let (n, k) = (13usize, 9usize);
+            let x: Vec<f32> = (0..n * dim)
+                .map(|i| ((i * 37 % 101) as f32 - 50.0) / 7.0)
+                .collect();
+            let c: Vec<f32> = (0..k * dim)
+                .map(|i| ((i * 53 % 97) as f32 - 48.0) / 5.0)
+                .collect();
+            let xp = F32mmBlock::pack(&x, dim, F32MM_ROWS);
+            let cp = F32mmBlock::pack(&c, dim, F32MM_COLS);
+            let ldo = cp.rows();
+            let mut out = vec![f32::NAN; xp.rows() * ldo];
+            assert!(dot_block_f32mm(
+                &xp,
+                0,
+                xp.rows(),
+                &cp,
+                0,
+                cp.rows(),
+                &mut out,
+                ldo
+            ));
+            for r in 0..n {
+                for j in 0..k {
+                    let want: f64 = (0..dim)
+                        .map(|d| x[r * dim + d] as f64 * c[j * dim + d] as f64)
+                        .sum();
+                    let got = out[r * ldo + j] as f64;
+                    let scale: f64 = (0..dim)
+                        .map(|d| (x[r * dim + d] * c[j * dim + d]).abs() as f64)
+                        .sum();
+                    assert!(
+                        (got - want).abs() <= 1e-5 * scale.max(1.0),
+                        "dim={dim} r={r} j={j} {got} vs {want}"
+                    );
+                }
+            }
+            // Offset sub-blocks agree with the full block.
+            let mut sub = vec![0.0; F32MM_ROWS * ldo];
+            assert!(dot_block_f32mm(&xp, 8, 8, &cp, 4, 4, &mut sub, ldo));
+            for r in 0..5 {
+                for j in 0..4 {
+                    if 4 + j < k {
+                        assert_eq!(sub[r * ldo + j], out[(8 + r) * ldo + 4 + j]);
+                    }
+                }
+            }
+        }
+    }
+}
