+            let codes: Vec<u8> = (0..BATCH_SIZE * code_len).map(|_| next()).collect();
+            // Keep sums below 2^16 so saturation and wrapping agree.
+            let table: Vec<u8> = (0..BATCH_SIZE * code_len).map(|_| next() / 2).collect();
+            let mut want = vec![0u16; BATCH_SIZE];
