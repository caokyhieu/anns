@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+// Benchmark adapter for Huawei's Kunpeng Retrieval Library (KRL). Compiled
+// only when LANCE_KRL_DIR is set, against the installed <krl.h>; the Rust side
+// sees plain C types only. Every function returns KRL's status (0 = success).
+
+#include <stddef.h>
+#include <stdint.h>
+#include <krl.h>
+
+// One query against ny contiguous base vectors, fp32 squared L2.
+int lance_krl_l2sqr_ny(float *dis, const float *x, const float *y, size_t ny,
+                       size_t d) {
+  return krl_L2sqr_ny(dis, x, y, ny, d, ny);
+}
+
+// fp32 (accu_level 3) squared-L2 handle over codes_num base vectors, one
+// query per call (num_base 1). codes_num must be divisible by blocksize.
+int lance_krl_create_l2_handle(void **handle, size_t blocksize,
+                               size_t codes_num, size_t dim,
+                               const float *base) {
+  KRLDistanceHandle *kdh = NULL;
+  int ret = krl_create_distance_handle(&kdh, 3, blocksize, codes_num, dim, 1,
+                                       1, (const uint8_t *)base,
+                                       codes_num * dim * sizeof(float));
+  *handle = kdh;
+  return ret;
+}
+
+int lance_krl_l2_with_handle(const void *handle, float *dis, size_t codes_num,
+                             const float *x, size_t dim) {
+  return krl_L2sqr_ny_with_handle((const KRLDistanceHandle *)handle, dis, x,
+                                  codes_num, dim);
+}
+
+void lance_krl_clean_handle(void *handle) {
+  KRLDistanceHandle *kdh = (KRLDistanceHandle *)handle;
+  krl_clean_distance_handle(&kdh);
+}
+
+// 4-bit FastScan over one block of 32 rows: nsq 16-entry u8 tables, codes as
+// nsq / 2 * 32 bytes, u16 sums into dis (room for 64). The documented
+// dis_size / lt_mask_size for bs32 disagree between the parameter table (64,
+// 2) and the sample (32, 1); both are tried once and the accepted pair kept.
+int lance_krl_fast_scan_bs32(int nsq, const uint8_t *codes, const uint8_t *lut,
+                             uint16_t *dis) {
+  static int variant = -1;
+  uint32_t mask[2] = {0, 0};
+  const size_t codes_size = (size_t)nsq / 2 * 32, lut_size = (size_t)nsq * 16;
+  if (variant < 0) {
+    int ret = krl_L2_table_lookup_fast_scan_bs32(
+        nsq, codes, lut, dis, 65535, mask, codes_size, lut_size, 32, 1);
+    if (ret == 0) {
+      variant = 0;
+      return 0;
+    }
+    ret = krl_L2_table_lookup_fast_scan_bs32(nsq, codes, lut, dis, 65535, mask,
+                                             codes_size, lut_size, 64, 2);
+    if (ret == 0) variant = 1;
+    return ret;
+  }
+  return variant == 0
+             ? krl_L2_table_lookup_fast_scan_bs32(nsq, codes, lut, dis, 65535,
+                                                  mask, codes_size, lut_size,
+                                                  32, 1)
+             : krl_L2_table_lookup_fast_scan_bs32(nsq, codes, lut, dis, 65535,
+                                                  mask, codes_size, lut_size,
+                                                  64, 2);
+}
+
+// Repack raw per-vector 4-bit codes (nsq nibbles per vector, two per byte)
+// into KRL's FastScan block layout.
+int lance_krl_pack_codes_4b(const uint8_t *codes, size_t ncode, size_t nsq,
+                            uint8_t *blocks, size_t batchsize) {
+  size_t blocks_size = (ncode + batchsize - 1) / batchsize * batchsize *
+                       ((nsq + 1) / 2);
+  return krl_pack_codes_4b(codes, ncode, nsq, blocks, batchsize, 0,
+                           ncode * nsq / 2, blocks_size);
+}
