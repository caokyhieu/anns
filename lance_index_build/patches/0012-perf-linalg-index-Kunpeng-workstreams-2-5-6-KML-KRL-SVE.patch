+/// SVE ex-code kernels (C objects in `lance-linalg`): the NEON unpack layout
+/// read with zero-extending byte loads into 8 x u32 lanes, one convert and
+/// one FMA per 8 dims. Selected on SVE hosts with >= 256-bit vectors for
+/// `ex_bits` in {2, 3, 4, 5, 8} unless `LANCE_KERNELS` lists `-ex_dot_sve` or
+/// `-ex_dot_u<bits>_sve`; other widths keep NEON. The kernels keep NEON's
+/// lane assignment and reduction order, so results are bit-identical to NEON
+/// (which the fused prefix kernels also reproduce).
+#[cfg(target_arch = "aarch64")]
+mod sve {
+    use super::ExDotFn;
+    use lance_linalg::kunpeng::{ex_dot_sve, ex_dot_sve_supported};
+
+    pub(super) fn name(ex_bits: u8) -> String {
+        format!("ex_dot_u{ex_bits}_sve")
+    }
+
+    /// The SVE kernel when supported and not disabled.
+    pub(super) fn kernel(ex_bits: u8) -> Option<ExDotFn> {
+        let overrides = lance_core::utils::cpu::kernel_overrides();
+        if overrides.disables("ex_dot_sve") || overrides.disables(&name(ex_bits)) {
+            return None;
+        }
+        available(ex_bits)
+    }
+
+    /// The SVE kernel when the host can run it, ignoring overrides.
+    pub(super) fn available(ex_bits: u8) -> Option<ExDotFn> {
+        if !ex_dot_sve_supported(ex_bits) {
+            return None;
+        }
+        Some(match ex_bits {
+            2 => dot_u2_sve,
+            3 => dot_u3_sve,
+            4 => dot_u4_sve,
+            5 => dot_u5_sve,
+            8 => dot_u8_sve,
+            _ => return None,
+        })
+    }
+
+    macro_rules! sve_kernel {
+        ($name:ident, $bits:literal) => {
+            fn $name(ex_query: &[f32], codes: &[u8]) -> f32 {
+                // `None` only if the thread's vector length dropped below
+                // 256 bits after selection; NEON then computes the result.
+                ex_dot_sve::<$bits>(ex_query, codes)
+                    .unwrap_or_else(|| super::neon::kernel($bits)(ex_query, codes))
+            }
+        };
+    }
+    sve_kernel!(dot_u2_sve, 2);
+    sve_kernel!(dot_u3_sve, 3);
+    sve_kernel!(dot_u4_sve, 4);
+    sve_kernel!(dot_u5_sve, 5);
+    sve_kernel!(dot_u8_sve, 8);
+}
+
+/// Name of the ex-code kernel [`ex_dot_kernel`] selects for `ex_bits`, for
+/// benchmark records.
+pub fn ex_dot_kernel_name(ex_bits: u8) -> String {
+    #[cfg(target_arch = "aarch64")]
+    {
+        if sve::kernel(ex_bits).is_some() {
+            return sve::name(ex_bits);
+        }
+        return format!("ex_dot_u{ex_bits}_neon");
+    }
+    #[allow(unreachable_code)]
+    {
+        #[cfg(target_arch = "x86_64")]
+        {
+            if std::arch::is_x86_feature_detected!("avx512f") {
+                return format!("ex_dot_u{ex_bits}_avx512");
+            }
+            if std::arch::is_x86_feature_detected!("avx2")
+                && std::arch::is_x86_feature_detected!("fma")
+            {
+                return format!("ex_dot_u{ex_bits}_avx2");
+            }
+        }
+        format!("ex_dot_u{ex_bits}_scalar")
+    }
