+/// Compiles `src/simd/vendor_<name>.c` against `$<dir_var>/include/<header>`
+/// and links `$<NAME>_LIBS` (comma list, default `default_libs`) from
+/// `$<NAME>_LIBDIR` or the first existing `lib_dirs` entry under the install
+/// directory. Emits `kernel_support="<name>"` on success.
+fn build_vendor(name: &str, dir_var: &str, header: &str, lib_dirs: &[&str], default_libs: &str) {
+    let Some(dir) = env::var_os(dir_var).map(std::path::PathBuf::from) else {
+        return;
+    };
+    let upper = name.to_uppercase();
+    let include = dir.join("include");
+    if !include.join(header).exists() {
+        println!(
+            "cargo:warning=Skipping {name} adapter: {} not found",
+            include.join(header).display()
+        );
+        return;
+    }
+    let lib_dir = env::var_os(format!("LANCE_{upper}_LIBDIR"))
+        .map(std::path::PathBuf::from)
+        .or_else(|| lib_dirs.iter().map(|d| dir.join(d)).find(|d| d.is_dir()));
+    let Some(lib_dir) = lib_dir else {
+        println!(
+            "cargo:warning=Skipping {name} adapter: no library directory under {}",
+            dir.display()
+        );
+        return;
+    };
+    let result = cc::Build::new()
+        .std("c11")
+        .file(format!("src/simd/vendor_{name}.c"))
+        .include(&include)
+        .opt_level(2)
+        .try_compile(&format!("lance_vendor_{name}"));
+    if let Err(err) = result {
+        println!("cargo:warning=Skipping {name} adapter: {err}");
+        return;
+    }
+    println!("cargo:rustc-link-search=native={}", lib_dir.display());
+    let libs = env::var(format!("LANCE_{upper}_LIBS")).unwrap_or_else(|_| default_libs.to_string());
+    for lib in libs.split(',').map(str::trim).filter(|l| !l.is_empty()) {
+        println!("cargo:rustc-link-lib=dylib={lib}");
+    }
+    println!("cargo:rustc-cfg=kernel_support=\"{name}\"");
+}
