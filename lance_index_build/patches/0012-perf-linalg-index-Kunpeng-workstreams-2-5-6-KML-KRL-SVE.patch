+// ---------------------------------------------------------------------------
+// 4-bit LUT scans over the PERM0 row-major layout (dist_table.rs).
+//
+// A 32-byte code block for one batch of 32 rows and one code byte column holds
+// the current table's indices in bytes 0..16 and the next table's in bytes
+// 16..32 (low nibble: row PERM0[j], high nibble: row PERM0[j] + 16). The two
+// tables are contiguous too, so ONE 32-byte TBL looks up both once the
+// indices of bytes 16..32 are offset by 16. That needs a vector of at least
+// 256 bits; the functions return -1 without writing for a shorter vector and
+// the Rust candidate falls back to NEON.
+//
+// Each u16 lane k of a looked-up vector holds bytes 2k (row PERM0[2k mod 16]
+// = k mod 8) and 2k+1 (row 8 + k mod 8); lanes k and k + 8 hold the current
+// and next table of the same row. Even/odd bytes are accumulated with the
+// "bleed" trick: E += lane, O += lane >> 8, then E - (O << 8) is the even-byte
+// sum modulo 2^16.
+// ---------------------------------------------------------------------------
+
+#define LANCE_LUT_MIN_VL_BYTES 32
+
+static inline svuint8_t lance_lut_index_offsets(void) {
+  // 0 for bytes 0..16, 16 for bytes 16..32 (bytes >= 32 are never read back).
+  return svand_n_u8_x(svptrue_b8(), svindex_u8(0, 1), 16);
+}
+
+#define LANCE_BLEED_ADD(e, o, bytes)                                           \
+  do {                                                                         \
+    svuint16_t w_ = svreinterpret_u16_u8(bytes);                               \
+    e = svadd_u16_x(all16, e, w_);                                             \
+    o = svadd_u16_x(all16, o, svlsr_n_u16_x(all16, w_, 8));                    \
+  } while (0)
+
+// Even-byte and odd-byte sums of the first 16 u16 lanes.
+static inline void lance_bleed_store(svuint16_t e, svuint16_t o, uint16_t *ev,
+                                     uint16_t *od) {
+  svbool_t pg16 = svwhilelt_b16((uint64_t)0, (uint64_t)16);
+  svbool_t all16 = svptrue_b16();
+  svst1_u16(pg16, ev, svsub_u16_x(all16, e, svlsl_n_u16_x(all16, o, 8)));
+  svst1_u16(pg16, od, o);
+}
+
+// Rows 0..16 from the even/odd lane sums: row r < 8 is ev[r] + ev[r + 8],
+// row 8 + r is od[r] + od[r + 8].
+static inline uint32_t lance_row_sum(const uint16_t *ev, const uint16_t *od,
+                                     int row) {
+  return row < 8 ? (uint32_t)ev[row] + ev[row + 8]
+                 : (uint32_t)od[row - 8] + od[row];
+}
+
+// High-accuracy table: per code column, 64 bytes = [cur_low|next_low]
+// [cur_high|next_high]; entry = low + (high << 8), summed exactly into u32.
+// Columns are processed in chunks of 256 so that no u16 lane (one byte per
+// column) can exceed 256 * 255 < 2^16.
+int lance_sum_hacc_sve(const uint8_t *codes, const uint8_t *tables,
+                       size_t code_len, size_t n, uint32_t *out) {
+  if (svcntb() < LANCE_LUT_MIN_VL_BYTES) return -1;
+  const svbool_t pg32 = svwhilelt_b8((uint64_t)0, (uint64_t)32);
+  const svbool_t all16 = svptrue_b16();
+  const svuint8_t off = lance_lut_index_offsets();
+  const size_t chunk = 256;
+  for (size_t batch = 0; batch < n; batch += 32) {
+    uint32_t sums[32] = {0};
+    const uint8_t *batch_codes = codes + batch * code_len;
+    for (size_t c0 = 0; c0 < code_len; c0 += chunk) {
+      size_t c1 = c0 + chunk < code_len ? c0 + chunk : code_len;
+      svuint16_t el_lo = svdup_u16(0), ol_lo = svdup_u16(0);  // low plane, rows 0..16
+      svuint16_t eh_lo = svdup_u16(0), oh_lo = svdup_u16(0);  // high plane, rows 0..16
+      svuint16_t el_hi = svdup_u16(0), ol_hi = svdup_u16(0);  // low plane, rows 16..32
+      svuint16_t eh_hi = svdup_u16(0), oh_hi = svdup_u16(0);  // high plane, rows 16..32
+      for (size_t col = c0; col < c1; ++col) {
+        svuint8_t c = svld1_u8(pg32, batch_codes + col * 32);
+        svuint8_t tl = svld1_u8(pg32, tables + col * 64);
+        svuint8_t th = svld1_u8(pg32, tables + col * 64 + 32);
+        svuint8_t lo = svorr_u8_x(pg32, svand_n_u8_x(pg32, c, 15), off);
+        svuint8_t hi = svorr_u8_x(pg32, svlsr_n_u8_x(pg32, c, 4), off);
+        LANCE_BLEED_ADD(el_lo, ol_lo, svtbl_u8(tl, lo));
+        LANCE_BLEED_ADD(eh_lo, oh_lo, svtbl_u8(th, lo));
+        LANCE_BLEED_ADD(el_hi, ol_hi, svtbl_u8(tl, hi));
+        LANCE_BLEED_ADD(eh_hi, oh_hi, svtbl_u8(th, hi));
+      }
+      uint16_t a[16], b[16], c[16], d[16];
+      lance_bleed_store(el_lo, ol_lo, a, b);
+      lance_bleed_store(eh_lo, oh_lo, c, d);
+      for (int r = 0; r < 16; ++r)
+        sums[r] += lance_row_sum(a, b, r) + (lance_row_sum(c, d, r) << 8);
+      lance_bleed_store(el_hi, ol_hi, a, b);
+      lance_bleed_store(eh_hi, oh_hi, c, d);
+      for (int r = 0; r < 16; ++r)
+        sums[16 + r] += lance_row_sum(a, b, r) + (lance_row_sum(c, d, r) << 8);
+    }
+    for (int r = 0; r < 32; ++r) out[batch + r] = sums[r];
+  }
+  return 0;
+}
+
+// u8 tables (32 bytes per code column), u16 sums with wrapping arithmetic,
+// bit-identical to the NEON kernel for every input.
+int lance_sum_u16_sve(const uint8_t *codes, const uint8_t *tables,
+                      size_t code_len, size_t n, uint16_t *out) {
+  if (svcntb() < LANCE_LUT_MIN_VL_BYTES) return -1;
+  const svbool_t pg32 = svwhilelt_b8((uint64_t)0, (uint64_t)32);
+  const svbool_t all16 = svptrue_b16();
+  const svuint8_t off = lance_lut_index_offsets();
+  for (size_t batch = 0; batch < n; batch += 32) {
+    const uint8_t *batch_codes = codes + batch * code_len;
+    svuint16_t e_lo = svdup_u16(0), o_lo = svdup_u16(0);
+    svuint16_t e_hi = svdup_u16(0), o_hi = svdup_u16(0);
+    for (size_t col = 0; col < code_len; ++col) {
+      svuint8_t c = svld1_u8(pg32, batch_codes + col * 32);
+      svuint8_t t = svld1_u8(pg32, tables + col * 32);
+      svuint8_t lo = svorr_u8_x(pg32, svand_n_u8_x(pg32, c, 15), off);
+      svuint8_t hi = svorr_u8_x(pg32, svlsr_n_u8_x(pg32, c, 4), off);
+      LANCE_BLEED_ADD(e_lo, o_lo, svtbl_u8(t, lo));
+      LANCE_BLEED_ADD(e_hi, o_hi, svtbl_u8(t, hi));
+    }
+    uint16_t a[16], b[16];
+    lance_bleed_store(e_lo, o_lo, a, b);
+    for (int r = 0; r < 16; ++r) out[batch + r] = (uint16_t)lance_row_sum(a, b, r);
+    lance_bleed_store(e_hi, o_hi, a, b);
+    for (int r = 0; r < 16; ++r) out[batch + 16 + r] = (uint16_t)lance_row_sum(a, b, r);
+  }
+  return 0;
+}
+#undef LANCE_BLEED_ADD
+
+// ---------------------------------------------------------------------------
+// RaBitQ extra-bit dot products, sum_d query[d] * code[d], over the blocked
+// layout of lance-index `bq/ex_dot.rs`. Codes are loaded with zero-extending
+// byte loads straight into 32-bit lanes (8 lanes per vector), so the unpack is
+// shifts and masks on u32 lanes followed by one convert and one FMA per 8 dims.
+//
+// The result is bit-identical to the NEON kernels, which other kernels (the
+// fused layered/prefix kernels) must reproduce exactly: accumulator A holds
+// dims 0..8 and B dims 8..16 of every 16-dim run, which are lane for lane the
+// four 4-lane NEON accumulators, runs are fed in the same order, a partial
+// final group (`tail`, zero padded by the caller, or NULL) is accumulated in
+// place, and the final reduction follows vaddvq((a0 + a1) + (a2 + a3)).
+// Needs >= 256-bit vectors (returns -1 otherwise).
+// ---------------------------------------------------------------------------
+
+#define LANCE_EXDOT_PROLOGUE                                                   \
+  if (svcntb() < 32) return -1;                                                \
+  const svbool_t pg = svwhilelt_b32((uint64_t)0, (uint64_t)8);                 \
+  svfloat32_t acc_a = svdup_f32(0), acc_b = svdup_f32(0)
+// One 16-dim run: `lo` holds dims 0..8, `hi` dims 8..16 as u32 lanes.
+#define LANCE_EXDOT_RUN(lo, hi, q)                                             \
+  do {                                                                         \
+    acc_a = svmla_f32_x(pg, acc_a, svcvt_f32_u32_x(pg, lo), svld1_f32(pg, q)); \
+    acc_b = svmla_f32_x(pg, acc_b, svcvt_f32_u32_x(pg, hi),                    \
+                        svld1_f32(pg, (q) + 8));                               \
+  } while (0)
+#define LANCE_EXDOT_GROUPS(body, group_bytes, group_dims)                      \
+  do {                                                                         \
+    for (size_t g = 0; g < groups; ++g) {                                      \
+      const uint8_t *c = codes + g * (group_bytes);                            \
+      const float *qq = q + g * (group_dims);                                  \
+      body;                                                                    \
+    }                                                                          \
+    if (tail) {                                                                \
+      const uint8_t *c = tail;                                                 \
+      const float *qq = q + groups * (group_dims);                             \
+      body;                                                                    \
+    }                                                                          \
+  } while (0)
+#define LANCE_EXDOT_EPILOGUE                                                   \
+  do {                                                                         \
+    float a[8], b[8], u[4];                                                    \
+    svst1_f32(pg, a, acc_a);                                                   \
+    svst1_f32(pg, b, acc_b);                                                   \
+    for (int i = 0; i < 4; ++i) u[i] = (a[i] + a[i + 4]) + (b[i] + b[i + 4]);  \
+    *out = (u[0] + u[1]) + (u[2] + u[3]);                                      \
+    return 0;                                                                  \
+  } while (0)
+
+// 8 bits: group = 16 dims = 16 bytes, identity.
+int lance_ex_dot_u8_sve(const float *q, const uint8_t *codes, size_t groups,
+                        const uint8_t *tail, float *out) {
+  LANCE_EXDOT_PROLOGUE;
+  LANCE_EXDOT_GROUPS(
+      LANCE_EXDOT_RUN(svld1ub_u32(pg, c), svld1ub_u32(pg, c + 8), qq), 16, 16);
+  LANCE_EXDOT_EPILOGUE;
+}
+
+// 4 bits: group = 16 dims = 8 bytes; byte b = dim b (low) | dim 8 + b (high).
+int lance_ex_dot_u4_sve(const float *q, const uint8_t *codes, size_t groups,
+                        const uint8_t *tail, float *out) {
+  LANCE_EXDOT_PROLOGUE;
+  LANCE_EXDOT_GROUPS(
+      {
+        svuint32_t v = svld1ub_u32(pg, c);
+        LANCE_EXDOT_RUN(svand_n_u32_x(pg, v, 15), svlsr_n_u32_x(pg, v, 4), qq);
+      },
+      8, 16);
+  LANCE_EXDOT_EPILOGUE;
+}
+
+// Top bit `bit` of run k from a top-bit plane: the top bit of dim 16k + b is
+// bit 2k + b / 8 of plane byte b % 8 (`p` = plane bytes, `pb` = p >> 1).
+#define LANCE_TOP(plane, k, bit)                                               \
+  svand_n_u32_x(pg, svlsl_n_u32_x(pg, svlsr_n_u32_x(pg, plane, 2 * (k)), bit), \
+                1u << (bit))
+
+// 2 and 3 bits: group = 64 dims; byte b (< 16) holds dims b + 16k at bits 2k;
+// 3 bits adds the top-bit plane (8 bytes after the 16).
+#define LANCE_U23_GROUP(top)                                                   \
+  {                                                                            \
+    svuint32_t a = svld1ub_u32(pg, c), b = svld1ub_u32(pg, c + 8);             \
+    svuint32_t p = (top) ? svld1ub_u32(pg, c + 16) : svdup_u32(0);             \
+    svuint32_t pb = svlsr_n_u32_x(pg, p, 1);                                   \
+    for (int k = 0; k < 4; ++k) {                                              \
+      svuint32_t lo = svand_n_u32_x(pg, svlsr_n_u32_x(pg, a, 2 * k), 3);       \
+      svuint32_t hi = svand_n_u32_x(pg, svlsr_n_u32_x(pg, b, 2 * k), 3);       \
+      if (top) {                                                               \
+        lo = svorr_u32_x(pg, lo, LANCE_TOP(p, k, 2));                          \
+        hi = svorr_u32_x(pg, hi, LANCE_TOP(pb, k, 2));                         \
+      }                                                                        \
+      LANCE_EXDOT_RUN(lo, hi, qq + 16 * k);                                    \
+    }                                                                          \
+  }
+
+int lance_ex_dot_u2_sve(const float *q, const uint8_t *codes, size_t groups,
+                        const uint8_t *tail, float *out) {
+  LANCE_EXDOT_PROLOGUE;
+  LANCE_EXDOT_GROUPS(LANCE_U23_GROUP(0), 16, 64);
+  LANCE_EXDOT_EPILOGUE;
+}
+
+int lance_ex_dot_u3_sve(const float *q, const uint8_t *codes, size_t groups,
+                        const uint8_t *tail, float *out) {
+  LANCE_EXDOT_PROLOGUE;
+  LANCE_EXDOT_GROUPS(LANCE_U23_GROUP(1), 24, 64);
+  LANCE_EXDOT_EPILOGUE;
+}
+
+// 5 bits: group = 64 dims = 40 bytes; byte b of the first 16 = dims b (low) |
+// 16 + b (high), of the next 16 = dims 32 + b | 48 + b; then the top-bit
+// plane (bit 4). Runs in order 0..4 as NEON feeds them.
+int lance_ex_dot_u5_sve(const float *q, const uint8_t *codes, size_t groups,
+                        const uint8_t *tail, float *out) {
+  LANCE_EXDOT_PROLOGUE;
+  LANCE_EXDOT_GROUPS(
+      {
+        svuint32_t p = svld1ub_u32(pg, c + 32);
+        svuint32_t pb = svlsr_n_u32_x(pg, p, 1);
+        for (int blk = 0; blk < 2; ++blk) {
+          svuint32_t lo = svld1ub_u32(pg, c + 16 * blk);
+          svuint32_t hi = svld1ub_u32(pg, c + 16 * blk + 8);
+          int k = 2 * blk;
+          LANCE_EXDOT_RUN(svorr_u32_x(pg, svand_n_u32_x(pg, lo, 15), LANCE_TOP(p, k, 4)),
+                          svorr_u32_x(pg, svand_n_u32_x(pg, hi, 15), LANCE_TOP(pb, k, 4)),
+                          qq + 16 * k);
+          LANCE_EXDOT_RUN(svorr_u32_x(pg, svlsr_n_u32_x(pg, lo, 4), LANCE_TOP(p, k + 1, 4)),
+                          svorr_u32_x(pg, svlsr_n_u32_x(pg, hi, 4), LANCE_TOP(pb, k + 1, 4)),
+                          qq + 16 * (k + 1));
+        }
+      },
+      40, 64);
+  LANCE_EXDOT_EPILOGUE;
+}
+#undef LANCE_U23_GROUP
+#undef LANCE_TOP
+#undef LANCE_EXDOT_PROLOGUE
+#undef LANCE_EXDOT_RUN
+#undef LANCE_EXDOT_GROUPS
+#undef LANCE_EXDOT_EPILOGUE
+
+// The calling thread's SVE vector length in bytes.
+size_t lance_sve_vector_bytes(void) { return svcntb(); }
diff --git a/rust/lance-linalg/src/simd/sve_f32mm.c b/rust/lance-linalg/src/simd/sve_f32mm.c
new file mode 100644
index 0000000..60f895e
--- /dev/null
+++ b/rust/lance-linalg/src/simd/sve_f32mm.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright The Lance Authors
+
+// SVE FP32 matrix-multiply (FMMLA, FEAT_F32MM) dot-product blocks for blocked
+// nearest-centroid search. Built with -march=armv8.2-a+sve+f32mm; the Rust
+// caller checks the `f32mm` host capability.
+//
+// Inputs are "pair packed": rows 2p and 2p+1 of a matrix are interleaved in
+// two-float granules, so pair p is `kp = 2 * dim_even` floats laid out as
+//   r0[0] r0[1] r1[0] r1[1] | r0[2] r0[3] r1[2] r1[3] | ...
+// and every 128-bit segment is a 2x2 block. FMMLA multiplies a 2x2 block of
+// rows by the transpose of a 2x2 block of centroids per segment and adds it to
+// a 2x2 accumulator, so a 256-bit FMMLA performs 16 multiply-adds. Summing the
+// segments of an accumulator gives the 2x2 tile of dot products.
+
+#include <arm_sve.h>
+#include <stddef.h>
+#include <stdint.h>
+
+static inline void lance_store_pair_tile(svfloat32_t acc, float *out,
+                                         size_t ldo, size_t row, size_t col) {
+  float buf[64];  // up to 2048-bit vectors
+  svst1_f32(svptrue_b32(), buf, acc);
+  float s00 = 0, s01 = 0, s10 = 0, s11 = 0;
+  for (size_t seg = 0; seg < svcntw(); seg += 4) {
+    s00 += buf[seg];
+    s01 += buf[seg + 1];
+    s10 += buf[seg + 2];
+    s11 += buf[seg + 3];
+  }
+  out[row * ldo + col] = s00;
+  out[row * ldo + col + 1] = s01;
+  out[(row + 1) * ldo + col] = s10;
+  out[(row + 1) * ldo + col + 1] = s11;
+}
+
+// out[r * ldo + c] = <x[r], cent[c]> for r < 2 * row_pairs, c < 2 * col_pairs.
+// row_pairs must be a multiple of 4 and col_pairs a multiple of 2 (8 x 4
+// register tile); kp is a multiple of 4.
+void lance_dot_block_f32mm(const float *xp, size_t row_pairs, const float *cp,
+                           size_t col_pairs, size_t kp, float *out,
+                           size_t ldo) {
+  for (size_t rp = 0; rp < row_pairs; rp += 4) {
+    const float *x0 = xp + rp * kp, *x1 = x0 + kp, *x2 = x1 + kp,
+                *x3 = x2 + kp;
+    for (size_t cpi = 0; cpi < col_pairs; cpi += 2) {
+      const float *c0 = cp + cpi * kp, *c1 = c0 + kp;
+      svfloat32_t a00 = svdup_f32(0), a01 = svdup_f32(0), a10 = svdup_f32(0),
+                  a11 = svdup_f32(0), a20 = svdup_f32(0), a21 = svdup_f32(0),
+                  a30 = svdup_f32(0), a31 = svdup_f32(0);
+      for (size_t i = 0; i < kp; i += svcntw()) {
+        svbool_t pg = svwhilelt_b32((uint64_t)i, (uint64_t)kp);
+        svfloat32_t b0 = svld1_f32(pg, c0 + i), b1 = svld1_f32(pg, c1 + i);
+        svfloat32_t v0 = svld1_f32(pg, x0 + i), v1 = svld1_f32(pg, x1 + i);
+        a00 = svmmla_f32(a00, v0, b0);
+        a01 = svmmla_f32(a01, v0, b1);
+        a10 = svmmla_f32(a10, v1, b0);
+        a11 = svmmla_f32(a11, v1, b1);
+        svfloat32_t v2 = svld1_f32(pg, x2 + i), v3 = svld1_f32(pg, x3 + i);
+        a20 = svmmla_f32(a20, v2, b0);
+        a21 = svmmla_f32(a21, v2, b1);
+        a30 = svmmla_f32(a30, v3, b0);
+        a31 = svmmla_f32(a31, v3, b1);
+      }
+      size_t r = 2 * rp, c = 2 * cpi;
+      lance_store_pair_tile(a00, out, ldo, r, c);
+      lance_store_pair_tile(a01, out, ldo, r, c + 2);
+      lance_store_pair_tile(a10, out, ldo, r + 2, c);
+      lance_store_pair_tile(a11, out, ldo, r + 2, c + 2);
+      lance_store_pair_tile(a20, out, ldo, r + 4, c);
+      lance_store_pair_tile(a21, out, ldo, r + 4, c + 2);
+      lance_store_pair_tile(a30, out, ldo, r + 6, c);
+      lance_store_pair_tile(a31, out, ldo, r + 6, c + 2);
+    }
+  }
+}
