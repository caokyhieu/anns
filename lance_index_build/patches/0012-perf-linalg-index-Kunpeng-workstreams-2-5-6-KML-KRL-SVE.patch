+                    (2 * code_len) as i32,
+                    codes.as_ptr(),
+                    table.as_ptr(),
+                    got.as_mut_ptr(),
+                )
+            };
+            if status != 0 || got[..BATCH_SIZE] != want[..] {
+                return false;
+            }
+        }
+        true
+    });
