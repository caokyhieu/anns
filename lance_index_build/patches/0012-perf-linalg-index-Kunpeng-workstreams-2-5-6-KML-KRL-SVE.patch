+                let l0 = vqtbl1q_u8(tl_cur, idx_cur);
+                let l1 = vqtbl1q_u8(tl_next, idx_next);
+                let h0 = vqtbl1q_u8(th_cur, idx_cur);
+                let h1 = vqtbl1q_u8(th_next, idx_next);
