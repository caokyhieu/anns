+/// Every high-accuracy scan kernel this host can run, by candidate name, for
+/// parity tests and side-by-side benchmarks. Each has the contract of
+/// [`sum_4bit_hacc_dist_table`].
+pub fn sum_hacc_variants() -> Vec<(&'static str, HaccVariantFn)> {
+    fn wrap<const I: usize>(
+        n: usize,
+        code_len: usize,
+        codes: &[u8],
+        table: &[u8],
+        dists: &mut [u32],
+    ) {
+        let kernel = SUM_HACC.candidates()[I]
+            .kernel()
+            .expect("host-supported variant");
+        // A `u32` slice is a valid `MaybeUninit<u32>` slice.
+        let dists = unsafe {
+            std::slice::from_raw_parts_mut(
+                dists.as_mut_ptr().cast::<MaybeUninit<u32>>(),
+                dists.len(),
+            )
+        };
+        kernel.call(codes, table, code_len, &mut dists[..n]);
+    }
+    const WRAPS: [HaccVariantFn; 4] = [wrap::<0>, wrap::<1>, wrap::<2>, wrap::<3>];
+    SUM_HACC
+        .candidates()
+        .iter()
+        .enumerate()
+        .filter(|(_, c)| c.kernel().is_some())
+        .map(|(i, c)| (c.name(), WRAPS[i]))
+        .collect()
+}
