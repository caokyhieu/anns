--- a/rust/lance-linalg/src/distance.rs
+++ b/rust/lance-linalg/src/distance.rs
@@ -174,6 +174,25 @@ pub(crate) type PairKernel = unsafe fn(&[f32], &[f32]) -> f32;
 /// into the matching element of `output`.
 pub(crate) type BatchKernel = unsafe fn(&[f32], &[f32], usize, &mut [f32]);
 
+/// Benchmark control: `LANCE_F32_SVE=1` routes the f32 L2 and dot pair and
+/// batch kernels to SVE on hosts that support it. Default dispatch keeps the
+/// 16-lane scalar kernels on aarch64, which other code (e.g. the blocked flat
+/// search kernels) reproduces bit for bit. The SVE kernels fuse multiply-add
+/// and reduce in a vector-length-dependent order, so they agree with the
+/// default only to rounding. `candidate` is returned when opted in and the
+/// host supports it.
+#[cfg(all(target_arch = "aarch64", kernel_support = "sve"))]
+pub(crate) fn f32_sve_opt_in<F: Copy>(
+    candidate: &lance_core::utils::cpu::Candidate<F>,
+) -> Option<lance_core::utils::cpu::Kernel<F>> {
+    static ENABLED: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var_os("LANCE_F32_SVE").is_some_and(|v| v == "1"));
+    if !*ENABLED {
+        return None;
+    }
+    candidate.kernel()
+}
+
