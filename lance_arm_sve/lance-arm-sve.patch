+                .flag(format!("-march=armv8-a+{isa}"))
+                .flag("-msve-vector-bits=scalable")
+                .flag("-fno-fast-math")
+                .flag("-ffp-contract=off")
+                .opt_level(3)
+                .try_compile(&format!("lance_{isa}"));
+            match result {
+                Ok(()) => println!("cargo:rustc-cfg=kernel_support=\"{isa}\""),
+                Err(err) => println!("cargo:warning=Skipping {isa} kernels: {err}"),
+            }
+        }
+    }
+
     // Architectures without SIMD kernels back the vector types with plain arrays.
     if !matches!(target_arch.as_str(), "x86_64" | "aarch64" | "loongarch64") {
         println!("cargo:rustc-cfg=simd_fallback");
