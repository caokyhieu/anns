+/// Opt-in (`LANCE_RQ_CONST_EX_SCALE=1`): use one ex-code rescale factor per
+/// `(dim, ex_bits)` instead of searching the optimal factor for every row.
+///
+/// After the random rotation a residual's normalized magnitudes follow nearly
+/// the same distribution for every row, so the per-row optimum varies little
+/// around its mean (the observation behind RaBitQ-Library's constant scaling
+/// factor). The stored ex factors are computed from the codes actually
+/// emitted, so estimates stay consistent; only the quantization error can grow.
+static USE_CONST_EX_SCALE: LazyLock<bool> = LazyLock::new(|| {
+    std::env::var("LANCE_RQ_CONST_EX_SCALE").is_ok_and(|v| v == "1" || v == "true")
+});
+
+static CONST_EX_SCALES: LazyLock<Mutex<HashMap<(usize, u8), f32>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+const CONST_EX_SCALE_SAMPLES: usize = 100;
+
+/// Mean optimal rescale factor over Gaussian rows of dimension `dim`.
+fn const_ex_rescale_factor(dim: usize, ex_bits: u8) -> f32 {
+    if let Some(t) = CONST_EX_SCALES.lock().unwrap().get(&(dim, ex_bits)) {
+        return *t;
+    }
+    let mut rng = rand::rngs::SmallRng::seed_from_u64(0x5ca1e ^ dim as u64 ^ ((ex_bits as u64) << 32));
+    let normal = rand_distr::StandardNormal;
+    let mut scratch = ExQuantizationScratch::new(dim, ex_bits);
+    let mut sum = 0.0f64;
+    for _ in 0..CONST_EX_SCALE_SAMPLES {
+        let row: Vec<f32> = (0..dim).map(|_| rng.sample::<f32, _>(normal)).collect();
+        let norm = row.iter().map(|v| v * v).sum::<f32>().sqrt();
+        scratch.abs_normalized.clear();
+        scratch
+            .abs_normalized
+            .extend(row.iter().map(|v| v.abs() / norm));
+        sum += best_ex_rescale_factor_with_scratch(&mut scratch, ex_bits) as f64;
+    }
+    let t = (sum / CONST_EX_SCALE_SAMPLES as f64) as f32;
+    CONST_EX_SCALES.lock().unwrap().insert((dim, ex_bits), t);
+    t
+}
